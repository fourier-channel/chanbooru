#!/usr/bin/env bash
# Reset a person's booru password from the server's command line, and print
# the one-time link that shows it to them on the site (PasswordReveal,
# app/logical/password_reveal.rb; operator rulings 2026-10-19).
#
# Usage, on the serving box:
#   cd /opt/danbooru && sudo bin/chanbooru-reset-password <booru name>
#
# The new password is generated and set inside the danbooru container and
# sealed in the booru's Redis; this prints the account, the link, when it
# expires and how to send it -- NEVER the password. Whoever runs this does not
# see it; the person who opens the link sees it once. Their booru login
# sessions are ended. Matrix (MAS) passwords are not touched.
#
# Exit 0 when the link was printed; 1 when nothing was reset (the reason and
# its fix are printed); 2 for a usage error.
#
# Runs against the compose stack in this checkout, as bin/chanbooru-deploy
# does. COMPOSE_FILE is honoured, so on a dev box:
#   COMPOSE_FILE=docker-compose.dev.yaml bin/chanbooru-reset-password <name>
set -uo pipefail

SCRIPT="script/chanbooru_reset_password.rb"

die() { echo "FAILED: $*" >&2; exit 1; }

if (( $# != 1 )) || [[ -z "$1" ]]; then
  echo "usage: bin/chanbooru-reset-password <booru name>" >&2
  exit 2
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git checkout. Run this from the booru's checkout: cd /opt/danbooru"
cd "$ROOT" || die "cannot enter $ROOT"

# docker's own error is kept: a docker that cannot answer -- no permission on
# its socket, a compose file it cannot read -- is not a stopped stack, and its
# fix is not starting one.
services="$(docker compose ps --status running --services 2>&1)" \
  || die "docker could not list this checkout's containers, so nothing was reset. Docker said: ${services}
Fix: run this with sudo, as the usage line shows; if it still fails, see what compose objects to with: sudo docker compose config --quiet"
grep -qx danbooru <<<"$services" \
  || die "the danbooru container is not running here, so nothing was reset. See why with: sudo docker compose logs --tail 50 danbooru -- the stack comes up through a deploy (sudo bin/chanbooru-deploy), never a bare docker compose up."

# The container runs the deployed release, which may be older than this
# checkout: the Ruby half must be in what is running, not just on disk here.
docker compose exec -T danbooru test -f "$SCRIPT" \
  || die "the running release has no $SCRIPT, so nothing was reset. Deploy a release that has it (sudo bin/chanbooru-deploy), then run this again."

# The name is passed as its own argument, never through a shell string.
exec docker compose exec -T danbooru bin/rails runner "$SCRIPT" -- "$1"
