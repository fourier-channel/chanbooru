#!/usr/bin/env bash
# Reset a person's booru password -- and their Matrix one too, with --matrix --
# from the server's command line, and print the ONE link that shows them both
# on the site (PasswordReveal, app/logical/password_reveal.rb; operator rulings
# 2026-10-19 and 2026-10-24).
#
# Usage, on the serving box:
#   cd /opt/danbooru && sudo bin/chanbooru-reset-password <booru name> [--matrix <matrix user>]
#
# The booru password is generated and set inside the danbooru container and
# sealed in the booru's Redis; this prints the account, the link, when it
# expires and how to send it -- NEVER a password. Whoever runs this does not
# see one; the person who opens the link sees each once. Their booru login
# sessions are ended.
#
# --matrix <user> (name, or @name:41chan.net) also resets that MAS account.
# The booru keeps no link from its accounts to Matrix ones, so the Matrix
# account is always named, never guessed from the booru name. This script
# makes the password, hands it to the container on stdin to be sealed in the
# same link, then sets it with mas-cli in the MAS container. If MAS refuses,
# the Matrix password is taken back out of the link, the booru reset stands,
# and this exits 3. Matrix sessions are NOT ended -- for an account that was
# taken over, end them with the kill-sessions command printed at the end
# (that signs the person out of Technetium everywhere).
# mas-cli takes the password as an argument, so for the second it runs it is
# visible to root (docker events) and in /proc to local users; the person
# changes it on first use, as the page tells them.
#
# Exit 0 when the link was printed; 1 when nothing was reset (the reason and
# its fix are printed); 2 for a usage error; 3 when the booru was reset and
# Matrix was not (the link shows the booru password only).
#
# Runs against the compose stack in this checkout, as bin/chanbooru-deploy
# does. COMPOSE_FILE is honoured, so on a dev box:
#   COMPOSE_FILE=docker-compose.dev.yaml bin/chanbooru-reset-password <name>
set -uo pipefail

SCRIPT="script/chanbooru_reset_password.rb"
MAS="${CHANBOORU_MAS_CONTAINER:-synapse-mas-1}"
# PasswordReveal::ALPHABET and PASSWORD_LENGTH; the container refuses a
# password that is not made of exactly these.
ALPHABET="abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"
LENGTH=20

die() { echo "FAILED: $*" >&2; exit 1; }
usage() { echo "usage: bin/chanbooru-reset-password <booru name> [--matrix <matrix user>]" >&2; exit 2; }

name="" matrix=""
case $# in
  1) name="$1" ;;
  3) [[ "$2" == --matrix && -n "$3" ]] || usage; name="$1" matrix="$3" ;;
  *) usage ;;
esac
[[ -n "$name" && "$name" != -* ]] || usage

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git checkout. Run this from the booru's checkout: cd /opt/danbooru"
cd "$ROOT" || die "cannot enter $ROOT"

# docker's own error is kept: a docker that cannot answer -- no permission on
# its socket, a compose file it cannot read -- is not a stopped stack, and its
# fix is not starting one.
services="$(docker compose ps --status running --services 2>&1)" \
  || die "docker could not list this checkout's containers, so nothing was reset. Docker said: ${services}
Fix: run this with sudo, as the usage line shows; if it still fails, see what compose objects to with: sudo docker compose config --quiet"
grep -qx danbooru <<<"$services" \
  || die "the danbooru container is not running here, so nothing was reset. See why with: sudo docker compose logs --tail 50 danbooru -- the stack comes up through a deploy (sudo bin/chanbooru-deploy), never a bare docker compose up."

# The container runs the deployed release, which may be older than this
# checkout: the Ruby half must be in what is running, not just on disk here.
docker compose exec -T danbooru test -f "$SCRIPT" \
  || die "the running release has no $SCRIPT, so nothing was reset. Deploy a release that has it (sudo bin/chanbooru-deploy), then run this again."

# The name is passed as its own argument, never through a shell string.
if [[ -z "$matrix" ]]; then
  exec docker compose exec -T danbooru bin/rails runner "$SCRIPT" -- "$name"
fi

docker compose exec -T danbooru grep -q -- --drop-matrix "$SCRIPT" \
  || die "the running release's $SCRIPT cannot reset a Matrix password, so nothing was reset. Deploy a release that can (sudo bin/chanbooru-deploy), then run this again."
[[ "$(docker inspect -f '{{.State.Running}}' "$MAS" 2>/dev/null)" == true ]] \
  || die "the MAS container $MAS is not running, so nothing was reset. Start it from the Synapse stack (/opt/synapse), or name another with CHANBOORU_MAS_CONTAINER, then run this again."

# 4096 random bytes hold ~900 of the 56 characters; reading a fixed amount
# rather than piping an endless /dev/urandom keeps pipefail from seeing SIGPIPE.
pw="$(head -c 4096 /dev/urandom | LC_ALL=C tr -dc "$ALPHABET")"
pw="${pw:0:$LENGTH}"
(( ${#pw} == LENGTH )) || die "could not draw a $LENGTH-character password from /dev/urandom, so nothing was reset. Run this again."

# Never shown: every line from here is printed with the password masked.
mask() { local text="$1"; printf '%s\n' "${text//"$pw"/<password>}"; }

out="$(printf '%s\n' "$pw" | docker compose exec -T danbooru bin/rails runner "$SCRIPT" -- "$name" --matrix "$matrix" 2>&1)"
rc=$?
if (( rc != 0 )); then
  mask "$out" >&2
  exit "$rc"
fi
token="$(sed -n 's/^link: .*[?&]reveal=\([A-Za-z0-9_-]\{43\}\)$/\1/p' <<<"$out")"
mxid="$(sed -n 's/^matrix: *//p' <<<"$out")"
localpart="${mxid#@}" localpart="${localpart%%:*}"
[[ -n "$token" && -n "$localpart" ]] || {
  mask "$out" >&2
  die "the booru was reset but its output above has no link or Matrix account this could read, so Matrix was NOT reset. Do not send any link: run this again, which replaces it."
}

grep -v '^Send the link' <<<"$out"
if mas_out="$(docker exec "$MAS" /usr/local/bin/mas-cli manage set-password -c /config.yaml "$localpart" "$pw" 2>&1)"; then
  echo "matrix:   password set in MAS; its Matrix sessions were NOT ended."
  echo "note:     if the account was taken over, end them all (Technetium included): sudo docker exec $MAS /usr/local/bin/mas-cli manage kill-sessions -c /config.yaml $localpart"
  grep '^Send the link' <<<"$out"
  exit 0
fi

echo "FAILED: MAS refused the Matrix password for $mxid. mas-cli said:" >&2
mask "$mas_out" >&2
if drop="$(printf '%s\n' "$token" | docker compose exec -T danbooru bin/rails runner "$SCRIPT" -- --drop-matrix 2>&1)"; then
  echo "$drop"
  echo "The booru password WAS reset and the link shows it alone; the Matrix password is unchanged." >&2
  echo "Fix: check the Matrix username (it must be an existing MAS account), then reset Matrix by running this again with --matrix -- that issues a new link for both, which replaces this one." >&2
  # The container wrote this line while the link still held two passwords.
  grep '^Send the link' <<<"$out" | sed 's/the passwords once/the password once/'
  exit 3
fi
mask "$drop" >&2
die "the Matrix password could not be taken back out of the link either. DO NOT send the link above: it would show a Matrix password that was never set. Run this again, which replaces it."
