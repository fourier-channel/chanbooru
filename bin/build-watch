#!/usr/bin/env bash
# Make a Danbooru image build legible.
#
# `docker buildx build` piped to a file falls back to --progress=plain, which
# prints every line every compiler emits -- tens of thousands of them. Almost
# none of it is about whether the build is working. This filters that firehose
# down to the four kinds of line that actually carry state:
#
#   #12 [build-ruby 3/8] RUN ...   a step started
#   #12 DONE 154.7s                it finished
#   #12 CACHED                     it was reused, not rebuilt
#   #12 ERROR: ...                 it failed  <- the only one that means stop
#
# Usage:
#   bin/build-watch                      # follow the running build
#   bin/build-watch --summary            # what has happened so far, and where it is
#   bin/build-watch --wait               # follow until the build ends, then summarise
#   bin/build-watch /path/to/build.log   # a different log
#
# --wait exists because the obvious way to block until a build finishes --
#   until ! tmux has-session -t chanbooru-build; do sleep 20; done
# is a blinking cursor for fifteen minutes. It ends on its own, which is more
# than `tail -f` manages, but it still leaves you with no idea whether anything
# is happening. A wait that shows nothing is only half a fix.
set -uo pipefail

LOG="/tmp/chanbooru-build.log"
MODE="follow"
SESSION="chanbooru-build"

for arg in "$@"; do
  case "$arg" in
    --summary|-s) MODE="summary" ;;
    --wait|-w) MODE="wait" ;;
    *) LOG="$arg" ;;
  esac
done

[[ -r "$LOG" ]] || { echo "no readable build log at $LOG" >&2; exit 1; }

# Step lines only.
#
#   -a             a compile log is not reliably valid UTF-8, and grep otherwise
#                  decides it is binary and prints nothing at all
#   --line-buffered grep block-buffers when its output is not a terminal, so
#                  piping this to a file or another process shows nothing for
#                  4KB at a time -- which on a slow step is minutes of silence
#                  from the tool whose entire job is to prove work is happening
filter() { grep -a --line-buffered -E '^#[0-9]+ (\[|DONE|CACHED|ERROR)|^ERROR:|^#[0-9]+ ERROR'; }

if [[ "$MODE" == "summary" ]]; then
  echo "=== build: $LOG"
  echo
  echo "-- slowest steps ------------------------------------------------"
  # Pair each step's name with its DONE time.
  #
  # bin/build-docker-image runs TWO builds (development, then production), and
  # BuildKit numbers each from #1. So a single log holds two different steps
  # called #17. An earlier version kept one name per id and reported times from
  # one build against names from the other -- it announced "build-vips 70.0s" on
  # a run where vips was CACHED. Keying by build AND id keeps them apart.
  awk '
    /^#1 \[internal\] load/ { if (seen1++) build++ }
    /^#[0-9]+ \[/ { id=$1; sub(/^#/,"",id); name=$0; sub(/^#[0-9]+ /,"",name); step[build"/"id]=name }
    /^#[0-9]+ DONE/ { id=$1; sub(/^#/,"",id); t=$3; sub(/s$/,"",t);
                      k=build"/"id; if (t+0 > secs[k]+0) secs[k]=t+0 }
    END { for (k in secs) if (secs[k] >= 5 && step[k] != "") printf "%8.1fs  [build %d] %s\n", secs[k], substr(k,1,index(k,"/")-1)+1, step[k] }
  ' "$LOG" | sort -rn | head -12

  echo
  echo "-- cache --------------------------------------------------------"
  printf "  reused (CACHED): %s\n" "$(grep -acE '^#[0-9]+ CACHED' "$LOG")"
  printf "  rebuilt (DONE):  %s\n" "$(grep -acE '^#[0-9]+ DONE' "$LOG")"

  echo
  echo "-- failures -----------------------------------------------------"
  if grep -aqE '^#[0-9]+ ERROR|^ERROR:' "$LOG"; then
    grep -aE '^#[0-9]+ ERROR|^ERROR:' "$LOG" | head -5
    echo
    echo "  context:"
    grep -aE '^#[0-9]+ ERROR' "$LOG" | head -1 | grep -aoE '^#[0-9]+' | while read -r id; do
      grep -a "^${id} " "$LOG" | tail -15 | sed 's/^/    /'
    done
  else
    echo "  none"
  fi

  echo
  echo "-- currently ----------------------------------------------------"
  last_start=$(grep -aE '^#[0-9]+ \[' "$LOG" | tail -1)
  last_done=$(grep -aE '^#[0-9]+ (DONE|CACHED)' "$LOG" | tail -1)
  echo "  started: ${last_start:-none}"
  echo "  last finished: ${last_done:-none}"
  if grep -aq 'writing image\|exporting layers' "$LOG"; then
    echo "  -> exporting the image (nearly done)"
  fi
  exit 0
fi

if [[ "$MODE" == "wait" ]]; then
  echo "following $LOG until the build ends..."
  echo

  # Stream transitions in the background, stop streaming when the build is gone.
  tail -f -n +1 "$LOG" | filter &
  tail_pid=$!
  # Kill the tail even if this script is interrupted, or it outlives the shell.
  trap 'kill "$tail_pid" 2>/dev/null' EXIT INT TERM

  while tmux has-session -t "$SESSION" 2>/dev/null; do sleep 5; done
  sleep 2   # let the last lines flush through the pipe before cutting it
  kill "$tail_pid" 2>/dev/null
  trap - EXIT INT TERM

  echo
  echo "=== BUILD ENDED ==="
  echo
  exec "$0" --summary "$LOG"
fi

echo "following $LOG -- step transitions only. Ctrl-C to stop."
tail -f -n +1 "$LOG" | filter
