#!/usr/bin/env bash
# Bring the serving box up to a commit: fast-forward, build, restart, verify.
#
# Usage, on the origin box:
#   cd /opt/danbooru && bin/chanbooru-deploy
#
#   --no-pull   build and restart what is already checked out
#   --no-build  restart and verify only (config or compose change)
#
# This runs in the FOREGROUND and prints step transitions as they happen. It
# does not start a tmux session. Backgrounding the build into tmux is how this
# used to be done and it produced the two worst outcomes available: a blinking
# cursor with no way to tell whether anything was happening, and an operator
# stranded inside a session they did not know they were in.
#
# What it verifies is not "did the container start" but "is the container
# running the commit I just built". Those come apart in the ways that matter --
# a failed build leaves the previous image in place under the same tag, and
# `docker compose up -d` will happily report success having changed nothing.
set -uo pipefail

BRANCH="chanbooru"
# The build log's location is set below, once the checkout's root is known: it
# lives in a directory this script installs, never at a fixed name in /tmp
# (script/chanbooru-build-log.sh says why).
# How long the build may say nothing before the deploy says something.
HEARTBEAT_SECS="${HEARTBEAT_SECS:-15}"
PORT="${DANBOORU_PORT:-3000}"
PULL=1; BUILD=1

# Wall clock for the whole run, and separately for the build inside it.
# A deploy is the longest thing anyone here waits on, and "how long did that
# take" should not require scrolling back to find when you pressed return.
STARTED_AT=$(date +%s)
BUILD_STARTED_AT=""; BUILD_ENDED_AT=""

# Seconds as a person reads them: 47s, 15m 38s, 1h 04m 12s. No decimals -- this
# is for a human deciding whether to make coffee, not for a benchmark.
human_duration() {
  local s=$1 h m
  h=$(( s / 3600 )); m=$(( (s % 3600) / 60 )); s=$(( s % 60 ))
  if   (( h > 0 )); then printf '%dh %02dm %02ds' "$h" "$m" "$s"
  elif (( m > 0 )); then printf '%dm %02ds' "$m" "$s"
  else                   printf '%ds' "$s"
  fi
}

# Clock time, with the date only when the run crossed midnight -- which a
# fifteen-minute build genuinely can.
human_clock() {
  if [[ "$(date -d "@$1" +%F)" == "$(date -d "@$2" +%F)" ]]; then
    date -d "@$2" '+%H:%M:%S'
  else
    date -d "@$2" '+%b %-d %H:%M:%S'
  fi
}

for a in "$@"; do
  case "$a" in
    --no-pull)  PULL=0 ;;
    --no-build) BUILD=0 ;;
    --reexec)   PULL=0 ;;   # set by the re-exec below; the pull already happened
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done

die() { echo; echo "FAILED: $*" >&2; exit 1; }
step() { echo; echo "== $*"; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git checkout"
cd "$ROOT" || die "cannot enter $ROOT"

# shellcheck source=script/chanbooru-build-log.sh
source script/chanbooru-build-log.sh || die "script/chanbooru-build-log.sh is missing from this checkout."
LOG_DIR="$(build_log_dir "$ROOT")"
LOG="$LOG_DIR/build.log"

# --- 0. sanity ----------------------------------------------------------
# The build ships `git archive HEAD`, so anything uncommitted is silently NOT
# in the image. A deploy that quietly leaves out the change you are deploying
# is worse than one that refuses.
[[ "$(git rev-parse --abbrev-ref HEAD)" == "$BRANCH" ]] \
  || die "on $(git rev-parse --abbrev-ref HEAD), not $BRANCH. Fork work lives on $BRANCH."
# Tracked files only. Untracked cruft on the serving box is not shipped by
# git archive either, so it is not a reason to refuse a deploy -- but a MODIFIED
# tracked file is exactly the change someone thinks they are deploying.
DIRTY="$(git status --porcelain --untracked-files=no)"
[[ -z "$DIRTY" ]] || die "tracked files are modified. The build ships git archive HEAD, so these would NOT be in the image:
$DIRTY"

UNTRACKED="$(git status --porcelain --untracked-files=normal | grep -c '^??' || true)"
(( UNTRACKED > 0 )) && echo "note: $UNTRACKED untracked file(s) present; they are not shipped either."

# --- 1. fast-forward ----------------------------------------------------
if (( PULL )); then
  step "fetching origin/$BRANCH"
  # --tags is load-bearing, not tidiness. The reachability test below asks
  # whether this checkout's commit survives on the remote, and it can only
  # inspect refs this checkout HAS. Fetching the branch alone leaves every tag
  # unknown locally, so a commit preserved by a tag looks unreachable and the
  # deploy refuses to adopt a perfectly recoverable history. Which is exactly
  # what happened on the serving box.
  git fetch --quiet --tags origin "$BRANCH" || die "fetch failed"

  BEFORE="$(git rev-parse HEAD)"
  REMOTE="$(git rev-parse "origin/$BRANCH")"

  if [[ "$BEFORE" == "$REMOTE" ]]; then
    echo "   already at $(git rev-parse --short HEAD)"
  else
    if git merge-base --is-ancestor "$BEFORE" "$REMOTE"; then
      # The ordinary case: origin is ahead, we walk forward onto it.
      git merge --ff-only "origin/$BRANCH" --quiet || die "fast-forward failed unexpectedly"
    else
      # The histories have diverged. On this fork that is EXPECTED rather than
      # exceptional: the documented workflow rebases the working branch onto a
      # refreshed master, which rewrites every commit, and the serving box's
      # checkout is then descended from commits that no longer exist.
      #
      # Adopting the new history is safe only if nothing would be LOST, and the
      # test for that is reachability, not commit counting.
      #
      # Counting was the obvious version and it is wrong: a rebase gives every
      # commit a new hash, so a checkout sitting on pre-rebase history reports
      # as 82 commits "ahead" of a branch that already contains all the same
      # work. The check would have refused in precisely the case it exists to
      # allow. Caught by running it, not by reading it.
      #
      # What actually matters is whether this HEAD survives somewhere the remote
      # can hand it back -- another branch, or a pushed tag. If it does,
      # discarding it locally costs nothing. If it does not, this box is the
      # only place these commits exist, which is the one thing a serving box
      # must never be.
      KEPT="$(git for-each-ref --contains "$BEFORE" --format='%(refname:short)' refs/remotes/origin refs/tags 2>/dev/null | head -3 | tr '\n' ' ')"
      if [[ -z "$KEPT" ]]; then
        die "origin/$BRANCH has been rewritten, and this checkout's current commit
$(git --no-pager log --oneline -1 "$BEFORE")
is not reachable from any remote branch or tag known to this checkout.
Resetting would destroy it.

Searched: $(git for-each-ref --format='%(refname:short)' refs/remotes/origin refs/tags | wc -l) local refs, after fetching origin/$BRANCH and its tags.

Push it somewhere first -- a branch or a tag -- then run this again."
      fi
      echo "   current commit is preserved as: $KEPT"
      echo "   history was rewritten upstream (rebase); adopting it"
      echo "   $(git rev-parse --short "$BEFORE") is not an ancestor of $(git rev-parse --short "$REMOTE")"
      git reset --hard "origin/$BRANCH" --quiet || die "could not adopt origin/$BRANCH"
    fi

    echo "   $(git rev-parse --short "$BEFORE") -> $(git rev-parse --short HEAD)"
    git --no-pager log --oneline "$BEFORE..HEAD" 2>/dev/null | head -20 | sed 's/^/   /'

    # Bash reads a script incrementally, so a deploy script that just replaced
    # itself is being executed half-old and half-new from this line on. Start
    # again as the new one.
    #
    # Only meaningful when this script IS the one in the tree. Bootstrapping a
    # rewritten history means running a copy from outside the repo, and asking
    # git to diff a path it does not contain prints
    #   fatal: '/tmp/...' is outside repository
    # which is alarming, wrong, and was landing in the middle of a deploy that
    # was working perfectly. An external copy has nothing to reload into, so
    # the question does not apply.
    SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
    case "$SELF" in
      "$ROOT"/*)
        if ! git diff --quiet "$BEFORE" HEAD -- "$SELF"; then
          step "this script changed in that merge -- restarting as the new version"
          exec "$SELF" --reexec "$@"
        fi
        ;;
      *) echo "   (running from $SELF, outside the tree -- no reload needed)" ;;
    esac
  fi
fi

# --- 1b. image storage --------------------------------------------------
# The host directory compose bind-mounts at /images must be the one
# bin/chanbooru-storage installed: present, a real directory, on the storage
# drive and not the root disk, owned by the containers' user, writable by
# nobody else. Before this check a drive that did not come back after a reboot
# gave a deploy that passed every step below -- compose made an empty directory
# on the root disk, the revision matched, the front page answered 200 -- and a
# booru serving nothing from it (installed-locations audit 2026-10-04).
#
# Here, before the build, so the refusal costs seconds rather than arriving
# after fifteen minutes of compiling. Compose itself now refuses a missing
# path too (create_host_path: false); this check also catches the cases it
# cannot see: a directory that exists but sits on the root disk, or has the
# wrong owner or mode.
step "checking image storage"
[[ -x bin/chanbooru-storage ]] || die "bin/chanbooru-storage is missing from this checkout, so the image directory cannot be checked."
bin/chanbooru-storage check || die "the image directory is not the installed one (see FAIL and fix above). Nothing was built or restarted."

TARGET="$(git rev-parse HEAD)"

# --- 2. build -----------------------------------------------------------
if (( BUILD )); then
  step "building $(git rev-parse --short HEAD) -- full log at $LOG"
  # Same filter bin/build-watch uses: step starts, finishes, cache hits, errors.
  # Everything else is compiler noise, and there are tens of thousands of lines
  # of it. PIPESTATUS because the build's exit code is the one that matters and
  # grep's is not -- a build that fails still has lines to print.
  # A heartbeat, because a build that has gone quiet and a build that has hung
  # look identical, and the quiet is not accidental: this Dockerfile points
  # apt's logs at /dev/null, and BuildKit drops to state-change-only output the
  # moment it is not writing to a terminal. Between them a single step can go
  # sixty seconds without a character, which leaves the reader watching a
  # resource monitor to find out whether anything is alive.
  #
  # What it reports is the honest pair: which step is open, and how long the log
  # has been silent. Log mtime rather than a timer -- silence is measured from
  # the last byte the build actually produced, so this cannot claim progress the
  # build is not making.
  # Last build's log is kept, because it is the only honest source of an
  # estimate. A step that took 209 seconds last time is the difference between
  # "silent for 60s" reading as alarming and reading as halfway.
  #
  # The directory is installed (mode 700, ours) and checked right here, before
  # the first write: no link can be in it that we did not put there.
  install_build_log_dir "$LOG_DIR" "$(id -u)" || die "the build log directory is not one this deploy can trust (see FAIL and fix above). Nothing was built or restarted."
  [[ -f "$LOG" ]] && mv -f "$LOG" "$LOG.prev"
  : > "$LOG"
  (
    quiet_for=0
    while sleep "$HEARTBEAT_SECS"; do
      [[ -f "$LOG" ]] || continue
      now=$(date +%s)
      touched=$(stat -c %Y "$LOG" 2>/dev/null || echo "$now")
      quiet_for=$(( now - touched ))
      # Only speak when the build has not. Under a chatty step this stays out
      # of the way entirely.
      (( quiet_for < HEARTBEAT_SECS )) && continue

      open_line=$(grep -aE '^#[0-9]+ \[' "$LOG" | tail -1)
      open_step=$(printf '%s' "$open_line" | grep -oE '^#[0-9]+ \[[^]]*\]')
      # The bracketed name, which is stable across builds. The #N is not:
      # BuildKit renumbers, and this script runs two builds that each count
      # from #1.
      name=$(printf '%s' "$open_step" | grep -oE '\[[^]]*\]')

      took=""
      if [[ -f "$LOG.prev" && -n "$name" ]]; then
        # Find that step's number in the previous log, then its DONE time.
        prev_n=$(grep -aF "$name" "$LOG.prev" | grep -oE '^#[0-9]+' | tail -1)
        if [[ -n "$prev_n" ]]; then
          took=$(grep -aE "^${prev_n} DONE [0-9.]+s" "$LOG.prev" | grep -oE '[0-9.]+s' | tail -1)
        fi
      fi

      if [[ -n "$took" ]]; then
        printf '   ... still running %s -- silent %ds; took %s last build\n' "$open_step" "$quiet_for" "$took"
      else
        # No estimate rather than a made-up one. A number nobody measured is
        # the progress bar that tracks nothing.
        printf '   ... still running %s -- silent %ds (no previous timing)\n' "$open_step" "$quiet_for"
      fi
    done
  ) &
  HEARTBEAT_PID=$!
  # Killed on any exit, including a failed build or a Ctrl-C, so a stray ticker
  # never outlives the thing it was reporting on.
  trap 'kill "$HEARTBEAT_PID" 2>/dev/null || true' EXIT INT TERM

  BUILD_STARTED_AT=$(date +%s)
  # Production only: no container on this box runs the development image, and
  # building it was about two minutes of every deploy plus a 2.4GB image
  # (2026-10-04). Workstations build both for bin/dev.
  TARGETS=production bin/build-docker-image danbooru 2>&1 \
    | tee "$LOG" \
    | grep -a --line-buffered -E '^#[0-9]+ (\[|DONE|CACHED|ERROR)|^ERROR:|^#[0-9]+ ERROR'
  BUILD_RC=${PIPESTATUS[0]}
  BUILD_ENDED_AT=$(date +%s)
  kill "$HEARTBEAT_PID" 2>/dev/null || true
  trap - EXIT INT TERM
  (( BUILD_RC == 0 )) || die "build failed. Full log: $LOG"

  [[ -x bin/build-watch ]] && bin/build-watch --summary "$LOG"
fi

# --- 3. restart ---------------------------------------------------------
step "starting containers"
# --progress quiet, then our own one-line-per-service summary.
#
# Compose's default renderer collapses per-service progress into a redrawn
# block, and a redrawn block needs a TTY. Piped or logged it degrades to
# printing every state transition of every service on its own line -- and since
# four services here share one image, each phase of that image's resolution
# printed four times over. Errors still come through: --progress quiet silences
# the progress renderer, not failures.
docker compose --progress quiet up -d || die "compose up failed"
docker compose ps --format '{{.Service}}\t{{.State}}' | sort | sed 's/^/   /' 

# --- 4. verify ----------------------------------------------------------
# Not "is it up" -- "is it running what I just built". A failed build leaves
# the old image under the same tag and compose reports success either way.
step "verifying"

RUNNING=""
for _ in $(seq 1 30); do
  RUNNING="$(docker compose exec -T danbooru printenv DOCKER_IMAGE_REVISION 2>/dev/null | tr -d '\r')"
  [[ -n "$RUNNING" ]] && break
  sleep 2
done

[[ -n "$RUNNING" ]] || die "container never reported a revision. docker compose logs danbooru"
if [[ "$RUNNING" == "$TARGET" ]]; then
  echo "   revision  ${RUNNING:0:12}  matches HEAD"
elif (( BUILD )); then
  die "running ${RUNNING:0:12}, expected ${TARGET:0:12}. The new image did not take."
else
  # --no-build ships no code, so the image keeps the revision it was built
  # from and HEAD may be ahead of it. That is right ONLY when nothing between
  # the two is in the image. Comparing against HEAD regardless made every
  # compose-only deploy report FAILED while it had done exactly what it was for
  # (2026-09-30, the autotagger switch-off) -- and a check that is always red
  # there teaches the reader to skip it on the day a code change really is
  # missing. So: the running revision must be HEAD's ancestor, and the diff may
  # touch only the compose files and the host-side scripts the deploy runs
  # (this one, bin/chanbooru-storage, bin/build-watch and the build-log
  # helper), which the image carries but never runs.
  git merge-base --is-ancestor "$RUNNING" "$TARGET" 2>/dev/null \
    || die "running ${RUNNING:0:12}, which is not an ancestor of HEAD ${TARGET:0:12}. Deploy without --no-build."
  IN_IMAGE="$(git diff --name-only "$RUNNING" "$TARGET" -- . ':!docker-compose*.yaml' ':!bin/chanbooru-deploy' ':!bin/chanbooru-storage' ':!bin/build-watch' ':!script/chanbooru-build-log.sh')"
  [[ -z "$IN_IMAGE" ]] || die "--no-build restarted the image built at ${RUNNING:0:12}, but HEAD changes files that image carries:
$(sed 's/^/     /' <<< "$IN_IMAGE")
   Those changes are NOT running. Deploy again without --no-build."
  echo "   revision  ${RUNNING:0:12}  image not rebuilt; HEAD ${TARGET:0:12} changes only compose/deploy files"
fi

# db:prepare runs on container start, so the app answering at all is also the
# migration having succeeded.
CODE=""
for _ in $(seq 1 45); do
  CODE="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/" || true)"
  [[ "$CODE" == "200" ]] && break
  sleep 2
done
[[ "$CODE" == "200" ]] || die "front page answered ${CODE:-nothing} after 90s. docker compose logs danbooru"
echo "   front page 200"

FINISHED_AT=$(date +%s)

echo
echo "deployed $(git rev-parse --short HEAD) -- $(git log -1 --format=%s)"

BUILD_NOTE=""
if [[ -n "$BUILD_STARTED_AT" && -n "$BUILD_ENDED_AT" ]]; then
  BUILD_NOTE=" (build $(human_duration $(( BUILD_ENDED_AT - BUILD_STARTED_AT ))))"
fi
printf 'started %s, finished %s -- %s total%s\n' \
  "$(human_clock "$STARTED_AT" "$STARTED_AT")" \
  "$(human_clock "$STARTED_AT" "$FINISHED_AT")" \
  "$(human_duration $(( FINISHED_AT - STARTED_AT )))" \
  "$BUILD_NOTE"
