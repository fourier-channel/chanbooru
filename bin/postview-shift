#!/usr/bin/env node
// Does the post view hold still while its next post loads? Measured, not guessed.
//
//   POSTVIEW_AUTH=login:api_key bin/postview-shift --ids 206,207,...,213
//   ... --engine firefox --width 375
//   ... --scenario double150,double300     (default: every scenario)
//   ... --base <the dev app URL> --query pvshift
//   ... --image-delay 800 --json-delay 900
//   ... --height 420                       (default 812 at phone width, else 900)
//
// THE BUG IT GUARDS (operator, 2026-10-18): stepping through posts at normal
// speed reached a post whose image had not loaded; the stage collapsed to its
// frame's border, the flank thumbnails vanished with it, and the tag panel rode
// up by the image's height and back down when the image landed.
//
// WHAT IT MEASURES, every animation frame, in the page: the tag panel's top,
// the stage's height, the centre box, both flank columns and whether their
// current tiles are painted (inside the column, visible), the centre image's
// state -- and the times of each press, each commit (pushState), each centre
// image load, and every image and payload request (from the proxy below).
// NOT the browser's CLS score: a shift within 500 ms of input is excluded from
// it (hadRecentInput), which is exactly when this one happens.
//
// THE PAGE is the dev app's Modulation post view, signed in by an explicit
// Authorization header (the app never challenges, so httpCredentials sends
// nothing). The browser goes through a proxy in this process: every image
// under /data/ is answered after --image-delay ms with an SVG of the
// rendition's true size (computed from the post's own dimensions and the URL's
// variant) and production's edge cache header (private, a year, immutable),
// every video with a stand-in clip, and every modulation.json is held
// --json-delay ms and passed on. So this measures how the page behaves under
// injected latency; it does not reproduce production's gate. A proxy rather
// than Playwright's request routing, because routing turns the browser's cache
// off, and whether a warmed picture is reused is one of the questions: a
// request that reaches the proxy twice was fetched twice.
//
// THE POSTS: --ids is a run of consecutive posts matched by --query, oldest
// first (seeded on dev by a throwaway script). The walk starts at the newest
// and steps "next" (older), the search mode's direction under order:id_desc.
//
// SCENARIOS
//   cold        a cold load: the stage must not change size when the image lands
//   step        one press from rest
//   double150   two presses 150 ms apart: both must commit, nothing may move
//   double300   two presses 300 ms apart
//   blocked     the centre blocked live: the stage keeps its box, the tiles stay
//   coldblocked a cold load of a blocked post: its image must never paint
//   fail500     the next payload answers 500: the URL stays, the status says so
//   walk300     five presses 300 ms apart from just after load, faster than a
//               payload arrives: nothing may move; reports the steps taken
//   chain       five presses 120 ms apart after the lookahead: a post passed
//               in transit is never drawn, every post landed on shows its picture
//   random      four presses along random, each once the last has landed, from
//               a cleared trail: none may meet a side still loading
//   comments    scrolled to the bottom of a long thread, one press: the comment
//               section keeps its height until the next post's comments arrive
//   shapes      three presses at a normal pace from a tall post, through a wide
//               one with a notice, a video and a small picture: the window
//               holds one size, the stage, the tag panel's edge and the flank
//               columns never move, and a click beside the picture is not a
//               click on it
//   entry       cold loads of a post with no shelf, one with a one-row shelf
//               and one with a taller shelf and a notice: the window is the
//               same size whichever post the visit opens on
//   banner      an 80 px banner put in above the post view and taken out again
//               (a dismissed dmail notice, say): the window is re-cut each
//               time, so the tag panel's head still ends on the first screen
//
// ONE FIXED WINDOW (operator, 2026-10-18): the image area is one size for
// every post, sized to the screen, and a picture sits inside it; notices sit
// below the image. So every walk JUDGES, for each pair of posts, how far the
// window, the stage, the tag panel's top edge and both flank columns moved
// ACROSS the commit, that the window exists on every frame, that the picture's
// frame is the picture's own shape inside it, that the panel's head and the
// first row of its shelf are on the first screen (at the default heights),
// and that a header too long for its line says so; it prints how far the
// shelf and the panel's bottom moved (a notice above the shelf moves it by
// the notice's height, and that is all that may move it), and the payload
// requests per step by read (full, prefetch, visit). THE SEED it expects:
// eight posts of mixed shapes, the sixth oldest a child of the oldest (a
// family notice) with a character and a copyright tag (a two-row shelf), the
// second newest with a creator tag (a one-row shelf), the rest with no
// shelf, and the two newest with the same long comment thread.
//
// IT FAILS (exit 1) on any FAIL line. NEEDS playwright-core with chromium and
// firefox installed; found by require(), or set PLAYWRIGHT_CORE.
"use strict";

const fs = require("fs");
const http = require("http");
const net = require("net");
const path = require("path");

const ROOT = path.resolve(__dirname, "..");
const args = process.argv.slice(2);
const opt = (name, fallback) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : fallback; };
const ENGINE = opt("--engine", "chromium");
const WIDTH = Number(opt("--width", "1280"));
const HEIGHT = Number(opt("--height", WIDTH <= 560 ? "812" : "900"));
// The fit setting keeps the tag panel's head and one row of its shelf on the
// first screen only where the screen has room for them above a usable
// window; on a short one the window gives that up (sizeStage's FLOOR). So
// the fold is judged at the default heights and not at a short --height run.
const FOLD = HEIGHT >= 600;
const BASE = (opt("--base", "") || (() => { throw new Error("postview-shift: no --base. Fix: pass --base <the dev app URL>, e.g. the danbooru container's address on port 3000."); })()).replace(/\/$/, "");
const QUERY = opt("--query", "pvshift");
const IMG_DELAY = Number(opt("--image-delay", "800"));
const JSON_DELAY = Number(opt("--json-delay", "900"));
const IDS = String(opt("--ids", "")).split(",").filter(Boolean).map(Number).sort((a, b) => a - b);
const ALL = ["cold", "step", "double150", "double300", "blocked", "coldblocked", "fail500", "walk300", "chain", "random", "comments", "shapes", "entry", "banner"];
const SCENARIOS = String(opt("--scenario", ALL.join(","))).split(",").filter(Boolean);
const AUTH = process.env.POSTVIEW_AUTH || "";

function die(words) { console.error("FAIL: " + words); process.exit(2); }
if (IDS.length < 4) die("--ids needs at least 4 consecutive post ids matched by --query. fix: seed them on the dev app and pass them oldest first.");
if (!/^[^:]+:.+$/.test(AUTH)) die("POSTVIEW_AUTH is not login:api_key. fix: read -s POSTVIEW_AUTH; export POSTVIEW_AUTH (an admin-level throwaway on the dev app).");
if (SCENARIOS.some((s) => !ALL.includes(s))) die("unknown --scenario; known: " + ALL.join(","));

function loadPlaywright() {
  const where = process.env.PLAYWRIGHT_CORE || "playwright-core";
  try {
    return require(where);
  } catch {
    die("cannot load playwright-core from " + JSON.stringify(where) + ". fix: set PLAYWRIGHT_CORE=/path/to/node_modules/playwright-core, with chromium and firefox installed.");
  }
  return null;
}

const HEADER = "Basic " + Buffer.from(AUTH).toString("base64");
const CLIP = fs.readFileSync(path.join(ROOT, "test/files/webm/test-gbrp-vp9.webm"));
let failures = 0;
const check = (ok, scenario, what) => {
  console.log((ok ? "PASS " : "FAIL ") + "[" + ENGINE + " " + WIDTH + "px " + scenario + "] " + what);
  if (!ok) failures++;
};
const sleep = (ms) => new Promise((done) => { setTimeout(done, ms); });

// The renditions' sizes, as MediaAsset::Variant#max_dimensions scales them.
const VARIANT_MAX = { "180x180": [180, 180], "360x360": [360, 360], "720x720": [720, 720], sample: [850, Infinity], original: [Infinity, Infinity] };
function scaled(w, h, [mw, mh]) {
  if (w <= mw && h <= mh) return [w, h];
  const s = Math.min(mw / w, mh / h);
  return [Math.round(w * s), Math.round(h * s)];
}

async function postsMeta() {
  const res = await fetch(BASE + "/posts.json?limit=100&tags=" + encodeURIComponent("id:" + IDS.join(",")), { headers: { Authorization: HEADER } });
  if (!res.ok) die("posts.json answered " + res.status + ". fix: check POSTVIEW_AUTH and --base.");
  const rows = await res.json();
  const byMd5 = new Map(rows.map((p) => [p.md5, p]));
  const byId = new Map(rows.map((p) => [p.id, p]));
  if (byId.size !== IDS.length) die("posts.json found " + byId.size + " of " + IDS.length + " --ids. fix: pass ids this account can see.");
  return { byMd5, byId };
}

// The probe, installed before any page script runs: one sample per frame.
const PROBE = `(() => {
  const pv = window.__pv = { samples: [], events: [] };
  const ev = (type, data) => pv.events.push(Object.assign({ t: Date.now(), type }, data || {}));
  pv.ev = ev;
  const push = history.pushState;
  history.pushState = function (s, t, u) { const r = push.apply(this, arguments); ev("commit", { path: location.pathname }); return r; };
  const centreMedia = (t) => t && (t.tagName === "IMG" || t.tagName === "VIDEO") && t.closest && t.closest('[data-region="center"]');
  document.addEventListener("load", (e) => { if (centreMedia(e.target)) ev("centre-load", { src: e.target.getAttribute("src") }); }, true);
  document.addEventListener("loadeddata", (e) => { if (centreMedia(e.target)) ev("centre-load", { src: e.target.getAttribute("src") }); }, true);
  const rect = (el) => (el ? el.getBoundingClientRect() : null);
  const painted = (col) => {
    if (!col || getComputedStyle(col).display === "none") return null;
    const tile = col.querySelector(".mod-sortrow.is-current");
    if (!tile) return 0;
    const c = col.getBoundingClientRect(), b = tile.getBoundingClientRect(), mid = b.top + b.height / 2;
    return c.height >= b.height * 0.6 && mid > c.top && mid < c.bottom && getComputedStyle(tile).visibility === "visible" ? 1 : 0;
  };
  function frame() {
    const root = document.getElementById("modulation-root");
    if (root && root.dataset.booted) {
      const q = (n) => root.querySelector('[data-region="' + n + '"]');
      const centre = q("center"), media = centre && centre.querySelector("img, video");
      const tags = rect(q("tags")), stage = rect(q("stage")), c = rect(centre), comments = rect(q("comments"));
      const colP = q("flank-prev"), colN = q("flank-next");
      const status = q("flank-status"), notices = q("notices");
      const tagsEl = q("tags"), head = tagsEl && tagsEl.querySelector(".mod-tags-head");
      const shelf = tagsEl && tagsEl.querySelector(".mod-cats"), firstRow = tagsEl && tagsEl.querySelector(".mod-cat-group");
      const frameEl = centre && centre.querySelector(".mod-frame"), fields = q("meta");
      const cs = centre && getComputedStyle(centre);
      const shown =!!media && getComputedStyle(centre).display !== "none" && getComputedStyle(media).visibility === "visible" && media.getBoundingClientRect().height > 0;
      const done = !!media && (media.tagName === "IMG" ? media.complete && media.naturalWidth > 0 : media.readyState >= 2);
      pv.samples.push({
        t: Date.now(), path: location.pathname,
        tagsTop: tags && Math.round((tags.top + scrollY) * 10) / 10,
        stageTop: stage && Math.round((stage.top + scrollY) * 10) / 10,
        commentsTop: comments && Math.round((comments.top + scrollY) * 10) / 10,
        commentsH: comments && Math.round(comments.height),
        colPx: colP && getComputedStyle(colP).display !== "none" ? Math.round(rect(colP).left * 10) / 10 : null,
        colNx: colN && getComputedStyle(colN).display !== "none" ? Math.round(rect(colN).left * 10) / 10 : null,
        cOp: centre ? Number(getComputedStyle(centre).opacity) : null,
        scrollY: Math.round(scrollY), docH: document.documentElement.scrollHeight,
        status: status && status.classList.contains("is-shown") ? status.textContent : "",
        notices: notices && !notices.hidden ? notices.children.length : 0,
        stageH: stage && Math.round(stage.height * 10) / 10,
        cW: c && Math.round(c.width), cH: c && Math.round(c.height),
        // The centre's layout box, which the swap's transform does not touch.
        bW: centre && centre.offsetWidth, bH: centre && centre.offsetHeight,
        win: root.classList.contains("is-windowed"),
        // The panel's head and the first row of its shelf against the
        // viewport's bottom edge (positive: below the first screen).
        foldHead: head ? Math.round(head.getBoundingClientRect().bottom - innerHeight) : null,
        foldRow: firstRow ? Math.round(firstRow.getBoundingClientRect().bottom - innerHeight) : null,
        shelfTop: shelf ? Math.round((shelf.getBoundingClientRect().top + scrollY) * 10) / 10 : null,
        nH: notices && !notices.hidden ? Math.round((notices.getBoundingClientRect().height + parseFloat(getComputedStyle(notices).marginBottom)) * 10) / 10 : 0,
        tagsBottom: tags && Math.round((tags.bottom + scrollY) * 10) / 10,
        // The picture's frame and the media element, layout boxes (the swap's
        // transform does not touch them), and the box the payload promised.
        fW: frameEl && frameEl.offsetWidth, fH: frameEl && frameEl.offsetHeight,
        mW: media && media.offsetWidth, mH: media && media.offsetHeight, kind: media ? media.tagName : null,
        boxW: cs ? Number(cs.getPropertyValue("--mod-bw")) : null, boxH: cs ? Number(cs.getPropertyValue("--mod-bh")) : null,
        // The header's fields: clipped, and whether they say so.
        metaClip: !!fields && fields.scrollWidth > fields.clientWidth + 1,
        metaCue: !!fields && (fields.classList.contains("is-clipped-end") || fields.classList.contains("is-clipped-start")),
        metaTitle: !!fields && !!fields.title,
        lightbox: !!root.querySelector(".mod-lightbox"),
        colP: colP && getComputedStyle(colP).display !== "none" ? Math.round(rect(colP).height * 10) / 10 : null,
        colN: colN && getComputedStyle(colN).display !== "none" ? Math.round(rect(colN).height * 10) / 10 : null,
        tileP: painted(colP), tileN: painted(colN),
        shown, done, blocked: !!centre && centre.classList.contains("blacklisted-hidden"),
        src: media ? media.getAttribute("src") : null,
      });
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();`;

// The proxy every request goes through. state.net logs what reached it
// ({ t, url, kind }); state.failId makes that post's payload answer 500;
// state.imgDelay holds the pictures.
function startProxy(meta) {
  const state = { net: [], failId: null, imgDelay: IMG_DELAY };
  const forward = (req, res, u) => {
    const headers = { ...req.headers };
    delete headers["proxy-connection"];
    const up = http.request({ host: u.hostname, port: u.port || 80, method: req.method, path: u.pathname + u.search, headers }, (r) => {
      res.writeHead(r.statusCode, r.headers);
      r.pipe(res);
    });
    up.on("error", () => { res.writeHead(502); res.end(); });
    req.pipe(up);
  };
  const srv = http.createServer(async (req, res) => {
    const u = new URL(req.url);
    if (u.pathname.startsWith("/data/")) {
      state.net.push({ t: Date.now(), url: u.pathname + u.search, kind: "media" });
      const m = /\/data\/([^/]+)\/.*?([0-9a-f]{32})\.(\w+)$/.exec(u.pathname);
      const post = m && meta.byMd5.get(m[2]);
      await sleep(state.imgDelay);
      if (!post) { res.writeHead(404); res.end(); return; }
      const cache = { "Cache-Control": "private, max-age=31536000, immutable" };
      if (m[1] === "original" && /^(mp4|webm)$/.test(post.file_ext)) {
        res.writeHead(200, { ...cache, "Content-Type": "video/webm", "Content-Length": CLIP.length });
        res.end(CLIP);
        return;
      }
      const [w, h] = scaled(post.image_width, post.image_height, VARIANT_MAX[m[1]] || VARIANT_MAX.original);
      const svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + " " + h + '"><rect width="100%" height="100%" fill="#7a5"/><text x="8" y="24" font-size="20">' + post.id + "</text></svg>";
      res.writeHead(200, { ...cache, "Content-Type": "image/svg+xml" });
      res.end(svg);
      return;
    }
    if (u.pathname.endsWith("/modulation.json")) {
      const flavour = u.searchParams.has("visit") ? "visit" : u.searchParams.has("prefetch") ? "prefetch" : "full";
      state.net.push({ t: Date.now(), url: u.pathname + u.search, kind: "payload", flavour });
      await sleep(JSON_DELAY);
      if (state.failId && u.pathname === "/posts/" + state.failId + "/modulation.json") { res.writeHead(500, { "Content-Type": "application/json" }); res.end("{}"); return; }
    }
    forward(req, res, u);
  });
  // ws:// (the dev server's reload socket) arrives as CONNECT: tunnel it.
  srv.on("connect", (req, sock, head) => {
    const [host, port] = req.url.split(":");
    const up = net.connect(Number(port) || 80, host, () => { sock.write("HTTP/1.1 200 Connection Established\r\n\r\n"); up.write(head); up.pipe(sock); sock.pipe(up); });
    up.on("error", () => sock.destroy());
    sock.on("error", () => up.destroy());
  });
  return new Promise((done) => { srv.listen(0, "127.0.0.1", () => done({ srv, port: srv.address().port, state })); });
}

let proxy = null;
async function open(browser, meta, url, { failId = null, imgDelay = IMG_DELAY } = {}) {
  proxy.state.net = [];
  proxy.state.failId = failId;
  proxy.state.imgDelay = imgDelay;
  const ctx = await browser.newContext({ extraHTTPHeaders: { Authorization: HEADER }, viewport: { width: WIDTH, height: HEIGHT } });
  const page = await ctx.newPage();
  const errors = [];
  page.on("console", (m) => { if (m.type() === "error") errors.push(m.text()); });
  page.on("pageerror", (e) => errors.push("pageerror: " + e.message));
  await page.addInitScript(PROBE);
  await page.goto(BASE + url);
  await page.waitForFunction(() => document.querySelector("#blacklist-box") && document.querySelector("#blacklist-box").blacklist, null, { timeout: 15000 });
  return { ctx, page, net: proxy.state.net, errors };
}

const pathOf = (id) => "/posts/" + id;
const urlOf = (id) => pathOf(id) + "?q=" + encodeURIComponent(QUERY);
const now = (page) => page.evaluate(() => Date.now());
const dump = (page) => page.evaluate(() => ({ samples: window.__pv.samples.slice(), events: window.__pv.events.slice() }));
const unblockAll = (page) => page.evaluate(async () => { const b = document.querySelector("#blacklist-box").blacklist; for (const rule of [...b.rules]) { await b.remove(rule); } });
const block = (page, tag) => page.evaluate((t) => document.querySelector("#blacklist-box").blacklist.add(t), tag);
// A tag on this post and no other in the run, to block it alone.
const ownTag = (meta, id) => {
  const others = new Set(IDS.filter((x) => x !== id).flatMap((x) => meta.byId.get(x).tag_string.split(" ")));
  return meta.byId.get(id).tag_string.split(" ").find((t) => !others.has(t));
};

// Per committed post: how far the tag panel moved after the commit frame, how
// short the stage got against its settled height, and whether the flank
// columns and tiles kept up. Samples before the first press are the rest.
function segments(samples, from) {
  const out = [];
  samples.filter((s) => s.t >= from).forEach((s) => {
    const last = out[out.length - 1];
    if (!last || last.path !== s.path) out.push({ path: s.path, rows: [s] });
    else last.rows.push(s);
  });
  return out.map((seg) => {
    const rows = seg.rows.filter((r) => r.tagsTop != null);
    const end = rows[rows.length - 1] || {};
    const tops = rows.map((r) => r.tagsTop);
    const stageTops = rows.map((r) => r.stageTop);
    const cols = rows.filter((r) => r.colN != null);
    return {
      path: seg.path,
      frames: rows.length,
      tagsMove: tops.length ? Math.round((Math.max(...tops) - Math.min(...tops)) * 10) / 10 : null,
      stageMove: stageTops.length ? Math.round((Math.max(...stageTops) - Math.min(...stageTops)) * 10) / 10 : null,
      notices: end.notices || 0,
      stageMin: rows.length ? Math.min(...rows.map((r) => r.stageH)) : null,
      stageEnd: end.stageH,
      colGap: cols.length ? Math.max(...cols.map((r) => Math.max(Math.abs(r.colN - r.stageH), Math.abs(r.colP - r.stageH)))) : null,
      unpainted: cols.filter((r) => !(r.tileP && r.tileN)).length,
      unwindowed: rows.filter((r) => !r.win).length,
      end,
    };
  });
}

function report(scenario, segs) {
  segs.forEach((s) => console.log("  " + scenario + " " + s.path + " frames=" + s.frames + " notices=" + s.notices + " tagsMove=" + s.tagsMove + "px stageMove=" + s.stageMove + "px stageMin=" + s.stageMin + " stageEnd=" + s.stageEnd + " colGap=" + s.colGap + " unpaintedTileFrames=" + s.unpainted));
}

async function rest(page) {
  // Settled: the flanks drawn, the image in, the lookahead given its time.
  await page.waitForFunction(() => { const s = window.__pv.samples; const l = s[s.length - 1]; return l && l.done; }, null, { timeout: 20000 }).catch(() => {});
  await sleep(IMG_DELAY + JSON_DELAY + 1500);
}

// What one settled frame must show, whatever the walk.
// - The picture's frame is the picture's own shape inside the window, and
//   the picture or video fills it: the empty space around a picture is the
//   window's, so a click there is not a click on the picture, the zoom
//   cursor and the raise follow the picture, and a video's controls sit on
//   the video (review, 2026-10-18).
// - At the default heights, the tag panel's head, and the first row of its
//   shelf on a post with no notice, end on the first screen whatever post
//   the visit opened on (the fit setting's promise, cut for one row).
// - A header too long for its one line says so: a fade on the clipped edge,
//   and the full line in its title.
function judgeSettled(scenario, where, e) {
  if (!e || !e.path) return;
  if (e.done && !e.blocked && (e.kind === "IMG" || e.kind === "VIDEO") && e.boxW && e.boxH && e.fW && e.fH) {
    const want = (e.boxW + 2) / (e.boxH + 2), got = e.fW / e.fH;
    check(Math.abs(got - want) / want <= 0.02, scenario, where + ": the frame is the picture's own shape (" + e.fW + "x" + e.fH + " for a " + e.boxW + "x" + e.boxH + " " + e.kind.toLowerCase() + ")");
    check(Math.abs(e.mW - (e.fW - 2)) <= 1 && Math.abs(e.mH - (e.fH - 2)) <= 1, scenario, where + ": the " + e.kind.toLowerCase() + " fills its frame (" + e.mW + "x" + e.mH + " in " + e.fW + "x" + e.fH + ")");
    if (e.win) check(e.fW <= e.bW + 1 && e.fH <= e.bH + 1, scenario, where + ": the frame fits inside the window (" + e.fW + "x" + e.fH + " in " + e.bW + "x" + e.bH + ")");
  }
  if (FOLD && e.scrollY === 0) {
    check(e.foldHead !== null && e.foldHead <= 0, scenario, where + ": the tag panel's head ends on the first screen (" + e.foldHead + " px past it)");
    if (e.notices === 0 && e.foldRow !== null) check(e.foldRow <= 0, scenario, where + ": the first row of the shelf ends on the first screen (" + e.foldRow + " px past it)");
  }
  if (e.metaClip) check(e.metaCue && e.metaTitle, scenario, where + ": the header's clipped fields say so (fade " + e.metaCue + ", full line in the title " + e.metaTitle + ")");
}

function judgeSegments(scenario, segs, { shift = true } = {}) {
  report(scenario, segs);
  segs.forEach((s) => {
    if (shift) check(s.tagsMove !== null && s.tagsMove <= 1, scenario, s.path + ": the tag panel holds still from the commit frame on (moved " + s.tagsMove + " px)");
    if (shift) check(s.stageMove !== null && s.stageMove <= 1, scenario, s.path + ": the stage holds still from the commit frame on (moved " + s.stageMove + " px)");
    check(s.stageMin !== null && s.stageEnd - s.stageMin <= 1, scenario, s.path + ": the stage never shorter than its settled height (min " + s.stageMin + " vs " + s.stageEnd + ")");
    if (s.colGap !== null) {
      check(s.colGap <= 1, scenario, s.path + ": flank columns as tall as the stage every frame (worst gap " + s.colGap + " px)");
      check(s.unpainted === 0, scenario, s.path + ": both current flank tiles painted every frame (" + s.unpainted + " frames without)");
    }
    judgeSettled(scenario, s.path, s.end);
    check(s.unwindowed === 0, scenario, s.path + ": the window exists on every frame (" + s.unwindowed + " of " + s.frames + " frames without; a viewport " + HEIGHT + " px tall)");
  });
}

function timings(scenario, net, events, presses, meta) {
  const commits = events.filter((e) => e.type === "commit");
  const loads = events.filter((e) => e.type === "centre-load");
  // Each landing against the press before it. Not the i-th press's: a step
  // passed in transit (a press queued when its payload came) never commits.
  commits.forEach((c) => {
    const k = presses.filter((p) => p.t <= c.t).length;
    if (!k) return;
    const l = loads.find((e) => e.t >= c.t);
    console.log("  " + scenario + " landing " + c.path + ": " + (c.t - presses[k - 1].t) + " ms after press " + k + " (" + (c.t - presses[0].t) + " ms after the first), centre image " + (l ? l.t - presses[k - 1].t + " ms after press " + k : "none"));
  });
  commits.forEach((c) => {
    const load = loads.find((e) => e.t >= c.t);
    if (!load) return;
    const want = new URL(load.src, BASE);
    const hits = net.filter((n) => n.kind === "media" && n.url === want.pathname + want.search);
    console.log("  " + scenario + " " + c.path + " centre image requested " + hits.length + "x, first " + (hits.length ? hits[0].t - c.t : "never") + " ms from commit -> " + (hits.length === 1 && hits[0].t < c.t ? "warmed before the commit, reused" : hits.length === 0 ? "never reached the proxy" : "fetched at or after the commit"));
  });
  void meta;
}

async function scenarioCold(browser, meta) {
  const start = IDS[IDS.length - 1];
  const { ctx, page, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  const { samples } = await dump(page);
  const segs = segments(samples, 0);
  judgeSegments("cold", segs);
  reportErrors("cold", errors);
  await ctx.close();
}

async function walk(browser, meta, scenario, gaps) {
  const start = IDS[IDS.length - 1];
  const { ctx, page, net, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  const t0 = await now(page);
  const presses = [];
  for (let i = 0; i <= gaps.length; i++) {
    presses.push({ t: await now(page) });
    await page.keyboard.press("ArrowRight");
    if (i < gaps.length) await sleep(gaps[i]);
  }
  await sleep(2 * (IMG_DELAY + JSON_DELAY) + 2500);
  const { samples, events } = await dump(page);
  const segs = segments(samples, t0);
  judgeSegments(scenario, segs);
  const want = pathOf(IDS[IDS.length - 1 - presses.length]);
  const at = await page.evaluate(() => location.pathname);
  check(at === want, scenario, presses.length + " press(es) -> " + presses.length + " step(s): at " + at + ", want " + want);
  const pre = segs[0];
  check(pre && pre.tagsMove <= 1, scenario, "nothing moves between the press and the commit (moved " + (pre && pre.tagsMove) + " px)");
  crossings(scenario, samples, t0);
  timings(scenario, net, events, presses, meta);
  builds(scenario, net, t0, presses.length);
  if (presses.length > 1) {
    // The post two ahead: its payload asked for before the second press.
    const twoAhead = IDS[IDS.length - 3];
    const asked = net.find((n) => n.kind === "payload" && n.url.startsWith("/posts/" + twoAhead + "/modulation.json"));
    check(!!asked && asked.t <= presses[1].t, scenario, "the post two ahead (#" + twoAhead + ") was requested by the second press (" + (asked ? (asked.t - presses[1].t) + " ms from it" : "never") + ")");
  }
  reportErrors(scenario, errors);
  await ctx.close();
}

// Presses faster than payloads arrive, from just after load (the lookahead has
// had no time): one slot queues, so a press during a step replaces the one
// waiting -- fewer steps than presses is by design; a move is not.
async function scenarioWalk(browser, meta) {
  const start = IDS[IDS.length - 1];
  const { ctx, page, net, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await page.waitForFunction(() => document.querySelector(".mod-sortrow.is-current img"), null, { timeout: 15000 }).catch(() => {});
  await sleep(300);
  const t0 = await now(page);
  const presses = [];
  for (let i = 0; i < 5; i++) {
    presses.push({ t: await now(page) });
    await page.keyboard.press("ArrowRight");
    await sleep(300);
  }
  await sleep(3 * (IMG_DELAY + JSON_DELAY) + 3000);
  const { samples, events } = await dump(page);
  judgeSegments("walk300", segments(samples, t0));
  crossings("walk300", samples, t0);
  const commits = events.filter((e) => e.type === "commit" && e.t >= t0);
  builds("walk300", net, t0, commits.length);
  console.log("  walk300 5 presses -> " + commits.length + " landings, at " + (await page.evaluate(() => location.pathname)) + "; commits at " + commits.map((c) => c.t - t0).join(", ") + " ms");
  // Steps, not commits: a step passed in transit is never committed.
  const steps = IDS.indexOf(start) - IDS.indexOf(Number((await page.evaluate(() => location.pathname)).split("/").pop()));
  check(steps >= 2, "walk300", "a press during a step is queued, not dropped (" + steps + " steps, " + commits.length + " landings)");
  timings("walk300", net, events, [], meta);
  reportErrors("walk300", errors);
  await ctx.close();
}

async function scenarioBlocked(browser, meta) {
  const start = IDS[IDS.length - 2];
  const { ctx, page, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  const before = await page.evaluate(() => window.__pv.samples[window.__pv.samples.length - 1]);
  const t0 = await now(page);
  await block(page, ownTag(meta, start));
  await sleep(1200);
  const { samples } = await dump(page);
  const after = samples.filter((s) => s.t >= t0);
  const last = after[after.length - 1];
  console.log("  blocked before stageH=" + before.stageH + " after stageH=" + last.stageH + " blocked=" + last.blocked);
  check(last.blocked, "blocked", "the centre is marked blocked");
  check(Math.min(...after.map((s) => s.stageH)) >= before.stageH - 1, "blocked", "the stage keeps its box while the centre is blocked (min " + Math.min(...after.map((s) => s.stageH)) + " vs " + before.stageH + ")");
  if (last.colN !== null) check(after.every((s) => s.tileP && s.tileN), "blocked", "both flank tiles stay painted beside a blocked centre");
  const marked = after.findIndex((s) => s.blocked);
  check(marked >= 0 && after.slice(marked).every((s) => !s.shown), "blocked", "the blocked image is not shown once the centre is marked");
  await unblockAll(page);
  reportErrors("blocked", errors);
  await ctx.close();
}

async function scenarioColdBlocked(browser, meta) {
  const target = IDS[IDS.length - 2];
  const tag = ownTag(meta, target);
  const setup = await open(browser, meta, urlOf(IDS[0]));
  await unblockAll(setup.page);
  await block(setup.page, tag);
  await setup.ctx.close();
  const { ctx, page, errors } = await open(browser, meta, urlOf(target), { imgDelay: 0 });
  await sleep(2500);
  const { samples } = await dump(page);
  const flashes = samples.filter((s) => s.shown && s.done && !s.blocked);
  check(samples.some((s) => s.blocked), "coldblocked", "the engine marks the blocked centre");
  check(flashes.length === 0, "coldblocked", "the blocked image never paints before the engine applies (" + flashes.length + " frames painted)");
  const marked = samples.find((s) => s.blocked);
  check(!marked || samples.filter((s) => s.t >= marked.t).every((s) => s.stageH >= 100), "coldblocked", "the stage keeps a box once the centre is blocked");
  await unblockAll(page);
  reportErrors("coldblocked", errors);
  await ctx.close();
}

async function scenarioFail(browser, meta) {
  const start = IDS[IDS.length - 1];
  const next = IDS[IDS.length - 2];
  const { ctx, page, errors } = await open(browser, meta, urlOf(start), { failId: next });
  await unblockAll(page);
  await rest(page);
  await page.evaluate(() => { window.__sentinel = 7; });
  await page.keyboard.press("ArrowRight");
  await sleep(JSON_DELAY + 1500);
  const state = await page.evaluate(() => ({ path: location.pathname, sentinel: window.__sentinel === 7, status: (document.querySelector('[data-region="flank-status"]') || {}).textContent || "", shown: !!document.querySelector('[data-region="flank-status"].is-shown') })).catch(() => ({ path: "(page reloaded)", sentinel: false, status: "", shown: false }));
  console.log("  fail500 status: " + JSON.stringify(state.status));
  check(state.sentinel, "fail500", "no reload on a failed payload");
  check(state.path === pathOf(start), "fail500", "the URL stays on #" + start + " (at " + state.path + ")");
  check(state.shown && state.status.includes(String(next)), "fail500", "the status line names #" + next + " and why");
  check(errors.some((e) => e.includes(String(next))), "fail500", "the console names the failed post");
  await ctx.close();
}

// ACROSS EACH COMMIT, not within it: segments() judges each post from its
// own commit frame on, so a jump AT the commit -- the stage taking the next
// post's box, a notice strip above it -- is excluded by construction (review,
// 2026-10-18). This judges, for every consecutive pair of posts, how far the
// window (the centre's box), the stage, the tag panel's top edge and both
// flank columns moved between their settled frames, and prints how far the
// notices block, the shelf, the panel's bottom and the comments moved (the
// panel's contents are the post's own). Operator, 2026-10-18: "one fixed
// window" -- the image area is one size for every post, so none of the held
// measures may move at a landing whatever the two posts' shapes; and notices
// go below the image, so a post with one moves nothing above them, and the
// shelf under them by their height alone. Answers the pairs it saw, so a
// caller can check its coverage.
function crossings(scenario, samples, from) {
  const settled = [];
  samples.filter((s) => s.t >= from && s.tagsTop != null).forEach((s) => {
    const last = settled[settled.length - 1];
    if (!last || last.path !== s.path) settled.push(s);
    else settled[settled.length - 1] = s;
  });
  const d = (a, b, k) => (a[k] == null || b[k] == null ? null : Math.round((b[k] - a[k]) * 10) / 10);
  const HELD = [["bW", "window width"], ["bH", "window height"], ["stageTop", "stage top"], ["stageH", "stage height"], ["tagsTop", "tag panel"], ["colPx", "prev column x"], ["colNx", "next column x"], ["colP", "prev column height"], ["colN", "next column height"]];
  const pairs = [];
  for (let i = 1; i < settled.length; i++) {
    const a = settled[i - 1], b = settled[i];
    const moved = HELD.map(([k, words]) => [words, d(a, b, k)]).filter(([, v]) => v !== null);
    const comments = d(a, b, "commentsTop"), shelf = d(a, b, "shelfTop"), notices = d(a, b, "nH"), bottom = d(a, b, "tagsBottom");
    const said = (v) => (v === null ? "-" : v);
    console.log("  " + scenario + " across " + a.path + " -> " + b.path + " (notices " + a.notices + " -> " + b.notices + "): " + moved.map(([w, v]) => w + " " + v).join(", ") + "; inside the panel (moved, not held): notices block " + said(notices) + ", shelf " + said(shelf) + ", panel bottom " + said(bottom) + ", comments " + said(comments));
    const worst = moved.filter(([, v]) => Math.abs(v) > 1);
    check(worst.length === 0, scenario, "across " + a.path + " -> " + b.path + ": the window, the stage, the tag panel's top edge and the flank columns hold still (" + (worst.length ? worst.map(([w, v]) => w + " " + v + " px").join(", ") : "none moved") + ")");
    // The panel's contents are the post's own, so they are not held -- but
    // the notices sit above the shelf (operator, 2026-10-18: "below the
    // image"), and the shelf may move by the notices that arrived or left
    // and by nothing else.
    if (shelf !== null) check(Math.abs(shelf - notices) <= 1, scenario, "across " + a.path + " -> " + b.path + ": the shelf moves only by the notices above it (shelf " + shelf + " px, notices " + notices + " px)");
    pairs.push({ from: a.path, to: b.path, notices: b.notices, shelves: shelf !== null });
  }
  return pairs;
}

// Payload builds per step, by read: full (the page, a re-read), prefetch (a
// neighbour fetched ahead), visit (the read after landing on a prefetched
// post). HEAD made only full reads.
function builds(scenario, net, from, steps) {
  const asked = net.filter((n) => n.kind === "payload" && n.t >= from);
  const by = (f) => asked.filter((n) => n.flavour === f).length;
  console.log("  " + scenario + " payload requests from the first press: " + asked.length + " (full " + by("full") + ", prefetch " + by("prefetch") + ", visit " + by("visit") + ") over " + steps + " step(s)");
}

// A CHAIN: five presses faster than a step, after the lookahead has warmed
// the run. A press during a step queues; a step that arrives with a press
// queued is IN TRANSIT -- never drawn -- so the page draws only posts it lands
// on, and every post it lands on shows its picture (review, 2026-10-18: the
// intermediate post's page state was drawn and its picture never shown).
async function scenarioChain(browser, meta) {
  const start = IDS[IDS.length - 1];
  const { ctx, page, net, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  const t0 = await now(page);
  for (let i = 0; i < 5; i++) {
    await page.keyboard.press("ArrowRight");
    await sleep(120);
  }
  await sleep(2 * (IMG_DELAY + JSON_DELAY) + 2500);
  const { samples, events } = await dump(page);
  const segs = segments(samples, t0);
  judgeSegments("chain", segs);
  crossings("chain", samples, t0);
  const commits = events.filter((e) => e.type === "commit" && e.t >= t0);
  const landed = new Set([pathOf(start), ...commits.map((c) => c.path)]);
  const at = await page.evaluate(() => location.pathname);
  console.log("  chain 5 presses -> " + commits.length + " landing(s): " + commits.map((c) => c.path + " at " + (c.t - t0) + " ms").join(", ") + "; at " + at);
  check(at !== pathOf(start), "chain", "the presses moved the page (at " + at + ")");
  // Drawn: the centre's picture names a post's md5; every one drawn must be a
  // post the page landed on.
  const md5Of = (src) => { const m = /([0-9a-f]{32})/.exec(src || ""); return m && m[1]; };
  const landedMd5 = new Set([...landed].map((p) => meta.byId.get(Number(p.split("/").pop())).md5));
  const drawn = [...new Set(samples.filter((s) => s.t >= t0 && s.src).map((s) => md5Of(s.src)))];
  const strays = drawn.filter((m) => !landedMd5.has(m));
  check(strays.length === 0, "chain", "no post drawn in the centre that the page did not land on (" + strays.length + " drawn in transit)");
  const bySeg = segments(samples, t0).map((seg) => seg.path);
  bySeg.slice(1).forEach((p) => {
    const rows = samples.filter((s) => s.t >= t0 && s.path === p);
    const seen = rows.some((r) => r.shown && r.cOp >= 0.99);
    check(seen, "chain", p + ": the post landed on shows its picture");
  });
  const pushes = await page.evaluate(() => history.length);
  console.log("  chain history entries: " + pushes);
  builds("chain", net, t0, commits.length);
  reportErrors("chain", errors);
  await ctx.close();
}

// RANDOM, walked forward at a normal pace: each press as soon as the post
// before has landed and grown in. The trail is cleared first. A prefetch of
// the trail's frontier post rolls past it, so no press may meet a "still
// loading" side (review, 2026-10-18: every forward step along random waited on
// a second build after the landing).
async function scenarioRandom(browser, meta) {
  const start = IDS[IDS.length - 1];
  const search = QUERY + " order:random";
  const cleared = await fetch(BASE + "/modulation/random_trail?q=" + encodeURIComponent(search), { method: "DELETE", headers: { Authorization: HEADER, Accept: "application/json" } });
  if (!cleared.ok) die("clearing the random trail answered " + cleared.status + ". fix: check POSTVIEW_AUTH.");
  const { ctx, page, net, errors } = await open(browser, meta, pathOf(start) + "?q=" + encodeURIComponent(search));
  await unblockAll(page);
  await rest(page);
  const t0 = await now(page);
  const presses = [];
  for (let i = 0; i < 4; i++) {
    const before = await page.evaluate(() => location.pathname);
    presses.push({ t: await now(page) });
    await page.keyboard.press("ArrowRight");
    await page.waitForFunction((b) => location.pathname !== b, before, { timeout: 15000 }).catch(() => {});
    await sleep(SWAP_GROW_MS);
  }
  await sleep(IMG_DELAY + JSON_DELAY + 1500);
  const { samples, events } = await dump(page);
  judgeSegments("random", segments(samples, t0));
  const commits = events.filter((e) => e.type === "commit" && e.t >= t0);
  check(commits.length === presses.length, "random", presses.length + " presses -> " + commits.length + " steps");
  const loading = samples.filter((s) => s.t >= t0 && /Still loading/.test(s.status)).length;
  check(loading === 0, "random", "no press met a side still loading (" + loading + " frames showed it)");
  timings("random", net, events, presses, meta);
  builds("random", net, t0, commits.length);
  reportErrors("random", errors);
  await ctx.close();
}
const SWAP_GROW_MS = 400;

// SCROLLED INTO THE COMMENTS: both posts carry the same long thread. A step
// shows the next post from its prefetch, which has no comments; its
// placeholder must keep the section's height until the comments arrive, or
// the document shrinks under a viewer scrolled into the thread and the
// browser pulls the scroll position up, for good (review, 2026-10-18). The
// scroll position itself is not the measure: scroll anchoring moves it, on
// purpose, when the new post's stage above is shorter.
async function scenarioComments(browser, meta) {
  const start = IDS[IDS.length - 1];
  const { ctx, page, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  await page.evaluate(() => window.scrollTo(0, document.documentElement.scrollHeight));
  await sleep(300);
  const before = await page.evaluate(() => window.__pv.samples[window.__pv.samples.length - 1]);
  const t0 = await now(page);
  await page.keyboard.press("ArrowRight");
  await sleep(JSON_DELAY + IMG_DELAY + 2000);
  const { samples } = await dump(page);
  const after = samples.filter((s) => s.t >= t0);
  const minH = Math.min(...after.map((s) => s.commentsH));
  const end = after[after.length - 1];
  console.log("  comments before: section " + before.commentsH + " px, y=" + before.scrollY + " doc " + before.docH + "; during: lowest section " + minH + " px, lowest y " + Math.min(...after.map((s) => s.scrollY)) + ", lowest doc " + Math.min(...after.map((s) => s.docH)) + "; after: section " + end.commentsH + " px, y=" + end.scrollY + " doc " + end.docH + " at " + end.path);
  check(end.path !== pathOf(start), "comments", "the press stepped (at " + end.path + ")");
  check(minH >= before.commentsH - 1, "comments", "the comment section never shorter than it was while the next post's comments are on their way (lowest " + minH + " vs " + before.commentsH + " px; both threads are the same length)");
  reportErrors("comments", errors);
  await ctx.close();
}

// SHAPES: from the tall post with a creator tag, three presses at a normal
// pace -- each once the last has landed and its picture is in -- through the
// wide post with a family notice, the video and the small picture. The
// window holds one size and nothing may move at any landing (operator,
// 2026-10-18: "one fixed window"; notices "below the image"). The walk must
// actually cross from a tall post into a wide one and land on a post with a
// notice, or it proves nothing: both are checked.
async function scenarioShapes(browser, meta) {
  const start = IDS[IDS.length - 2];
  const { ctx, page, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  // Beside the picture is not on it: a click in the window's empty space
  // must not open the fullscreen viewer. Where the picture is drawn is worked
  // out from its box and the window, not read from the page, so a frame that
  // fills the window and letterboxes the picture inside it is caught.
  const spot = await page.evaluate(() => {
    const c = document.querySelector('[data-region="center"]'), r = c.getBoundingClientRect(), cs = getComputedStyle(c);
    const bw = Number(cs.getPropertyValue("--mod-bw")), bh = Number(cs.getPropertyValue("--mod-bh"));
    const s = Math.min(1, (r.width - 2) / bw, (r.height - 2) / bh), side = (r.width - (bw * s)) / 2, over = (r.height - (bh * s)) / 2;
    if (side >= 6) return { x: r.left + (side / 2), y: r.top + (r.height / 2), margin: Math.round(side) };
    if (over >= 6) return { x: r.left + (r.width / 2), y: r.top + (over / 2), margin: Math.round(over) };
    return null;
  });
  check(Boolean(spot), "shapes", "the tall post leaves empty space in the window to click (" + (spot ? spot.margin + " px" : "none") + ")");
  if (spot) {
    await page.mouse.click(spot.x, spot.y);
    await sleep(300);
    const opened = await page.evaluate(() => Boolean(document.querySelector(".mod-lightbox")));
    check(!opened, "shapes", "a click in the window's empty space, " + spot.margin + " px beside the picture, does not open the fullscreen viewer");
    if (opened) { await page.keyboard.press("Escape"); await sleep(300); }
  }
  const t0 = await now(page);
  for (let i = 0; i < 3; i++) {
    const before = await page.evaluate(() => location.pathname);
    await page.keyboard.press("ArrowRight");
    await page.waitForFunction((b) => location.pathname !== b, before, { timeout: 15000 }).catch(() => {});
    await page.waitForFunction(() => { const s = window.__pv.samples; const l = s[s.length - 1]; return l && l.done; }, null, { timeout: 15000 }).catch(() => {});
    await sleep(600);
  }
  await sleep(500);
  const { samples } = await dump(page);
  judgeSegments("shapes", segments(samples, t0));
  const pairs = crossings("shapes", samples, t0);
  const shape = (p) => { const post = meta.byId.get(Number(p.split("/").pop())); return post.image_height > post.image_width ? "tall" : "wide"; };
  check(pairs.length === 3, "shapes", "three presses -> three landings (" + pairs.length + ")");
  check(pairs.some((p) => shape(p.from) === "tall" && shape(p.to) === "wide"), "shapes", "the walk crossed from a tall post into a wide one (" + pairs.map((p) => shape(p.from) + "->" + shape(p.to)).join(", ") + ")");
  check(pairs.some((p) => p.notices > 0), "shapes", "the walk landed on a post with a notice (" + pairs.map((p) => p.to + ":" + p.notices).join(", ") + ")");
  check(pairs.some((p) => p.notices > 0 && p.shelves), "shapes", "the walk crossed from a shelf onto a shelf under a notice, so the shelf's move was judged (" + pairs.map((p) => p.to + ":" + (p.shelves ? "shelves" : "-")).join(", ") + ")");
  reportErrors("shapes", errors);
  await ctx.close();
}

function reportErrors(scenario, errors) {
  const noise = /webpack-dev-server|ws:\/\/|CORS policy|Cross-Origin Request Blocked|Failed to load resource|Failed to fetch|did not load \(HTTP 500\)/;
  const mine = errors.filter((e) => !noise.test(e));
  check(mine.length === 0, scenario, "no script errors: " + JSON.stringify(mine));
}

// ENTRY: the window is cut from the screen, never from the post on it -- so
// the same screen gives the same window whichever post the visit opens on: one
// with no shelf, one with a one-row shelf, one with a taller shelf under a
// notice (review, 2026-10-18: the cut read the entry post's shelf, 604 px
// opening on one post and 561 on the next).
async function scenarioEntry(browser, meta) {
  const sizes = [];
  for (const id of [IDS[IDS.length - 1], IDS[IDS.length - 2], IDS[5]]) {
    const { ctx, page, errors } = await open(browser, meta, urlOf(id));
    await unblockAll(page);
    await rest(page);
    const { samples } = await dump(page);
    const segs = segments(samples, 0);
    judgeSegments("entry", segs);
    const e = segs[segs.length - 1].end;
    sizes.push({ id, w: e.bW, h: e.bH, shelf: e.shelfTop !== null, notices: e.notices });
    reportErrors("entry", errors);
    await ctx.close();
  }
  console.log("  entry windows: " + sizes.map((s) => "#" + s.id + " " + s.w + "x" + s.h + (s.shelf ? " (shelf" : " (no shelf") + ", notices " + s.notices + ")").join(", "));
  const [first] = sizes;
  check(sizes.every((s) => Math.abs(s.w - first.w) <= 1 && Math.abs(s.h - first.h) <= 1), "entry", "one window whichever post the visit opens on (" + sizes.map((s) => s.w + "x" + s.h).join(", ") + ")");
  check(sizes.some((s) => !s.shelf) && sizes.some((s) => s.shelf && s.notices > 0), "entry", "the entries covered a post with no shelf and one with a shelf under a notice");
}

// BANNER: something above the post view appears or goes after the window was cut
// -- a dmail or verify-account notice dismissed, a navbar control wrapping.
// The stage moves with it, so the window is re-cut: it gives up (or takes
// back) exactly the banner's height, and the tag panel's head still ends on
// the first screen (review, 2026-10-18: the window was cut once, on load).
async function scenarioBanner(browser, meta) {
  const start = IDS[IDS.length - 1];
  const { ctx, page, errors } = await open(browser, meta, urlOf(start));
  await unblockAll(page);
  await rest(page);
  const last = () => page.evaluate(() => window.__pv.samples[window.__pv.samples.length - 1]);
  const before = await last();
  await page.evaluate(() => { const b = document.createElement("div"); b.id = "pvshift-banner"; b.style.cssText = "height:80px;margin:0;padding:0"; const p = document.getElementById("page"); p.insertBefore(b, p.firstChild); });
  await sleep(500);
  const shown = await last();
  await page.evaluate(() => document.getElementById("pvshift-banner").remove());
  await sleep(500);
  const gone = await last();
  console.log("  banner window " + before.bH + " -> " + shown.bH + " with the banner -> " + gone.bH + " without; stage top " + before.stageTop + " -> " + shown.stageTop + " -> " + gone.stageTop + "; head past the fold " + before.foldHead + " / " + shown.foldHead + " / " + gone.foldHead);
  check(Math.abs(shown.stageTop - before.stageTop - 80) <= 1, "banner", "the banner pushed the stage down by its 80 px (" + Math.round(shown.stageTop - before.stageTop) + ")");
  check(Math.abs(before.bH - shown.bH - 80) <= 1, "banner", "the window gave up the banner's 80 px (" + before.bH + " -> " + shown.bH + ")");
  check(Math.abs(gone.bH - before.bH) <= 1, "banner", "the window took them back when the banner went (" + shown.bH + " -> " + gone.bH + ", was " + before.bH + ")");
  if (FOLD) check(shown.foldHead <= 0, "banner", "with the banner, the tag panel's head still ends on the first screen (" + shown.foldHead + " px past it)");
  reportErrors("banner", errors);
  await ctx.close();
}

(async () => {
  const pw = loadPlaywright();
  const meta = await postsMeta();
  proxy = await startProxy(meta);
  const browser = await pw[ENGINE].launch({ proxy: { server: "http://127.0.0.1:" + proxy.port } });
  try {
    for (const s of SCENARIOS) {
      if (s === "cold") await scenarioCold(browser, meta);
      else if (s === "step") await walk(browser, meta, "step", []);
      else if (s === "double150") await walk(browser, meta, "double150", [150]);
      else if (s === "double300") await walk(browser, meta, "double300", [300]);
      else if (s === "blocked") await scenarioBlocked(browser, meta);
      else if (s === "coldblocked") await scenarioColdBlocked(browser, meta);
      else if (s === "fail500") await scenarioFail(browser, meta);
      else if (s === "walk300") await scenarioWalk(browser, meta);
      else if (s === "chain") await scenarioChain(browser, meta);
      else if (s === "random") await scenarioRandom(browser, meta);
      else if (s === "comments") await scenarioComments(browser, meta);
      else if (s === "shapes") await scenarioShapes(browser, meta);
      else if (s === "entry") await scenarioEntry(browser, meta);
      else if (s === "banner") await scenarioBanner(browser, meta);
    }
  } finally {
    await browser.close();
    proxy.srv.close();
  }
  console.log(failures ? failures + " FAIL" : "all PASS");
  process.exit(failures ? 1 : 0);
})().catch((e) => { console.error("FAIL: " + (e && e.stack || e)); process.exit(2); });
