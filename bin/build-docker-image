#!/usr/bin/env bash

# Build a Docker image. Note that uncommited changes won't be included in the
# image; commit changes to Git first before building the image.
#
# This will build two images, one called `danbooru` and the other called
# `danbooru:development`. The development image contains additional tools
# needed to rebuild the JS and CSS files during development.
#
# Usage:
#
#    # Commit any changed files first or they won't be included in the build.
#    $ git commit --all
#
#    # Build images named `danbooru` and `danbooru:development`.
#    $ bin/build-docker-image danbooru
#
#    # Build ARM images named `danbooru:arm64` and `danbooru:development-arm64`.
#    # To build ARM images on x86, you must install QEMU first.
#    $ sudo apt-get install qemu-system-arm qemu-user-static binfmt-support
#    $ bin/build-docker-image danbooru linux/arm64
#
#    # Build multi-architecture images for ARM and x86 named `danbooru` and `danbooru:development`.
#    $ bin/build-docker-image danbooru linux/amd64,linux/arm64
#
#    # Test out the new image.
#    $ DANBOORU_IMAGE=danbooru:development bin/dev
#
#    # FORK CHANGE: build only some of the images. The serving box runs only
#    # the production image, and building the development one there cost
#    # about two minutes and 2.4GB of every deploy (2026-10-04).
#    $ TARGETS=production bin/build-docker-image danbooru

set -euxo pipefail

ARCH="$(docker info -f '{{ .ClientInfo.Arch }}')"
CURRENT_PLATFORM="linux/$ARCH"

JOBS="${JOBS:-$(nproc)}"
TARGETS="${TARGETS:-development production}"
for target in $TARGETS; do
  [[ $target == development || $target == production ]] || { echo "FAIL: unknown target '$target' in TARGETS. fix: TARGETS is any of: development production" >&2; exit 2; }
done

IMAGE="${1:-danbooru}"
PLATFORM="${2:-$CURRENT_PLATFORM}"

DOCKER_IMAGE_REVISION=$(git rev-parse HEAD)
DOCKER_IMAGE_BUILD_DATE="$(TZ=UTC git show --no-patch --date=format-local:"%Y-%m-%dT%H:%M:%SZ" --format="%cd" $DOCKER_IMAGE_REVISION)"

# SOURCE_DATE_EPOCH is deliberately NOT set, and the exporter is not asked to
# rewrite timestamps. Upstream derives it from the HEAD commit for reproducible
# image timestamps; on this fork that cost about ten minutes of every build.
#
# BuildKit turns SOURCE_DATE_EPOCH into an implicit ARG for EVERY stage, so it
# lands in every cache key. A new commit means a new timestamp, which means the
# whole dependency chain -- Ruby, MozJPEG, vips, FFmpeg, ExifTool, OpenResty,
# Node -- is a cache miss, on every single build, no matter how small the change.
#
# Measured on this hardware 2026-08-22, building the same tree three ways:
#
#   per-commit epoch (upstream's behaviour)   ~960s     2 cached / 50 rebuilt
#   epoch pinned to a constant                 102s    86 cached / 20 rebuilt
#   no epoch at all (this)                     102s    86 cached / 20 rebuilt
#
# Isolated by bisection rather than guessed: holding the epoch constant while
# varying the revision cached; holding the revision constant while varying the
# epoch rebuilt; and re-using a previously seen epoch cached again. Passing it
# through the environment instead of --build-arg does NOT help -- buildx feeds
# it into the build either way.
#
# What this gives up is reproducible layer timestamps, which upstream added for
# their CI and which a single-box deploy gets little from. What it gains, beyond
# the time, is that `docker images` finally shows when an image was actually
# BUILT rather than when its source was committed -- which is the question
# anyone reading that column is asking.
#
# Nothing else depends on it: DOCKER_IMAGE_BUILD_DATE is a separate build arg,
# consumed only in the final stages, and remains the commit date that
# ServerStatus reports.

# FORK CHANGE: the builder's buildkit is pinned, so what builds the image is a
# chosen release rather than whatever moby/buildkit:buildx-stable-1 names that
# day: on 2026-10-31 that was still v0.33.1, eleven days after v0.34.1, with Go
# stdlib criticals v0.34.1 does not carry. Every released buildkit still ships
# Alpine's brotli-libs 1.2.0 (KEV CVE-2026-111497, scan of 2026-10-31); the
# trap below keeps the builder stopped between builds, and the scan's accepted
# list carries that row until a release with the fix is past the cooldown.
#
# `buildx create` leaves an existing builder as it is, so a builder on another
# image is replaced here, its cache kept. A running builder is a build in
# progress (the trap stops it after every build) and replacing it would kill
# that build, so then this refuses rather than build on an unpinned buildkit.
BUILDKIT_IMAGE="moby/buildkit:v0.34.1@sha256:99368f3e46177c6405b9740e4461d91cee004128daeecca78d4ceac50ec1da5c"
BUILDKIT_NODE=buildx_buildkit_nonparallel-builder0
if [[ "$(docker inspect -f '{{.Config.Image}}' $BUILDKIT_NODE 2> /dev/null)" != "$BUILDKIT_IMAGE" ]]; then
  if [[ "$(docker inspect -f '{{.State.Running}}' $BUILDKIT_NODE 2> /dev/null)" == true ]]; then
    echo "FAIL: nonparallel-builder runs $(docker inspect -f '{{.Config.Image}}' $BUILDKIT_NODE), not $BUILDKIT_IMAGE, and is running, so a build may be using it" >&2
    echo "fix:  rerun once that build has finished (it stops the builder on exit); if no build is running: docker buildx stop nonparallel-builder" >&2
    exit 1
  fi
  docker buildx rm --keep-state nonparallel-builder > /dev/null 2>&1 || true # absent is fine; a failure here fails the create below
  docker buildx create --use --name nonparallel-builder --driver docker-container --driver-opt "image=$BUILDKIT_IMAGE" --config buildkitd.toml
  docker buildx inspect --bootstrap nonparallel-builder > /dev/null
fi
[[ "$(docker inspect -f '{{.Config.Image}}' $BUILDKIT_NODE 2> /dev/null)" == "$BUILDKIT_IMAGE" ]] || {
  echo "FAIL: nonparallel-builder does not run $BUILDKIT_IMAGE after being created from it" >&2
  echo "fix:  docker buildx rm --keep-state nonparallel-builder, then rerun" >&2
  exit 1
}

# The builder is a buildkit container nothing but a build uses. Left running
# between builds it is a live image the nightly vulnerability scan counts (13
# High in buildkit's Go modules, 2026-10-25, unfixed in the current release),
# serving nothing. Stopped, its cache stays in its state volume and the next
# `buildx build` starts it again. A build still running elsewhere keeps it up:
# stopping it would kill that build.
trap 'pgrep -f "buildx build" >/dev/null || docker buildx stop nonparallel-builder >/dev/null 2>&1 || true' EXIT

if [[ $PLATFORM != $CURRENT_PLATFORM && $PLATFORM != *,* ]]; then
  # If we're building for a different platform, and it's not a multi-platform image, then name the image after the platform so it doesn't conflict with images for the native platform.
  TARGET_ARCH="${PLATFORM#*/}" # linux/arm64 -> arm64
  DEV_NAME="$IMAGE:development-$TARGET_ARCH"; PROD_NAME="$IMAGE:$TARGET_ARCH"
else
  DEV_NAME="$IMAGE:development"; PROD_NAME="$IMAGE"
fi

for target in $TARGETS; do
  name=$PROD_NAME; [[ $target == development ]] && name=$DEV_NAME
  git archive HEAD | docker buildx build - --builder nonparallel-builder --platform $PLATFORM --build-arg DOCKER_IMAGE_REVISION=$DOCKER_IMAGE_REVISION --build-arg DOCKER_IMAGE_BUILD_DATE=$DOCKER_IMAGE_BUILD_DATE --build-arg JOBS=$JOBS --target $target --file Dockerfile --output type=docker,name=$name
done
