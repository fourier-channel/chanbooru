#!/usr/bin/env bash

# Build a Docker image. Note that uncommited changes won't be included in the
# image; commit changes to Git first before building the image.
#
# This will build two images, one called `danbooru` and the other called
# `danbooru:development`. The development image contains additional tools
# needed to rebuild the JS and CSS files during development.
#
# Usage:
#
#    # Commit any changed files first or they won't be included in the build.
#    $ git commit --all
#
#    # Build images named `danbooru` and `danbooru:development`.
#    $ bin/build-docker-image danbooru
#
#    # Build ARM images named `danbooru:arm64` and `danbooru:development-arm64`.
#    # To build ARM images on x86, you must install QEMU first.
#    $ sudo apt-get install qemu-system-arm qemu-user-static binfmt-support
#    $ bin/build-docker-image danbooru linux/arm64
#
#    # Build multi-architecture images for ARM and x86 named `danbooru` and `danbooru:development`.
#    $ bin/build-docker-image danbooru linux/amd64,linux/arm64
#
#    # Test out the new image.
#    $ DANBOORU_IMAGE=danbooru:development bin/dev

set -euxo pipefail

ARCH="$(docker info -f '{{ .ClientInfo.Arch }}')"
CURRENT_PLATFORM="linux/$ARCH"

JOBS="${JOBS:-$(nproc)}"

IMAGE="${1:-danbooru}"
PLATFORM="${2:-$CURRENT_PLATFORM}"

DOCKER_IMAGE_REVISION=$(git rev-parse HEAD)
DOCKER_IMAGE_BUILD_DATE="$(TZ=UTC git show --no-patch --date=format-local:"%Y-%m-%dT%H:%M:%SZ" --format="%cd" $DOCKER_IMAGE_REVISION)"

# SOURCE_DATE_EPOCH is deliberately NOT set, and the exporter is not asked to
# rewrite timestamps. Upstream derives it from the HEAD commit for reproducible
# image timestamps; on this fork that cost about ten minutes of every build.
#
# BuildKit turns SOURCE_DATE_EPOCH into an implicit ARG for EVERY stage, so it
# lands in every cache key. A new commit means a new timestamp, which means the
# whole dependency chain -- Ruby, MozJPEG, vips, FFmpeg, ExifTool, OpenResty,
# Node -- is a cache miss, on every single build, no matter how small the change.
#
# Measured on this hardware 2026-08-22, building the same tree three ways:
#
#   per-commit epoch (upstream's behaviour)   ~960s     2 cached / 50 rebuilt
#   epoch pinned to a constant                 102s    86 cached / 20 rebuilt
#   no epoch at all (this)                     102s    86 cached / 20 rebuilt
#
# Isolated by bisection rather than guessed: holding the epoch constant while
# varying the revision cached; holding the revision constant while varying the
# epoch rebuilt; and re-using a previously seen epoch cached again. Passing it
# through the environment instead of --build-arg does NOT help -- buildx feeds
# it into the build either way.
#
# What this gives up is reproducible layer timestamps, which upstream added for
# their CI and which a single-box deploy gets little from. What it gains, beyond
# the time, is that `docker images` finally shows when an image was actually
# BUILT rather than when its source was committed -- which is the question
# anyone reading that column is asking.
#
# Nothing else depends on it: DOCKER_IMAGE_BUILD_DATE is a separate build arg,
# consumed only in the final stages, and remains the commit date that
# ServerStatus reports.

docker buildx create --use --name nonparallel-builder --config buildkitd.toml 2> /dev/null || true;

if [[ $PLATFORM != $CURRENT_PLATFORM && $PLATFORM != *,* ]]; then
  # If we're building for a different platform, and it's not a multi-platform image, then name the image after the platform so it doesn't conflict with images for the native platform.
  TARGET_ARCH="${PLATFORM#*/}" # linux/arm64 -> arm64
  git archive HEAD | docker buildx build - --platform $PLATFORM --build-arg DOCKER_IMAGE_REVISION=$DOCKER_IMAGE_REVISION --build-arg DOCKER_IMAGE_BUILD_DATE=$DOCKER_IMAGE_BUILD_DATE --build-arg JOBS=$JOBS --target development --file Dockerfile --output type=docker,name=$IMAGE:development-$TARGET_ARCH
  git archive HEAD | docker buildx build - --platform $PLATFORM --build-arg DOCKER_IMAGE_REVISION=$DOCKER_IMAGE_REVISION --build-arg DOCKER_IMAGE_BUILD_DATE=$DOCKER_IMAGE_BUILD_DATE --build-arg JOBS=$JOBS --target production  --file Dockerfile --output type=docker,name=$IMAGE:$TARGET_ARCH
else
  git archive HEAD | docker buildx build - --platform $PLATFORM --build-arg DOCKER_IMAGE_REVISION=$DOCKER_IMAGE_REVISION --build-arg DOCKER_IMAGE_BUILD_DATE=$DOCKER_IMAGE_BUILD_DATE --build-arg JOBS=$JOBS --target development --file Dockerfile --output type=docker,name=$IMAGE:development
  git archive HEAD | docker buildx build - --platform $PLATFORM --build-arg DOCKER_IMAGE_REVISION=$DOCKER_IMAGE_REVISION --build-arg DOCKER_IMAGE_BUILD_DATE=$DOCKER_IMAGE_BUILD_DATE --build-arg JOBS=$JOBS --target production  --file Dockerfile --output type=docker,name=$IMAGE
fi
