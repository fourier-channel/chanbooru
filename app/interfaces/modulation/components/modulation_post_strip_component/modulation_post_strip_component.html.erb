<section class="modstrip">
  <% if title.present? %>
    <h2 class="mod-label modstrip-title"><%= href.present? ? link_to(title, href) : title %></h2>
  <% end %>
  <% if surface.posts.empty? %>
    <% if empty_text.present? %>
      <p class="modstrip-empty"><%= empty_text %></p>
    <% end %>
  <% else %>
    <div class="modstrip-grid">
      <% surface.posts.each do |post| %>
        <%# The gallery's card (ModulationGalleryComponent::GridComponent),
            without the window's is-off. A deleted post is here only when the
            page asked for deleted posts, and stays veiled. %>
        <a class="modgal-card <%= PostCards::BLACKLIST_POST %><%= " modgal-card--spoiler" if post.is_deleted? %>" href="<%= surface.post_link(post) %>" title="post #<%= post.id %><%= " (deleted)" if post.is_deleted? %>" <%= tag.attributes(surface.card_data(post)) %>>
          <% thumb = surface.thumb_for(post) %>
          <% if thumb %>
            <img class="modgal-thumb" src="<%= thumb %>" alt="" loading="lazy">
          <% else %>
            <span class="modgal-thumb modgal-thumb--gated">gated</span>
          <% end %>
          <span class="modgal-card-id">#<%= post.id %></span>
          <% if (artist = surface.artist_for(post)) %>
            <span class="modgal-card-artist"><%= artist.tr("_", " ") %></span>
          <% end %>
        </a>
      <% end %>
    </div>
  <% end %>
  <% if footer? %>
    <div class="modstrip-footer"><%= footer %></div>
  <% end %>
</section>
