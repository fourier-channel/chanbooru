<%# Modulation's post index: the gallery over GallerySurface, which decides
    what it offers the viewer. Upstream's page (app/views/posts/index) is
    classic's. %>
  <% content_for(:content) do %>
    <%= render ModulationGalleryComponent.new(surface: GallerySurface.new(post_set: @post_set, viewer: CurrentUser.user, request: request, session: session)) %>
  <% end %>
  <% content_for(:html_header) do %>
    <% page_title(@post_set.post_query.is_empty_search? ? Danbooru.config.app_name : @post_set.page_title) %>
    <% meta_description @post_set.meta_description %>
  <% end %>
