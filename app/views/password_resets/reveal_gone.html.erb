<%# Fork: a one-time password link with nothing behind it (PasswordReveal):
    used, expired and never issued all read the same, so the page says nothing
    about whether it ever existed. %>
<% page_title "Link Used or Expired" %>

<div id="c-password-resets">
  <div id="a-reveal-gone">
    <div class="card mt-8 p-4 max-w-480px mx-auto flex flex-col gap-4 items-center">
      <h1>Link Used or Expired</h1>

      <p class="w-full">This link was already used or has expired. Ask an administrator for a new one.</p>
    </div>
  </div>
</div>
