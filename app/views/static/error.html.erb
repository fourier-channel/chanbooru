<% page_title "Error: #{@exception.class}" %>

<%# The page is the shared "Oh No!" walk-through (operator, 2026-10-10); this
    file supplies only its quiet details line, the error the site knows. %>
<%# A policy refusal reaches this template only when the policy said why
    (ApplicationController: denial_message); that sentence leads the page. %>
<% reason = @message.presence if @exception.is_a?(Pundit::NotAuthorizedError) %>
<%= render layout: "static/oh_no", locals: { reason: reason } do %>
  <% if reason %>
    <p><%= link_to "Go back", :back, rel: "prev" %></p>
  <% elsif @message.present? %>
    <p>Details: <%= @message %></p>
  <% else %>
    <p>Details: Unexpected error: <%= @exception.class %>.</p>

    <% if @backtrace.present? %>
      <ul class="backtrace font-monospace p-4 mb-4">
        <li><%= @exception.class.to_s %> exception raised</li>

        <% Rails.backtrace_cleaner.clean(@backtrace).each do |b| %>
          <li class="backtrace-line"><%= b %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
