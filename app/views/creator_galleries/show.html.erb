<% content_for(:content) do %>
  <%= render CreatorGalleryComponent.new(
        gallery: @gallery,
        viewer: CurrentUser.user,
        draw: @draw,
        avatar: @avatar,
        closed: @closed,
        scan: ModulationSetting.for_viewer(CurrentUser.user, session)["tuner_scan"],
        can_edit: FourierIdentity.matches?(request, @gallery.matrix_id) || CurrentUser.user.is_admin?) %>
  <%# Outside the gallery component on purpose: nothing the hero band draws changes (2026-10-09). %>
  <%= render "creator_galleries/join" if @join_groups %>
<% end %>
<% content_for(:html_header) do %>
  <% page_title(@closed ? @gallery.slug : (@gallery.title.presence || @gallery.slug)) %>
<% end %>
