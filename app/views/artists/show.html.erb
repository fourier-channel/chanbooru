<% page_title "#{@artist.pretty_name.startcase} | Artist Profile" %>
<% noindex if @artist.is_banned? %>
<%= render "secondary_links" %>

<div id="c-artists">
  <div id="a-show">
    <% if @artist.is_banned? && !policy(@artist).can_view_banned? %>
      <p>This page has been removed because of a takedown request.</p>
    <% else %>
      <%= render "artists/summary", artist: @artist %>

      <%# A creator under a hidden prefix: the release box, for an admin or the creator themselves (approved claim). %>
      <% entry = (CreatorPrefixes.lookup(@artist.name) rescue nil) %>
      <% if entry && entry.visible_to != "everyone" && CreatorTagRelease.may_set?(CurrentUser.user, @artist.name) %>
        <% release = CreatorTagRelease.find_by(tag_name: @artist.name) %>
        <div class="creator-release-box">
          <% if release&.released %>
            <p><strong>Released.</strong> These posts follow their creator's own settings, not the <%= entry.prefix %> default (<%= entry.visible_to %> only).</p>
          <% else %>
            <p><strong>Hidden by default.</strong> Posts under <%= entry.prefix %> are visible to <%= entry.visible_to %> only. Releasing moves these posts to their creator's own settings -- public, until narrowed.</p>
          <% end %>
          <%= form_tag(update_release_creator_prefixes_path, method: :post) do %>
            <%= hidden_field_tag :tag_name, @artist.name %>
            <%= hidden_field_tag :released, release&.released ? "false" : "true" %>
            <%= submit_tag(release&.released ? "Return to the default" : "Release my posts") %>
          <% end %>
        </div>
      <% end %>

      <% if @artist.tag.present? && @artist.tag.post_count > 0 %>
        <div class="recent-posts">
          <h2 class="recent-posts-header">
            <%= link_to "Posts", posts_path(tags: @artist.name) %>
          </h2>

          <%= render BlacklistComponent.new(user: CurrentUser.user, inline: true) %>

          <%# with_implicit_metatags: the viewer's hidden posts (jailed, deleted, gated, under a hidden creator prefix) stay out, as on the post index. %>
          <%= render_post_gallery(PostQuery.normalize(@artist.name, current_user: CurrentUser.user).with_implicit_metatags.posts_with_timeout(8), tags: @artist.name) %>
        </div>
      <% end %>
    <% end%>
  </div>
</div>
