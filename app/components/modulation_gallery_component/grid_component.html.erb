<%# The grid. Each thumbnail carries the search into the post view.
    data-tag-categories feeds the hover tag panel: name -> category for
    every tag on these cards, and ONLY those -- a tag missing from the map is
    one the client must not display. %>
<div class="modgal-grid" <%= tag.attributes(grid_data) %>>
  <% gallery.posts.each_with_index do |post, index| %>
    <%# A deleted post only reaches this grid when the viewer asked for one
        (show_deleted). It is still veiled: asking to SEE THAT THEY EXIST is
        not asking for a wall of the pictures. There is no reveal here --
        the card is a link, and clicking it opens the post view, which
        offers the reveal on the one image you chose. %>
    <a class="modgal-card<%= " modgal-card--spoiler" if post.is_deleted? %><%= " is-off" if off?(index) %>" href="<%= gallery.post_link(post) %>" title="post #<%= post.id %><%= " (deleted)" if post.is_deleted? %>" <%= tag.attributes(gallery.card_data(post)) %>>
      <% thumb = gallery.thumb_for(post) %>
      <% if thumb %>
        <img class="modgal-thumb" src="<%= thumb %>" alt="" loading="lazy">
      <% else %>
        <span class="modgal-thumb modgal-thumb--gated">gated</span>
      <% end %>
      <span class="modgal-card-id">#<%= post.id %></span>
      <% if (artist = gallery.artist_for(post)) %>
        <span class="modgal-card-artist"><%= artist.tr("_", " ") %></span>
      <% end %>
    </a>
  <% end %>
</div>
