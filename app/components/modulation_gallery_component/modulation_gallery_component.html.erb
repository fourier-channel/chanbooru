<%# view is remembered server-side (ModulationSetting.gallery_view): the
    toggle writes it back on change, so the panel greets the next search the
    way it was left. %>
<section class="modgal" x-data="{ view: '<%= initial_view %>',
  setView(v) { this.view = v; fetch('/modulation/settings', { method: 'PATCH', credentials: 'same-origin', headers: { 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]')?.content, 'Content-Type': 'application/json' }, body: JSON.stringify({ gallery_view: v }) }).catch(() => {}); } }">
  <%# The blacklist control. Upstream puts it in the sidebar, which this gallery
      hides -- so without it here the viewer's blacklist had no controls AND was
      never initialised. Rendered inline so it reads as part of the search
      controls rather than as a transplanted sidebar section. %>
  <%= render BlacklistComponent.new(user: viewer, inline: true) %>

  <%# Primary control: tag search ("sort by via tag search"). %>
  <form class="modgal-search" action="/posts" method="get" role="search">
    <input type="hidden" name="preset" value="modulation">
    <input class="modgal-search-input" type="text" name="tags" value="<%= query_string %>"
           placeholder="tag search  (e.g.  maple  order:score)" autocomplete="off" spellcheck="false"
           data-autocomplete="tag-query" aria-label="Tag search">
    <%# The select shows the REMEMBERED sort (panel memory, server-side) and
        submitting the blank option is the reset -- sort_reset clears the
        memory rather than letting it reapply itself on the next search. %>
    <input type="hidden" name="sort_reset" value="">
    <select class="modgal-sort" name="_sort" aria-label="Sort"
      onchange="const f = this.form; f.tags.value = f.tags.value.replace(/\s*order:\S+/gi, '').trim(); if (this.value) { f.tags.value = (f.tags.value + ' order:' + this.value).trim(); f.sort_reset.value = ''; } else { f.sort_reset.value = '1'; } f.submit();">
      <option value="">default</option>
      <% { "id_desc" => "newest", "id" => "oldest", "score" => "score", "favcount" => "favorites", "created_at" => "date", "random" => "random" }.each do |value, label| %>
        <option value="<%= value %>" <%= "selected" if active_sort == value %>><%= label %></option>
      <% end %>
    </select>
    <button class="modgal-search-go" type="submit">Search</button>
  </form>

  <%# Facet tags for this search, in the post view's colour language -- here the
      grouping dimension is tag category. Unitag = one colour-coded frame;
      Grouped = labelled category sections. %>
  <% if any_tags? %>
    <div class="modgal-tags">
      <div class="modgal-tags-head">
        <span class="modgal-tags-title">In this search</span>
        <div class="mod-view-toggle" role="tablist" aria-label="Tag view">
          <button type="button" role="tab" :aria-selected="view === 'unitag'" :class="{ 'is-active': view === 'unitag' }" @click="setView('unitag')">Unitag</button>
          <button type="button" role="tab" :aria-selected="view === 'grouped'" :class="{ 'is-active': view === 'grouped' }" @click="setView('grouped')">Grouped</button>
        </div>
      </div>

      <div class="mod-unitag" x-show="view === 'unitag'">
        <% unitag_list.each do |tag, key| %>
          <%= link_to posts_path(preset: "modulation", tags: tag.name), class: "mod-pill mod-pill--cat-#{key}", rel: "nofollow" do %>
            <span class="mod-pill-dot" aria-hidden="true"></span><%= tag.name.tr("_", " ") %>
          <% end %>
        <% end %>
      </div>

      <div class="mod-grouped" x-show="view === 'grouped'" x-cloak>
        <% tag_groups.each do |key, tags| %>
          <div class="mod-group mod-group--<%= key %>">
            <span class="mod-group-label"><%= key %></span>
            <div class="mod-group-pills">
              <% tags.each do |tag| %>
                <%= link_to tag.name.tr("_", " "), posts_path(preset: "modulation", tags: tag.name), class: "mod-pill mod-pill--cat-#{key}", rel: "nofollow" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# The subject of the search, when the search has one. Upstream keeps this
      behind a tab on the index; here it sits above the results, because the
      answer to "what am I looking at" should not need a click. %>
  <% if excerpt.present? %>
    <div class="modgal-excerpt modgal-excerpt--<%= excerpt[:kind] %>">
      <div class="modgal-excerpt-head">
        <span class="modgal-excerpt-kind"><%= excerpt[:kind] %></span>
        <%= link_to excerpt[:title], excerpt[:href], class: "modgal-excerpt-title" %>
      </div>
      <% if excerpt_summary.present? %>
        <p class="modgal-excerpt-body"><%= excerpt_summary %></p>
      <% end %>
    </div>
  <% end %>

  <%# Search-scoped navigation. Upstream's sidebar "Options" and "Related"
      sections, minus the global discovery links that made that list a junk
      drawer -- everything here acts on the search you are already in. %>
  <nav class="modgal-related">
    <span class="modgal-related-label">this search</span>
    <% related_links.each do |link| %>
      <%= link_to link[:label], link[:href], class: "modgal-related-link#{" is-active" if link[:active]}", rel: "nofollow" %>
    <% end %>
    <% if can_save_search? %>
      <button type="button" class="modgal-related-link modgal-save" id="save-search">save search</button>
    <% end %>
  </nav>

  <%# The grid. Each thumbnail carries the search into the post view.
      data-tag-categories feeds the hover tag panel: name -> category for
      every tag on this page, and ONLY those -- a tag missing from the map is
      one the client must not display. %>
  <% if posts.any? %>
    <div class="modgal-grid" data-tag-categories="<%= page_tag_categories.to_json %>">
      <% posts.each do |post| %>
        <%# A deleted post only reaches this grid when the viewer asked for one
            (show_deleted). It is still veiled: asking to SEE THAT THEY EXIST is
            not asking for a wall of the pictures. There is no reveal here --
            the card is a link, and clicking it opens the post view, which
            offers the reveal on the one image you chose. %>
        <a class="modgal-card<%= " modgal-card--spoiler" if post.is_deleted? %>" href="<%= post_link(post) %>" title="post #<%= post.id %><%= " (deleted)" if post.is_deleted? %>" <%= tag.attributes(card_data(post)) %>>
          <% thumb = thumb_for(post) %>
          <% if thumb %>
            <img class="modgal-thumb" src="<%= thumb %>" alt="" loading="lazy">
          <% else %>
            <span class="modgal-thumb modgal-thumb--gated">gated</span>
          <% end %>
          <span class="modgal-card-id">#<%= post.id %></span>
          <% if (artist = artist_for(post)) %>
            <span class="modgal-card-artist"><%= artist.tr("_", " ") %></span>
          <% end %>
        </a>
      <% end %>
    </div>
  <% else %>
    <%# Operator ruling 2026-09-04: no joke page, no dead end. The board simply
        clears, and the message says what is true and what to try next. %>
    <p class="modgal-empty">
      No tags exist with that exact combination of characters.
      <span class="modgal-empty-hint">Try gradually shortening your search and checking the recommended tag options.</span>
    </p>
  <% end %>

  <%# The cut-off, explained where it happens. %>
  <% if truncated? %>
    <p class="modgal-capped">
      Showing the most recent <%= posts.size %> of <%= number_with_delimiter(post_count) %>.
      <span class="modgal-capped-note">Search is unlimited; browsing the full archive needs a full account.</span>
    </p>
  <% end %>

  <%# Pagination. %>
  <nav class="modgal-pager">
    <% if current_page > 1 %>
      <%= link_to "&lsaquo; prev".html_safe, page_url(current_page - 1), class: "modgal-page" %>
    <% else %>
      <span class="modgal-page is-disabled">&lsaquo; prev</span>
    <% end %>
    <span class="modgal-page-cur">
      page <%= current_page %><% if total_pages %> / <%= total_pages %><% end %>
      <% if post_count %><span class="modgal-page-count"><%= number_with_delimiter(post_count) %> posts</span><% end %>
    </span>
    <% if more_pages? %>
      <%= link_to "next &rsaquo;".html_safe, page_url(current_page + 1), class: "modgal-page" %>
    <% else %>
      <span class="modgal-page is-disabled">next &rsaquo;</span>
    <% end %>
  </nav>
</section>
