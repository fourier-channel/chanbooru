<div class="modland" data-modland data-config="<%= config.to_json %>">

  <%# --- the showcase ------------------------------------------------- %>
  <% if any_slides? %>
    <section class="modland-showcase" data-region="showcase">
      <%# One elongated pill, segmented. The active segment slides rather than
          just recolouring, so a category change that happens on its own is
          still legible as movement. %>
      <div class="modland-tabs" role="tablist" aria-label="What to show">
        <span class="modland-tabs-thumb" data-region="thumb" aria-hidden="true"></span>
        <% categories.each_with_index do |category, i| %>
          <button type="button" role="tab"
                  class="modland-tab<%= " is-active" if i.zero? %>"
                  data-act="tab" data-cat="<%= category[:key] %>"
                  aria-selected="<%= i.zero? %>"><%= category[:label] %></button>
        <% end %>
      </div>

      <div class="modland-stage" data-region="stage">
        <div class="modland-slides" data-region="slides">
          <% all_slides.each_with_index do |slide, i| %>
            <a class="modland-slide<%= " is-active" if i.zero? %>"
               href="<%= slide[:url] %>"
               data-slide
               data-cat="<%= slide[:category] %>"
               data-id="<%= slide[:id] %>"
               data-tags="<%= slide[:tags] %>"
               data-rating="<%= slide[:rating] %>"
               data-flags="<%= slide[:flags] %>"
               data-score="<%= slide[:score] %>"
               data-uploader-id="<%= slide[:uploader_id] %>"
               <%# Credit travels on the slide so the overlay is rebuilt from
                   whatever is on screen, rather than from a parallel index the
                   two could drift out of. %>
               data-creator="<%= slide.dig(:creator, :name) %>"
               data-platform="<%= slide.dig(:platform, :name) %>"
               data-platform-key="<%= slide.dig(:platform, :key) %>">
              <%# The same image twice: a blurred cover behind, the real one
                  contained in front. A portrait post in a wide stage otherwise
                  sits in a slab of dead surface, and cropping it to fill would
                  cut the subject out of the picture being shown off. %>
              <img class="modland-slide-bg" src="<%= slide[:src] %>" alt="" aria-hidden="true" loading="lazy">
              <img class="modland-slide-img" src="<%= slide[:src] %>" alt="" loading="<%= i.zero? ? "eager" : "lazy" %>">
            </a>
          <% end %>
        </div>

        <%# Arrows sit outside the credit and the resume control, so nothing the
            reader might want to click is ever underneath them. %>
        <button type="button" class="modland-arrow modland-arrow--prev" data-act="prev" aria-label="Previous">&#8249;</button>
        <button type="button" class="modland-arrow modland-arrow--next" data-act="next" aria-label="Next">&#8250;</button>

        <%# Credit. Written as a sentence rather than a pair of labelled fields,
            because it reads as one. The two names are the only coloured things
            in it so the eye lands on them and not on "and posted on". %>
        <p class="modland-credit" data-region="credit"></p>

        <%# The resume control. Only ever present after a manual interaction --
            see the component's JS for why it is not simply always there. %>
        <div class="modland-resume" data-region="resume" hidden>
          <button type="button" class="modland-resume-btn" data-act="resume">
            <span class="modland-resume-fill" data-region="fill" aria-hidden="true"></span>
            <span class="modland-resume-label">The ride never ends.</span>
          </button>
        </div>
      </div>
    </section>
  <% end %>

  <%# --- creator of the month ----------------------------------------- %>
  <% if feature? %>
    <section class="modland-feature">
      <span class="modland-label">Creator of the month</span>
      <div class="modland-feature-body">
        <% thumb = gallery_thumb(feature) %>
        <% if thumb %>
          <%= link_to gallery_link(feature), class: "modland-feature-thumb" do %>
            <img src="<%= thumb %>" alt="" loading="lazy">
          <% end %>
        <% end %>
        <div class="modland-feature-text">
          <%= link_to gallery_title(feature), gallery_link(feature), class: "modland-feature-title" %>
          <p class="modland-feature-handle"><%= feature.contact %></p>
          <% if feature.bio.present? %>
            <p class="modland-feature-bio"><%= truncate(feature.bio, length: 280, separator: " ") %></p>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%# --- promoted creators -------------------------------------------- %>
  <% if promoted? %>
    <section class="modland-promoted">
      <span class="modland-label">Featured creators</span>
      <div class="modland-promoted-row">
        <% promoted.each do |gallery| %>
          <%= link_to gallery_link(gallery), class: "modland-promoted-card" do %>
            <% thumb = gallery_thumb(gallery) %>
            <% if thumb %>
              <img class="modland-promoted-thumb" src="<%= thumb %>" alt="" loading="lazy">
            <% else %>
              <span class="modland-promoted-thumb modland-promoted-thumb--empty"></span>
            <% end %>
            <span class="modland-promoted-name"><%= gallery_title(gallery) %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# --- the way in --------------------------------------------------- %>
  <nav class="modland-enter">
    <%= link_to "Browse the booru", gallery_path, class: "modland-enter-button" %>

    <%= form_with url: landing_preference_path, method: :post, class: "modland-pref" do %>
      <% if gallery_preferred? %>
        <input type="hidden" name="landing" value="landing">
        <button type="submit" class="modland-pref-button">Show this page by default</button>
      <% else %>
        <input type="hidden" name="landing" value="gallery">
        <button type="submit" class="modland-pref-button">Skip this next time</button>
      <% end %>
    <% end %>
  </nav>
</div>
