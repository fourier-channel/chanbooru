<%# The root is not positioned on purpose: in the Modulation header the panel's
    containing block is .modnav-bar, so it can span the bar at phone width.

    Every way of closing the panel is here: a press outside, focus leaving it,
    and Esc. Esc is caught on the root first, where defaultPrevented means
    only "the autocomplete menu took it" -- by the time it reaches the window
    the page's data-shortcut="esc" (NoticeComponent) has prevented every
    Esc, so the window listener takes only an Esc pressed outside the panel.
    Refs are read before an await: an element x-for has removed can no
    longer find its component. %>
<div id="blacklist-box" class="blocklist"
     x-data="{ blacklist: new Danbooru.Blacklist($root), open: false }"
     x-init="blacklist.initialize(<%= blocks.to_json %>, { signedIn: <%= signed_in? %> })"
     x-on:keydown.escape="if (open && !$event.defaultPrevented) { open = false; $refs.trigger.focus(); }"
     x-on:keydown.escape.window="if (open && !$root.contains($event.target)) { open = false; $refs.trigger.focus(); }"
     x-on:pointerdown.window="if (open && !$root.contains($event.target)) open = false"
     x-on:focusout="if (open && $event.relatedTarget && !$root.contains($event.relatedTarget)) open = false">
  <button type="button" id="blocklist-trigger" class="blocklist-trigger" x-ref="trigger" data-shortcut="b"
          aria-haspopup="dialog" aria-controls="blocklist-panel" aria-expanded="false"
          x-bind:aria-expanded="open.toString()"
          aria-label="Blocklist"
          x-bind:aria-label="`Blocklist: ${blacklist.blacklistedPostCount} hidden on this page, ${blacklist.rules.length} blocks`"
          x-on:click="open = !open; if (open) $nextTick(() => $refs.input.focus())">
    <svg class="blocklist-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M6 6l12 12"/></svg>
    <%# The badge's room is always reserved, so a count arriving or leaving
        never moves the rectangle (no-forced-reflow). %>
    <span class="blocklist-count" x-bind:class="blacklist.blacklistedPostCount > 0 && 'is-shown'"
          x-text="blacklist.blacklistedPostCount > 99 ? '99+' : blacklist.blacklistedPostCount"></span>
  </button>

  <%# hidden, not x-show: Alpine shows an x-show element a frame late (after
      the first toggle), so the input could not take focus when the panel
      opened -- measured on the signed-out front page, 2026-10-13. %>
  <div id="blocklist-panel" class="blocklist-panel" role="dialog" aria-label="Your blocklist" hidden x-bind:hidden="!open">
    <div class="blocklist-head">
      <h2 class="blocklist-title">Blocklist</h2>
      <span class="blocklist-hidden" x-text="`${blacklist.blacklistedPostCount} hidden on this page`"></span>
    </div>

    <%# ui-front: jQuery UI attaches the autocomplete menu inside this form, so
        choosing a completion is a press inside the panel and never closes it.
        Members only: autocomplete is not a signed-out door. %>
    <%# Closing the menu on submit also cancels a completion still in flight,
        which would otherwise open over the pills just added. %>
    <form class="blocklist-add ui-front" x-on:submit.prevent="const input = $refs.input; $(input).data('ui-autocomplete')?.close(); blacklist.add(input.value).then((ok) => { if (ok) input.value = '' })">
      <input type="text" x-ref="input" class="blocklist-input" aria-label="Block a tag" placeholder="block a tag"
             autocomplete="off" spellcheck="false" <%= 'data-autocomplete=tag-query' if signed_in? %>>
      <button type="submit" class="blocklist-block">Block</button>
    </form>

    <p class="blocklist-error" role="alert" x-show="blacklist.error" x-text="blacklist.error"></p>

    <ul class="blocklist-pills" x-show="blacklist.rules.length > 0">
      <template x-for="rule in blacklist.rules" x-bind:key="rule.string">
        <li class="blocklist-pill" x-bind:class="rule.locked && 'is-locked'">
          <span class="blocklist-pill-rule" x-text="rule.string" x-bind:title="rule.string"></span>
          <span class="blocklist-pill-count" x-show="rule.matchCount > 0" x-text="rule.matchCount"
                x-bind:title="`${rule.matchCount} hidden on this page`"></span>
          <button type="button" class="blocklist-pill-lock"
                  x-bind:aria-pressed="rule.locked.toString()"
                  x-bind:aria-label="(rule.locked ? 'Unlock ' : 'Lock ') + rule.string"
                  x-bind:title="rule.locked ? 'Locked: unlock it before it can be removed' : 'Lock it, so it cannot be removed by accident'"
                  x-on:click="blacklist.setLocked(rule, !rule.locked)">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="5" y="11" width="14" height="10" rx="2"/>
              <path x-show="rule.locked" d="M8 11V7a4 4 0 0 1 8 0v4"/>
              <path x-show="!rule.locked" d="M8 11V7a4 4 0 0 1 7.6-1.8"/>
            </svg>
          </button>
          <button type="button" class="blocklist-pill-remove" x-show="!rule.locked"
                  x-bind:aria-label="'Unblock ' + rule.string" title="Unblock"
                  x-on:click="const input = $refs.input; blacklist.remove(rule).then(() => input.focus())">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 7l10 10M17 7L7 17"/></svg>
          </button>
        </li>
      </template>
    </ul>

    <p class="blocklist-empty" x-show="blacklist.rules.length === 0">
      Nothing blocked. Type a tag and press Enter. Tags on one line hide only posts that have all of them;
      start a tag with - to exempt it.
    </p>

    <p class="blocklist-foot">
      <% if signed_in? %>
        Kept on your account, on every page.
        <%= link_to "Edit as text", settings_path(anchor: "user_blacklisted_tags") %>
      <% else %>
        Kept in this browser until you purge it. Sign in to keep it on your account.
      <% end %>
    </p>
  </div>
</div>
