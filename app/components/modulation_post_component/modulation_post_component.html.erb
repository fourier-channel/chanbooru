<%# "Modulation" post view. The shell is server-rendered; a small vanilla
    controller renders every region from an embedded JSON payload and navigates
    post-to-post CLIENT-SIDE (fetch the neighbour's payload, animate the swap in
    place, pushState) so there is no jarring full-page reload. Tag buckets come
    from the payload (FourierTagSource.for_viewer), so the creator-privacy gate
    stays server-side -- the client only displays what it is handed. %>
<article class="modulation" id="modulation-root"
  data-payload="<%= payload.to_json %>"
  data-endpoint-base="/posts">

  <header class="mod-meta">
    <div class="mod-meta-fields" data-region="meta"></div>
    <div class="mod-meta-right">
      <div class="mod-sort-switch" title="Change sort (up / down arrows)">
        <button type="button" class="mod-sort-arrow" data-act="sort-up" aria-label="Previous sort">&#9650;</button>
        <span class="mod-sort-label">sort <b data-region="sort-label"></b></span>
        <button type="button" class="mod-sort-arrow" data-act="sort-down" aria-label="Next sort">&#9660;</button>
      </div>
      <span class="mod-gate" data-region="gate" title="Served through the fourier-auth media gate" hidden>R2 gated</span>
    </div>
  </header>

  <section class="mod-notices" data-region="notices" hidden></section>

  <section class="mod-stage" data-region="stage">
    <div class="mod-flank-col mod-flank-col--prev" data-region="flank-prev"></div>
    <div class="mod-stage-center" data-region="center"></div>
    <div class="mod-flank-col mod-flank-col--next" data-region="flank-next"></div>
  </section>

  <nav class="mod-actions" data-region="actions"></nav>

  <section class="mod-tags" data-region="tags"></section>

  <%# Comments were upstream-only. The section is server-rendered on first load
      and swapped from the navigation payload afterwards; CommentSectionComponent
      is upstream's own, so nothing about posting or moderating a comment is
      reimplemented here -- only the frame around it is Modulation's. %>
  <% if comments_enabled? %>
    <section class="mod-comments" id="mod-comments">
      <div class="mod-comments-head">
        <h2 class="mod-comments-title">Comments</h2>
      </div>
      <div class="mod-comments-body" data-region="comments">
        <%= render CommentSectionComponent.new(post: post, current_user: viewer) %>
      </div>
    </section>
  <% end %>

  <script type="application/javascript">
  (function () {
    const root = document.getElementById("modulation-root");
    if (!root || root.dataset.booted) return;
    root.dataset.booted = "1";

    const BASE = root.dataset.endpointBase || "/posts";
    const region = (n) => root.querySelector('[data-region="' + n + '"]');
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    let cur = JSON.parse(root.dataset.payload || "null");
    let activeKey = cur ? cur.active_key : "";
    let view = "unitag", metaOpen = false, busy = false, moreOpen = false;
    const cache = new Map(); // `${id}|${search}` -> payload

    const presets = () => (cur && cur.presets) || [];
    const activeIndex = () => { const i = presets().findIndex(p => p.key === activeKey); return i < 0 ? 0 : i; };
    const active = () => presets()[activeIndex()] || {};

    // ---- rendering (single renderer for initial load AND navigation) ----
    function renderMeta() {
      region("meta").innerHTML = (cur.meta || []).map(f =>
        f.href ? '<span class="mod-meta-field"><a class="mod-link" href="' + esc(f.href) + '" rel="nofollow noreferrer">' + esc(f.text) + "</a></span>"
               : '<span class="mod-meta-field">' + esc(f.text) + "</span>").join("");
      region("gate").hidden = !cur.gated;
      region("sort-label").textContent = active().label || "";
    }
    function mediaHTML(m) {
      if (!m || !m.src) return '<div class="mod-frame mod-image mod-image--placeholder">media gated</div>';
      if (m.kind === "video") return '<div class="mod-frame"><video class="mod-image" src="' + esc(m.src) + '" poster="' + esc(m.poster) + '" controls loop playsinline></video></div>';
      if (m.kind === "other") return '<div class="mod-frame"><a href="' + esc(m.href || "#") + '"><img class="mod-image" src="' + esc(m.src) + '" alt=""></a></div>';
      return '<div class="mod-frame"><img class="mod-image" src="' + esc(m.src) + '" alt="" ' + (m.w ? 'width="' + m.w + '" height="' + m.h + '"' : "") + "></div>";
    }
    function renderCenter() { region("center").innerHTML = mediaHTML(cur.media); }

    function flankRow(p, i, side) {
      const nb = p[side], empty = !nb;
      const inner = (nb && nb.thumb) ? '<img src="' + esc(nb.thumb) + '" alt="" loading="lazy">'
                                     : '<span class="fill">' + (side === "prev" ? "start" : "end") + "</span>";
      return '<a class="mod-sortrow' + (empty ? " is-empty" : "") + '" data-i="' + i + '" data-side="' + side + '" href="' + esc((nb && nb.url) || "#") + '" title="' + esc(p.label) + '">' + inner + '<span class="mod-sortrow-tag">' + esc(p.label) + "</span></a>";
    }
    function renderFlanks() {
      region("flank-prev").innerHTML = presets().map((p, i) => flankRow(p, i, "prev")).join("");
      region("flank-next").innerHTML = presets().map((p, i) => flankRow(p, i, "next")).join("");
      applyRanks();
    }
    function applyRanks() {
      const ai = activeIndex();
      root.querySelectorAll(".mod-sortrow").forEach(el => {
        const i = +el.dataset.i;
        el.style.setProperty("--rank", i - ai);
        el.classList.toggle("is-current", i === ai);
      });
      region("sort-label").textContent = active().label || "";
    }

    const pill = (t, b, dot) => '<a class="mod-pill mod-pill--' + b + '" href="/posts?tags=' + encodeURIComponent(t) + '" rel="nofollow">' + (dot ? '<span class="mod-pill-dot"></span>' : "") + esc(t.replace(/_/g, " ")) + "</a>";
    function renderTags() {
      const t = cur.tags || {}, ORDER = ["creator", "both", "auto", "pending"], L = { creator: "creator", both: "creator + auto", auto: "auto", pending: "pending" };
      const uni = ORDER.flatMap(b => (t[b] || []).map(tag => pill(tag, b, true))).join("");
      const grouped = ORDER.filter(b => (t[b] || []).length).map(b =>
        '<div class="mod-group"><span class="mod-group-label">' + L[b] + '</span><div class="mod-group-pills">' + (t[b] || []).map(tag => pill(tag, b, false)).join("") + "</div></div>").join("");
      const meta = t.meta || [];
      const any = uni.length || meta.length;
      region("tags").innerHTML =
        '<div class="mod-tags-head"><h2 class="mod-tags-title">Tags</h2>' +
          '<div class="mod-view-toggle">' +
            '<button type="button" data-act="view" data-view="unitag" class="' + (view === "unitag" ? "is-active" : "") + '">Unitag</button>' +
            '<button type="button" data-act="view" data-view="grouped" class="' + (view === "grouped" ? "is-active" : "") + '">Grouped</button>' +
          "</div></div>" +
        (any ? "" : '<p class="mod-empty">No tags yet.</p>') +
        '<div class="mod-unitag"' + (view === "unitag" ? "" : " hidden") + ">" + uni + "</div>" +
        '<div class="mod-grouped"' + (view === "grouped" ? "" : " hidden") + ">" + grouped + "</div>" +
        (meta.length ?
          '<div class="mod-meta-section"><button type="button" class="mod-meta-toggle" data-act="meta-toggle" aria-expanded="' + metaOpen + '">' +
            '<span class="mod-meta-caret ' + (metaOpen ? "is-open" : "") + '">&#9656;</span> quality &amp; meta tags <span class="mod-meta-count">' + meta.length + "</span></button>" +
            '<div class="mod-meta-tags"' + (metaOpen ? "" : " hidden") + ">" + meta.map(tag => pill(tag, "meta", false)).join("") + "</div></div>" : "");
    }
    // The notice strip: why a post is in the modqueue, and its family. Both were
    // upstream-only, and the family notices are how you reach a parent or the
    // children at all.
    function renderNotices() {
      const ns = cur.notices || [];
      region("notices").innerHTML = ns.map(n =>
        '<div class="mod-notice mod-notice--' + esc(n.kind) + '">' +
          '<span class="mod-notice-text">' + esc(n.text) + "</span>" +
          (n.href ? '<a class="mod-notice-link" href="' + esc(n.href) + '">' + esc(n.label || "view") + "</a>" : "") +
        "</div>").join("");
      region("notices").hidden = ns.length === 0;
    }

    function moreHTML() {
      const groups = cur.more || [];
      if (!groups.length) return "";
      return '<div class="mod-more"' + (moreOpen ? "" : " hidden") + ">" + groups.map(g =>
        '<div class="mod-more-group"><span class="mod-more-label">' + esc(g.label) + "</span>" +
          (g.links || []).map(l => '<a class="mod-more-link" href="' + esc(l.href) + '">' + esc(l.label) + "</a>").join("") +
        "</div>").join("") + "</div>";
    }

    function voteHTML(dir, glyph) {
      const sc = cur.score || {};
      const on = sc.vote === dir;
      const act = sc.can_vote ? "vote" : "signin";
      return '<button type="button" class="mod-vote mod-vote--' + dir + (on ? " is-on" : "") + '"' +
        ' data-act="' + act + '" data-dir="' + dir + '" aria-pressed="' + (on ? "true" : "false") +
        '" title="' + (sc.can_vote ? (on ? "Remove vote" : (dir === "up" ? "Upvote" : "Downvote")) : "Sign in to vote") + '">' + glyph + "</button>";
    }

    function renderActions() {
      const m = cur.media, full = (m && (m.full || m.src)) || "#";
      const sc = cur.score || {}, fv = cur.fav || {};
      const total = sc.total == null ? 0 : sc.total;
      const favCount = fv.count == null ? 0 : fv.count;
      region("actions").innerHTML =
        '<span class="mod-score">' +
          voteHTML("up", "&#9650;") +
          '<span class="mod-score-num" title="score">' + total + "</span>" +
          voteHTML("down", "&#9660;") +
        "</span>" +
        '<button type="button" class="mod-action mod-fav' + (fv.faved ? " is-on" : "") + '"' +
          ' data-act="' + (fv.can_fav ? "fav" : "signin") + '" title="' + (fv.can_fav ? (fv.faved ? "Remove from favourites" : "Favourite") : "Sign in to favourite") + '">' +
          (fv.faved ? "&#9733;" : "&#9734;") + ' <span class="mod-fav-count">' + favCount + "</span></button>" +
        '<a class="mod-action" href="' + esc(full) + '" target="_blank" rel="noopener">View original</a>' +
        '<a class="mod-action" href="' + esc(full) + '" download>Download</a>' +
        '<button type="button" class="mod-action mod-more-toggle" data-act="more" aria-expanded="' + moreOpen + '">' +
          'More <span class="mod-caret' + (moreOpen ? " is-open" : "") + '">&#9656;</span></button>' +
        moreHTML();
    }
    // Comments arrive as HTML rather than data: they are upstream's own component,
    // and re-implementing comment rendering client-side to avoid one string would
    // mean owning comment markup forever. Danbooru binds its comment handlers on
    // document, so swapped-in markup stays live.
    function renderComments() {
      const el = region("comments");
      if (!el) return;
      if (typeof cur.comments_html === "string") el.innerHTML = cur.comments_html;
    }
    function renderAll() { renderMeta(); renderNotices(); renderCenter(); renderFlanks(); renderTags(); renderActions(); renderComments(); }

    // ---- scoring and favouriting ----
    // Both were upstream-only. They write through the same endpoints the
    // upstream page uses, then re-read the post rather than guessing the new
    // numbers locally -- a score is server state and rate limits, locks and
    // moderation can all make the optimistic answer the wrong one.
    function csrfToken() {
      const el = document.querySelector('meta[name="csrf-token"]');
      return el ? el.getAttribute("content") : "";
    }
    function write(url, method) {
      return fetch(url, {
        method: method,
        headers: { "X-CSRF-Token": csrfToken(), Accept: "application/json" },
        credentials: "same-origin",
      });
    }
    function refreshCurrent() {
      const search = (active() || {}).search || "";
      cache.delete(cur.id + "|" + search);
      return fetchPayload(cur.id, search).then(p => { cur = p; renderActions(); renderMeta(); });
    }
    function vote(dir) {
      const sc = cur.score || {};
      if (!sc.can_vote || busy) return;
      const clearing = sc.vote === dir;
      const url = clearing ? "/post_votes/" + sc.vote_id
                           : "/posts/" + cur.id + "/votes?score=" + (dir === "up" ? 1 : -1);
      write(url, clearing ? "DELETE" : "POST").then(r => { if (r.ok) refreshCurrent(); });
    }
    function toggleFav() {
      const fv = cur.fav || {};
      if (!fv.can_fav || busy) return;
      const url = fv.faved ? "/favorites/" + cur.id : "/favorites?post_id=" + cur.id;
      write(url, fv.faved ? "DELETE" : "POST").then(r => { if (r.ok) refreshCurrent(); });
    }

    // ---- data + preloading ----
    const endpointFor = (id, search) => BASE + "/" + id + "/modulation.json?q=" + encodeURIComponent(search || "");
    function fetchPayload(id, search) {
      const key = id + "|" + (search || "");
      if (cache.has(key)) return Promise.resolve(cache.get(key));
      return fetch(endpointFor(id, search), { headers: { Accept: "application/json" } })
        .then(r => r.ok ? r.json() : Promise.reject(r.status))
        .then(p => { cache.set(key, p); return p; });
    }
    function preloadNeighbours() {
      const a = active(); if (!a) return;
      ["prev", "next"].forEach(side => {
        const nb = a[side]; if (!nb) return;
        fetchPayload(nb.id, a.search).then(p => { if (p.media && p.media.src) { const im = new Image(); im.src = p.media.src; } }).catch(() => {});
      });
    }

    // ---- interactions ----
    function setSort(i) { const ps = presets(); if (!ps.length) return; activeKey = ps[((i % ps.length) + ps.length) % ps.length].key; applyRanks(); preloadNeighbours(); }
    function swapSort(d) { setSort(activeIndex() + d); }
    function selectSort(i) { if (presets()[i]) { activeKey = presets()[i].key; applyRanks(); preloadNeighbours(); } }

    function navigate(side) {
      if (busy) return;
      const a = active(), nb = a && a[side];
      if (!nb) return;
      busy = true;
      fetchPayload(nb.id, a.search).then(p => {
        root.classList.add(side === "next" ? "is-nav-next" : "is-nav-prev"); // shrink centre into slot, neighbour grows in
        setTimeout(() => {
          cur = p;
          activeKey = p.active_key || activeKey;
          root.classList.remove("is-nav-next", "is-nav-prev");
          const enter = side === "next" ? "is-enter-next" : "is-enter-prev";
          root.classList.add(enter);
          renderAll();
          history.pushState({ modId: p.id }, "", p.url);
          requestAnimationFrame(() => requestAnimationFrame(() => { root.classList.remove(enter); busy = false; preloadNeighbours(); }));
        }, 260);
      }).catch(() => { window.location.href = nb.url; }); // network failure: fall back to a real load
    }

    root.addEventListener("click", e => {
      const rowEl = e.target.closest(".mod-sortrow");
      if (rowEl && root.contains(rowEl)) {
        e.preventDefault();
        const i = +rowEl.dataset.i;
        if (i === activeIndex()) navigate(rowEl.dataset.side); else selectSort(i);
        return;
      }
      const act = e.target.closest("[data-act]"); if (!act) return;
      const a = act.dataset.act;
      if (a === "sort-up") swapSort(-1);
      else if (a === "sort-down") swapSort(1);
      else if (a === "view") { view = act.dataset.view; renderTags(); }
      else if (a === "meta-toggle") { metaOpen = !metaOpen; renderTags(); }
      else if (a === "more") { moreOpen = !moreOpen; renderActions(); }
      else if (a === "vote") vote(act.dataset.dir);
      else if (a === "fav") toggleFav();
      else if (a === "signin") window.location.href = "/login?url=" + encodeURIComponent(location.pathname + location.search);
    });

    window.addEventListener("keydown", e => {
      if (e.target.closest("input, textarea, select, [contenteditable]")) return;
      if (e.key === "ArrowLeft") navigate("prev");
      else if (e.key === "ArrowRight") navigate("next");
      else if (e.key === "ArrowUp") { e.preventDefault(); swapSort(-1); }
      else if (e.key === "ArrowDown") { e.preventDefault(); swapSort(1); }
    });

    let tx = null;
    const stage = region("stage");
    stage.addEventListener("touchstart", e => { tx = e.changedTouches[0].clientX; }, { passive: true });
    stage.addEventListener("touchend", e => { if (tx == null) return; const dx = e.changedTouches[0].clientX - tx; tx = null; if (Math.abs(dx) > 45) navigate(dx < 0 ? "next" : "prev"); });

    window.addEventListener("popstate", () => {
      const m = location.pathname.match(/\/posts\/(\d+)/); if (!m) return;
      const search = new URLSearchParams(location.search).get("q") || "";
      fetchPayload(+m[1], search).then(p => { cur = p; activeKey = p.active_key || activeKey; renderAll(); }).catch(() => {});
    });

    history.replaceState({ modId: cur.id }, "", cur.url);
    renderAll();
    preloadNeighbours();
  })();
  </script>
</article>
