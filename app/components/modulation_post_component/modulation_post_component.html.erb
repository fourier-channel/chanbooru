<article class="modulation"
  data-presets="<%= nav_presets.map { |p| p.slice(:key, :label, :prev, :next) }.to_json %>"
  data-active-key="<%= active_preset_key %>"
  x-data="{
    view: 'unitag', metaOpen: false, touchX: null, nav: '', enter: '', presets: [], activeKey: '',
    init() {
      this.presets = JSON.parse(this.$el.dataset.presets || '[]');
      this.activeKey = this.$el.dataset.activeKey || (this.presets[0] && this.presets[0].key) || '';
      // Continue the shared-element motion across the page load: the new centre
      // image grows from the flank slot it was navigated from.
      const dir = sessionStorage.getItem('modNavDir');
      if (dir) { sessionStorage.removeItem('modNavDir'); this.enter = dir; this.$nextTick(() => requestAnimationFrame(() => { this.enter = ''; })); }
    },
    get activeIndex() { const i = this.presets.findIndex(p => p.key === this.activeKey); return i < 0 ? 0 : i; },
    get active() { return this.presets[this.activeIndex] || {}; },
    selectSort(i) { if (this.presets[i]) this.activeKey = this.presets[i].key; },
    swapSort(dir) {
      if (this.presets.length < 2) return;
      this.activeKey = this.presets[(this.activeIndex + dir + this.presets.length) % this.presets.length].key;
    },
    go(which) {
      const t = this.active && this.active[which];
      if (!t || !t.url) return;
      this.nav = which; // centre shrinks into the slot, the neighbour grows to centre
      sessionStorage.setItem('modNavDir', which);
      setTimeout(() => { window.location.href = t.url; }, 260);
    },
    onTouchStart(e) { this.touchX = e.changedTouches[0].clientX; },
    onTouchEnd(e) {
      if (this.touchX === null) return;
      const dx = e.changedTouches[0].clientX - this.touchX; this.touchX = null;
      if (Math.abs(dx) > 45) this.go(dx < 0 ? 'next' : 'prev');
    }
  }"
  :class="{ 'is-nav-prev': nav === 'prev', 'is-nav-next': nav === 'next', 'is-enter-prev': enter === 'prev', 'is-enter-next': enter === 'next' }"
  @keydown.window.arrow-left="go('prev')"
  @keydown.window.arrow-right="go('next')"
  @keydown.window.arrow-up.prevent="swapSort(-1)"
  @keydown.window.arrow-down.prevent="swapSort(1)">

  <%# One-line mono metadata sub-header, above the image, with the sort switch. %>
  <header class="mod-meta">
    <div class="mod-meta-fields">
      <% metadata_fields.each do |field| %>
        <span class="mod-meta-field"><%= field %></span>
      <% end %>
      <% if post.source.present? %>
        <span class="mod-meta-field mod-meta-source">
          <%= link_to_if post.normalized_source.present?, "source", post.normalized_source, rel: "nofollow noreferrer", class: "mod-link" %>
        </span>
      <% end %>
    </div>
    <div class="mod-meta-right">
      <div class="mod-sort-switch" title="Change sort (↑ / ↓)">
        <button type="button" class="mod-sort-arrow" @click="swapSort(-1)" :disabled="presets.length < 2" aria-label="Previous sort">▲</button>
        <span class="mod-sort-label">sort <b x-text="active.label"></b></span>
        <button type="button" class="mod-sort-arrow" @click="swapSort(1)" :disabled="presets.length < 2" aria-label="Next sort">▼</button>
      </div>
      <% if media_gated? %>
        <span class="mod-gate" title="Served through the fourier-auth media gate">R2 gated</span>
      <% end %>
    </div>
  </header>

  <%# Image top-centre; both flanks stack EVERY sort's prev/next. The active
      sort's thumbnail is large and level with the post; the other sorts flank it
      (smaller, offset by rank). ↑/↓ (or tapping another sort) slides the chosen
      sort into the centre spot, swapping places with the former -- the post never
      moves. < / > (and swipe, and tapping the active thumbnail) shrink the post
      into the slot while the neighbour grows to centre. %>
  <section class="mod-stage" @touchstart.passive="onTouchStart($event)" @touchend="onTouchEnd($event)">
    <div class="mod-flank-col mod-flank-col--prev">
      <template x-for="(p, i) in presets" :key="'prev-' + p.key">
        <a class="mod-sortrow"
           :class="{ 'is-current': i === activeIndex, 'is-empty': !p.prev }"
           :style="'--rank:' + (i - activeIndex)"
           :href="(p.prev && p.prev.url) || '#'"
           :title="p.label + (p.prev ? ' · previous' : ' · start of sort')"
           @click.prevent="i === activeIndex ? go('prev') : selectSort(i)">
          <template x-if="p.prev && p.prev.thumb"><img :src="p.prev.thumb" alt="" loading="lazy"></template>
          <span class="mod-sortrow-tag" x-text="p.label"></span>
        </a>
      </template>
    </div>

    <div class="mod-stage-center">
      <%= render MediaAssetComponent.new(media_asset: post.media_asset, current_user: viewer, outer_classes: "mod-frame", inner_classes: "mod-image") %>
    </div>

    <div class="mod-flank-col mod-flank-col--next">
      <template x-for="(p, i) in presets" :key="'next-' + p.key">
        <a class="mod-sortrow"
           :class="{ 'is-current': i === activeIndex, 'is-empty': !p.next }"
           :style="'--rank:' + (i - activeIndex)"
           :href="(p.next && p.next.url) || '#'"
           :title="p.label + (p.next ? ' · next' : ' · end of sort')"
           @click.prevent="i === activeIndex ? go('next') : selectSort(i)">
          <template x-if="p.next && p.next.thumb"><img :src="p.next.thumb" alt="" loading="lazy"></template>
          <span class="mod-sortrow-tag" x-text="p.label"></span>
        </a>
      </template>
    </div>
  </section>

  <%# Compact action row. %>
  <nav class="mod-actions">
    <%= link_to "View original", post.tagged_file_url, class: "mod-action", target: "_blank", rel: "noopener" %>
    <%= link_to "Download", post.tagged_file_url, class: "mod-action", download: "" %>
    <%= link_to (post.favorited_by?(viewer) ? "★ Favorited" : "☆ Favorite"), post_favorites_path(post), method: :post, rel: "nofollow", class: "mod-action mod-fav" %>
  </nav>

  <%# Tags block: unitag (colour-coded) by default, grouped view on toggle. %>
  <section class="mod-tags">
    <div class="mod-tags-head">
      <h2 class="mod-tags-title">Tags</h2>
      <div class="mod-view-toggle" role="tablist" aria-label="Tag view">
        <button type="button" role="tab" :aria-selected="view === 'unitag'" :class="{ 'is-active': view === 'unitag' }" @click="view = 'unitag'">Unitag</button>
        <button type="button" role="tab" :aria-selected="view === 'grouped'" :class="{ 'is-active': view === 'grouped' }" @click="view = 'grouped'">Grouped</button>
      </div>
    </div>

    <% unless any_tags? %>
      <p class="mod-empty">No tags yet.</p>
    <% end %>

    <%# Unitag: one frame, every pill colour-coded by provenance. %>
    <div class="mod-unitag" x-show="view === 'unitag'">
      <% unitag_pills.each do |tag, bucket| %>
        <%= link_to posts_path(tags: tag), class: "mod-pill mod-pill--#{bucket}", rel: "nofollow" do %>
          <span class="mod-pill-dot" aria-hidden="true"></span><%= tag.tr("_", " ") %>
        <% end %>
      <% end %>
    </div>

    <%# Grouped: labelled buckets. %>
    <div class="mod-grouped" x-show="view === 'grouped'" x-cloak>
      <% ModulationPostComponent::BUCKET_ORDER.each do |bucket| %>
        <% tags = buckets[bucket].to_a %>
        <% next if tags.empty? %>
        <div class="mod-group mod-group--<%= bucket %>">
          <span class="mod-group-label"><%= bucket == :both ? "creator + auto" : bucket.to_s %></span>
          <div class="mod-group-pills">
            <% tags.each do |tag| %>
              <%= link_to tag.tr("_", " "), posts_path(tags: tag), class: "mod-pill mod-pill--#{bucket}", rel: "nofollow" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Quality & meta: kept but de-emphasised, behind a collapsible toggle. %>
    <% if meta_tags.any? %>
      <div class="mod-meta-section">
        <button type="button" class="mod-meta-toggle" @click="metaOpen = !metaOpen" :aria-expanded="metaOpen">
          <span class="mod-meta-caret" :class="{ 'is-open': metaOpen }" aria-hidden="true">▸</span>
          quality &amp; meta tags <span class="mod-meta-count"><%= meta_tags.size %></span>
        </button>
        <div class="mod-meta-tags" x-show="metaOpen" x-cloak>
          <% meta_tags.each do |tag| %>
            <%= link_to tag.tr("_", " "), posts_path(tags: tag), class: "mod-pill mod-pill--meta", rel: "nofollow" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</article>
