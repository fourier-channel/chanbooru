<%# "Modulation" post view. The shell is server-rendered; a small vanilla
    controller renders every region from an embedded JSON payload and navigates
    post-to-post CLIENT-SIDE (fetch the neighbour's payload, animate the swap in
    place, pushState) so there is no jarring full-page reload. Tag buckets come
    from the payload (FourierTagSource.for_viewer), so the creator-privacy gate
    stays server-side -- the client only displays what it is handed. %>
<article class="modulation" id="modulation-root"
  data-payload="<%= payload.to_json %>"
  data-endpoint-base="/posts">

  <%# The blocklist control and its engine live in the header
      (BlocklistComponent), one per page; the stage below carries the marks. %>

  <header class="mod-meta">
    <div class="mod-meta-fields" data-region="meta"></div>
    <div class="mod-meta-right">
      <div class="mod-sort-switch" title="Change mode (up / down arrows). Every mode is a filter over the same chronological axis; random is the one that changes the axis.">
        <button type="button" class="mod-sort-arrow" data-act="sort-up" aria-label="Previous mode">&#9650;</button>
        <span class="mod-sort-label">mode <b data-region="sort-label"></b></span>
        <button type="button" class="mod-sort-arrow" data-act="sort-down" aria-label="Next mode">&#9660;</button>
      </div>
      <%# Random's history control. Random keeps a trail of what it showed
          (RandomTrail); this forgets it and reseeds both directions. Only on
          the random mode, because it means nothing on the others. %>
      <button type="button" class="mod-random-clear" data-act="random-clear" data-region="random-clear" hidden
              title="Random remembers the posts it showed you, so walking back retraces your steps. Clear that trail and reseed both directions.">Clear 'Random' History <span class="mod-random-count" data-region="random-count"></span></button>
      <span class="mod-gate" data-region="gate" title="Served through the fourier-auth media gate" hidden>R2 gated</span>
    </div>
  </header>

  <section class="mod-notices" data-region="notices" hidden></section>

  <section class="mod-stage" data-region="stage">
    <div class="mod-flank-col mod-flank-col--prev" data-region="flank-prev"></div>
    <%# The blacklist attaches HERE, not to the article: its default hide method
        is display:none, and this page's root IS the page -- blacklisting a post
        would blank it entirely, where upstream hides only the image and leaves
        the tags, comments and controls in place. This element is also stable
        across client-side navigation (only its contents are replaced), so the
        Post object the blacklist attaches to it survives a swap. %>
    <div class="mod-stage-center mod-blacklist-target" data-region="center" <%= tag.attributes(blacklist_data) %>></div>
    <div class="mod-flank-col mod-flank-col--next" data-region="flank-next"></div>
    <%# The flank candidates, as elements the blocklist engine can see and
        mark: filled by the script below from the payload, never shown. The
        status line says what a press against a blocked side did, for the
        keyboard, the wheel, a swipe, and the phone layout without flanks. %>
    <div class="mod-flank-pool" data-region="flank-pool" hidden></div>
    <div class="mod-flank-status" data-region="flank-status" role="status" aria-live="polite"></div>
  </section>

  <nav class="mod-actions" data-region="actions"></nav>

  <section class="mod-tags" data-region="tags"></section>

  <%# Generation data: the prompt, settings and workflow the tunnel took out of
      this image (operator ruling 2026-09-28). The payload carries it only for
      the post's creator (ModulationPostComponent#generation_payload,
      FourierCreatorPrivacy), so for everyone else -- admins included -- this
      region stays empty and hidden. %>
  <section class="mod-generation" data-region="generation" hidden></section>

  <%# Comments were upstream-only. The section is server-rendered on first load
      and swapped from the navigation payload afterwards; CommentSectionComponent
      is upstream's own, so nothing about posting or moderating a comment is
      reimplemented here -- only the frame around it is Modulation's. %>
  <% if comments_enabled? %>
    <section class="mod-comments" id="mod-comments">
      <div class="mod-comments-head">
        <h2 class="mod-comments-title">Comments</h2>
      </div>
      <div class="mod-comments-body" data-region="comments">
        <%= render CommentSectionComponent.new(post: post, current_user: viewer) %>
      </div>
    </section>
  <% end %>

  <script type="application/javascript">
  (function () {
    const root = document.getElementById("modulation-root");
    if (!root || root.dataset.booted) return;
    root.dataset.booted = "1";

    const BASE = root.dataset.endpointBase || "/posts";
    // A link OFF this site opens in a new tab. Inside Technetium this page is
    // an iframe, so a same-tab link to a source like 4chan navigates the FRAME
    // to a site that refuses to be framed -- the panel just goes blank, which
    // is what "the direct links don't work" looked like (operator, 2026-09-07).
    // Nothing we can set here makes a third party frameable, so the answer is
    // to leave the frame instead of breaking it.
    const outward = (h) => {
      try { return new URL(h, location.href).origin === location.origin ? "" : ' target="_blank"'; }
      catch (e) { return ""; }
    };

    const region = (n) => root.querySelector('[data-region="' + n + '"]');
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    let cur = JSON.parse(root.dataset.payload || "null");
    let activeKey = cur ? cur.active_key : "";
    let view = "unitag", metaOpen = false, busy = false, moreOpen = false;
    // View state held server-side (ModulationSetting): seeded from the payload
    // once, then this session's copy is authoritative -- navigation payloads
    // carry settings too but must not clobber a toggle made mid-session.
    let tagsExpanded = !!((cur && cur.settings) || {}).tags_expanded;
    let imageCap = ((cur && cur.settings) || {}).image_cap || "fit";
    // Reset on navigation, deliberately: revealing one deleted post is not
    // consent to see the next one.
    let revealed = false;

    const presets = () => (cur && cur.presets) || [];
    const activeIndex = () => { const i = presets().findIndex(p => p.key === activeKey); return i < 0 ? 0 : i; };
    const active = () => presets()[activeIndex()] || {};

    // ---- rendering (single renderer for initial load AND navigation) ----
    function renderMeta() {
      // The sort switch is browsing machinery: with no presets to move between
      // it is a control that does nothing, so it goes away entirely rather than
      // sitting there disabled.
      const sortEl = root.querySelector(".mod-sort-switch");
      if (sortEl) sortEl.hidden = !(cur.presets && cur.presets.length);

      region("meta").innerHTML = (cur.meta || []).map(f =>
        f.href ? '<span class="mod-meta-field"><a class="mod-link" href="' + esc(f.href) + '"' + outward(f.href) + ' rel="nofollow noreferrer">' + esc(f.text) + "</a></span>"
               : '<span class="mod-meta-field">' + esc(f.text) + "</span>").join("");
      region("gate").hidden = !cur.gated;
      region("sort-label").textContent = active().label || "";
    }
    function mediaHTML(m) {
      if (!m || !m.src) return '<div class="mod-frame mod-image mod-image--placeholder">media gated</div>';
      if (m.kind === "video") return '<div class="mod-frame"><video class="mod-image" src="' + esc(m.src) + '" poster="' + esc(m.poster) + '" controls loop playsinline></video></div>';
      if (m.kind === "other") return '<div class="mod-frame"><a href="' + esc(m.href || "#") + '"><img class="mod-image" src="' + esc(m.src) + '" alt=""></a></div>';
      return '<div class="mod-frame"><img class="mod-image" src="' + esc(m.src) + '" alt="" ' + (m.w ? 'width="' + m.w + '" height="' + m.h + '"' : "") + "></div>";
    }
    // A deleted post's image is greyed and blurred until asked for. Reaching a
    // deleted post is a moderation act -- checking what was removed, or why --
    // and it should not put the picture on screen as a side effect of arriving.
    // The bytes are already here: this is a viewing decision, not a gate, and
    // it is deliberately one click to undo.
    //
    // The wrapper carries the blur, not the <img>: filtering the image itself
    // leaves its own edges sharp against the frame, and a blur that stops at
    // the subject's outline still shows you the subject.
    function spoilerHTML(inner) {
      return '<div class="mod-spoiler" data-act="reveal" role="button" tabindex="0"' +
        ' aria-label="Reveal the image of this deleted post">' +
        '<div class="mod-spoiler-veil">' + inner + "</div>" +
        '<span class="mod-spoiler-label">deleted \u2014 click to reveal</span></div>';
    }
    function renderCenter() {
      const html = mediaHTML(cur.media);
      const spoil = cur.status === "deleted" && cur.media && cur.media.src && !revealed;
      region("center").innerHTML = spoil ? spoilerHTML(html) : html;
    }

    // The terminus glyph for an empty cap: the trail's line stopping at a
    // filled dot, pointing off the edge the trail came from.
    const CAP_GLYPH = {
      prev: '<circle cx="12" cy="6" r="3" fill="currentColor" stroke="none"></circle><path d="M12 9.4 V21"></path>',
      next: '<path d="M12 3 V14.6"></path><circle cx="12" cy="18" r="3" fill="currentColor" stroke="none"></circle>',
      // The blocklist's own circle-with-slash (BlocklistComponent's trigger).
      blocked: '<circle cx="12" cy="12" r="8.5"></circle><path d="M6 6l12 12"></path>',
    };
    function capHTML(glyph, label) {
      return '<span class="mod-trailcap"><svg viewBox="0 0 24 24" aria-hidden="true">' + CAP_GLYPH[glyph] + "</svg>" +
        '<span class="mod-trailcap-label">' + esc(label) + "</span></span>";
    }

    // ---- the flanks: candidates, the pool, the pick ----
    // THE BLOCKLIST IS CLIENT-SIDE ON PURPOSE (operator, 2026-10-13,
    // 2026-10-17): a block added or lifted re-filters the page in place. The
    // flank thumbnails carried no tags, so the engine never saw them and a
    // blocked post sat beside the centre. Now each side of each mode is a list
    // of candidates, nearest first (presets[].prev_candidates /
    // next_candidates), their attributes in cur.candidates. Every distinct
    // candidate is written into the hidden pool as an element the engine
    // matches (.mod-flank-poolitem in Blacklist.POST_SELECTOR) and marks; the
    // thumbnail AND the arrow's destination are the first candidate not
    // marked (window.FourierFlanks.flankState). The engine is the one matcher.
    //
    // Nothing is drawn until the engine has applied once: it starts at
    // DOM-ready, after this script's first render, and drawing before its
    // marks exist would paint the blocked thumbnail -- the bug. Every later
    // apply (a block added or lifted, another tab's list, a rescan) redraws
    // from the marks, with no fetch: the payloads do not depend on the list.
    //
    // ALL CANDIDATES BLOCKED, more beyond: the page LOOKS FURTHER through the
    // same modulation.json route, asking the last candidate's payload for the
    // same search (equality on `search`, not `key`: the creator mode's search
    // follows the anchor's own artist). HOP_CAP automatic looks per side per
    // post, then the tile says it stopped and the next press looks again.
    const HOP_CAP = 4;
    // engineApplied: the engine's first apply has happened. flankFault: why the
    // flanks cannot be drawn, if they cannot. swapping: the 260ms navigation
    // swap, which redraws at its end. flankFor: what the extensions belong to,
    // the post and its runs (FourierFlanks.runsKey) -- not the payload object,
    // which a vote's re-read replaces with an identical one. ext: "search|side"
    // -> { list, more, hops, looking, failed, dead }, what looking further
    // found; extCandidates: their entries by id. flankStates: "key|side" -> the
    // drawn state, which navigate() obeys. poolEls: the pool's elements, by
    // candidate id and attributes. statusSide: the side the status line is
    // about, while it is up (tellStatus).
    let engineApplied = false, flankFault = "", swapping = false, flankFor = null;
    let ext = new Map(), extCandidates = {}, flankStates = {}, poolEls = new Map();
    let statusSide = "", statusTimer = null;
    const candidateOf = (id) => ((cur && cur.candidates) || {})[id] || extCandidates[id] || null;
    const blacklistEngine = () => { const box = document.querySelector("#blacklist-box"); return box && box.blacklist; };

    // One side's run: the payload's candidates plus whatever looking further
    // found. The payload's lists are never edited in place -- the nav cache
    // hands the same object back on a return visit.
    function runFor(p, side) {
      const key = p.search + "|" + side;
      if (!ext.has(key)) ext.set(key, { list: [], more: null, hops: 0, looking: false, failed: "", dead: false });
      const e = ext.get(key);
      return {
        ext: e,
        list: (p[side + "_candidates"] || []).concat(e.list),
        more: e.more === null ? Boolean(p[side + "_more"]) : e.more,
      };
    }

    function applyBlacklistAttrs(el, bl) {
      Object.keys(bl).forEach(k => el.setAttribute(k, bl[k] == null ? "" : bl[k]));
    }

    // Bring the pool in line with every run of every mode, touching only what
    // changed: one element per distinct candidate, keyed by its id AND its
    // attributes (a re-read can bring new tags). Returns { added, removed },
    // or null when nothing changed. The engine is told only the difference
    // (Blacklist#adopt): a rescan rebuilds and re-matches every post on the
    // page against every block, and a navigation changes the pool every time
    // -- at 1000 blocks that was 65-150 ms on the frame the swap animates.
    function syncFlankPool() {
      const pool = region("flank-pool");
      if (!pool) return null;
      const want = new Map();
      presets().forEach(p => ["prev", "next"].forEach(side => runFor(p, side).list.forEach(c => {
        const bl = (candidateOf(c.id) || {}).blacklist;
        if (bl) want.set(c.id + ":" + JSON.stringify(bl), bl);
      })));
      const removed = [...poolEls.keys()].filter(sig => !want.has(sig)).map(sig => {
        const el = poolEls.get(sig);
        poolEls.delete(sig);
        el.remove();
        return el;
      });
      const added = [...want.keys()].filter(sig => !poolEls.has(sig)).map(sig => {
        const el = document.createElement("span");
        el.className = "mod-flank-poolitem";
        applyBlacklistAttrs(el, want.get(sig));
        poolEls.set(sig, el);
        pool.append(el);
        return el;
      });
      return (added.length || removed.length) ? { added, removed } : null;
    }

    // The state a side is drawn in, which is also where its arrow goes.
    function sideState(p, side, marked) {
      if (!engineApplied) return { kind: "fault", why: flankFault };
      if (p.unavailable) return { kind: "unavailable" };
      const r = runFor(p, side);
      const list = r.list.filter(c => candidateOf(c.id));
      const st = window.FourierFlanks.flankState(list, r.more, marked, HOP_CAP - r.ext.hops);
      if (st.kind === "pick") { st.ref = list[st.index]; return st; }
      // A look further that failed matters only while nothing is allowed: a
      // block lifted afterwards brings the pick back.
      if (r.ext.failed) return { kind: "failed", why: r.ext.failed };
      if (st.kind === "blocked-more") {
        st.looking = r.ext.looking;
        // Nothing to look further from (the server tops a side up past posts
        // this account may not open, but only so far), or a look that came
        // back with nothing new: past here is not this account's to walk.
        if (!list.length || r.ext.dead) return { kind: "no-access" };
      }
      return st;
    }

    function flankRow(p, i, side) {
      const st = flankStates[p.key + "|" + side] || { kind: "fault" };
      const open = (cls, href, title, inner) => '<a class="mod-sortrow' + cls + '" data-i="' + i + '" data-side="' + side + '" href="' + esc(href) + '" title="' + esc(title) + '">' + inner + '<span class="mod-sortrow-tag">' + esc(p.label) + "</span></a>";
      if (st.kind === "pick") {
        const c = candidateOf(st.ref.id) || {};
        // A deleted (or jailed) neighbour is blurred, as the gallery grid
        // blurs it; the reveal belongs to the centre, one image at a time.
        const spoiler = c.deleted ? " is-spoiler" : "";
        const skipped = st.skipped ? " -- " + st.skipped + " blocked " + (st.skipped === 1 ? "post" : "posts") + " skipped" : "";
        const inner = c.thumb ? '<img src="' + esc(c.thumb) + '" alt="" loading="lazy">' : capHTML(side, side === "prev" ? "start" : "end");
        return open(spoiler, st.ref.url || "#", p.label + skipped + (spoiler ? " (deleted)" : ""), inner);
      }
      if (st.kind === "end") return open(" is-empty", "#", p.label + " -- " + (side === "prev" ? "start of trail" : "end of trail"), capHTML(side, side === "prev" ? "start" : "end"));
      // Only the active mode looks further; another mode's blocked side says
      // so until it is chosen.
      const waiting = st.kind === "blocked-more" && !st.looking && st.canHop && i !== activeIndex();
      const label = st.kind === "blocked-more" && (st.looking || st.canHop) && !waiting ? "looking"
        : (st.kind === "blocked-end" || st.kind === "blocked-more") ? "blocked"
          : st.kind === "no-access" ? "hidden" : "error";
      const words = waiting ? st.blocked + " blocked so far; choose this mode to look further." : window.FourierFlanks.flankWords(st, side);
      return open(" is-blocked", "#", p.label + " -- " + words, capHTML("blocked", label));
    }

    // Draw every mode's flanks from the marks. Called on every engine apply;
    // never calls rescan() itself, or it would answer its own event forever.
    function drawFlanks() {
      if (!root.isConnected) return;
      if (swapping) return; // the swap's own renderAll redraws
      if (engineApplied || flankFault) {
        const marked = new Set(Array.from(root.querySelectorAll(".mod-flank-poolitem.blacklisted-active"), el => el.dataset.id));
        flankStates = {};
        presets().forEach(p => ["prev", "next"].forEach(side => { flankStates[p.key + "|" + side] = sideState(p, side, marked); }));
        region("flank-prev").innerHTML = presets().map((p, i) => flankRow(p, i, "prev")).join("");
        region("flank-next").innerHTML = presets().map((p, i) => flankRow(p, i, "next")).join("");
        if (statusSide) showStatus();
      }
      applyRanks();
      if (engineApplied) preloadNeighbours();
    }
    function renderFlanks() {
      const key = window.FourierFlanks.runsKey(cur);
      if (flankFor !== key) { flankFor = key; ext = new Map(); extCandidates = {}; }
      const change = syncFlankPool();
      const engine = blacklistEngine();
      if (change && engine) engine.adopt(change.added, change.removed); // its announce draws
      else drawFlanks();
    }

    // Look further along one side: the last candidate's payload, same search.
    function lookFurther(p, side) {
      const r = runFor(p, side);
      const list = r.list.filter(c => candidateOf(c.id));
      const anchor = list[list.length - 1];
      if (r.ext.looking || r.ext.failed || r.ext.dead || !anchor) return;
      const forKey = flankFor, selfId = cur.id;
      r.ext.looking = true;
      r.ext.hops += 1;
      drawFlanks();
      fetchPayload(anchor.id, p.search).then(q => {
        const match = (q.presets || []).find(x => x.search === p.search);
        if (!match) throw new Error("no " + p.label + " mode in post #" + anchor.id + "'s answer");
        const found = window.FourierFlanks.extendRun(r.list, selfId, match, side);
        r.ext.list = r.ext.list.concat(found.added);
        r.ext.more = found.more;
        r.ext.dead = found.dead;
        Object.assign(extCandidates, q.candidates || {});
      }).catch(why => {
        r.ext.failed = typeof why === "number" ? "HTTP " + why : String((why && why.message) || why);
        console.error("post view: could not look further " + side + " in mode " + p.label + " from post #" + anchor.id + " (" + r.ext.failed + ") -- the tile says so; reload the page to retry");
      }).finally(() => {
        r.ext.looking = false;
        if (flankFor === forKey) renderFlanks();
      });
    }

    // The one message a keyboard, wheel or swipe press against a wall gets --
    // and the only one at phone width, where the flank columns are hidden. It
    // follows the side it was asked about: every draw rewrites it from that
    // side's state (a look further finishing, a block lifted), and takes it
    // down once the side has a pick again, as a navigation or a mode change
    // does. Otherwise it stays STATUS_MS from the last press: long enough to
    // read its fix.
    const STATUS_MS = 8000;
    function tellStatus(side) {
      statusSide = side;
      clearTimeout(statusTimer);
      statusTimer = setTimeout(hideStatus, STATUS_MS);
      showStatus();
    }
    function showStatus() {
      const el = region("flank-status"), st = flankStates[active().key + "|" + statusSide];
      const words = st ? window.FourierFlanks.flankWords(st, statusSide) : "";
      if (!el || !words) { hideStatus(); return; }
      el.textContent = words;
      el.classList.add("is-shown");
    }
    function hideStatus() {
      statusSide = "";
      clearTimeout(statusTimer);
      const el = region("flank-status");
      if (el) el.classList.remove("is-shown");
    }
    // The clear-history control shows only on random, with the trail's size.
    function renderRandomClear() {
      const el = region("random-clear"); if (!el) return;
      const a = active();
      const on = !!a && a.key === "random";
      el.hidden = !on;
      const n = on && a.history != null ? a.history : 0;
      const cnt = region("random-count"); if (cnt) cnt.textContent = n ? String(n) : "";
    }
    function applyRanks() {
      renderRandomClear();
      const ai = activeIndex();
      root.querySelectorAll(".mod-sortrow").forEach(el => {
        const i = +el.dataset.i;
        el.style.setProperty("--rank", i - ai);
        el.classList.toggle("is-current", i === ai);
      });
      region("sort-label").textContent = active().label || "";
    }

    // Tags worth being pleased about: the list and the spin are
    // modulation_hype.js, shared with /posts (window.FourierHype).
    const hypeOf = (t) => (window.FourierHype && window.FourierHype.isHype(t) ? " mod-pill--hype" : "");
    // ALPHABETICAL within every bucket (operator ruling 2026-09-19). The payload
    // arrives in tag-string order, which is whatever order the taggers and the
    // editors happened to write things in, and a list a reader cannot predict
    // is a list they have to read end to end to know a tag is absent.
    const alpha = (list) => (list || []).slice().sort((a, b) => String(a).localeCompare(String(b)));
    // THE LAMP (operator ruling 2026-09-20): the dot says which MODEL put the
    // tag here. spectrum orange, hydra green, both a swirl, a person white.
    // The payload's top-level `lamp` buckets come from FourierTagSource#lamp;
    // they sit BESIDE `tags`, not inside it -- a tag in
    // none of them (an artist pill's creator lamp, an unsourced tag) keeps
    // the dot the stylesheet gives it.
    //
    // READ AT RENDER, NOT AT LOAD. This page navigates post-to-post without a
    // reload: `cur` is REASSIGNED to the next payload and the regions
    // re-render. The first cut of this built the map once, at script init, so
    // every post after the first was painted with the FIRST post's lamps --
    // and a hard refresh "fixed" it only by making some other post the first
    // one. liveSet() below is the same value read the same way, and is the
    // shape this should have had. Memoised on the payload OBJECT so a pill()
    // call is still O(1); the nav cache hands back the same object for a post
    // already visited, which is exactly when the map is still valid.
    // THE TAG POOL IS EDITED IN PLACE (operator ruling 2026-09-20: "a pool of
    // objects instead of a rendered page, so the tag-editing experience is
    // identical across surfaces"). Editing is a mode on the panel, not a
    // separate page: each pill grows a remove control and an input takes
    // additions. The grammar -- what a typed line means, what an edit does to
    // a tag string, which edits are refused and in what words -- is formant's
    // and is shared byte-for-byte with Technetium (window.FourierTagEdit,
    // hydrated from docs/design/formant/tagedit.js). Only the chrome is ours.
    // editDraft survives the re-render a refusal causes. Without it the typed
    // line is wiped by the innerHTML that shows the error explaining why it
    // was not accepted, which is the one moment the text is worth keeping.
    let editing = false, editBusy = false, editError = "", editDraft = "", editFocus = false;
    const tagEdit = () => window.FourierTagEdit || null;
    let lampCache = null, lampCacheFor = null;
    const lampMap = () => {
      if (lampCacheFor === cur) return lampCache;
      const out = {}, buckets = (cur && cur.lamp) || {};
      ["both", "hydra", "spectrum", "manual"].forEach(l => (buckets[l] || []).forEach(tag => { if (!(tag in out)) out[tag] = l; }));
      lampCacheFor = cur;
      lampCache = out;
      return out;
    };
    const lampClass = (t) => { const m = lampMap(); return m[t] ? " mod-pill-dot--" + m[t] : ""; };
    // THE REVIEW QUARANTINE'S QUICK SWITCH (TagQuarantine, operator rulings
    // 2026-10-12). cur.quarantine is present for an admin alone: a flagged
    // pill carries a marker whether or not the panel is in edit mode, and in
    // edit mode each pill grows a lock beside its remove control that flags
    // the tag for review, or releases a flagged one, through PATCH
    // /tags/:id.json -- the tag's own route, the same verbs as its edit page.
    const flaggedSet = () => new Set(((cur && cur.quarantine) || {}).flagged || []);
    // tag_links: null = every pill links; else only the named ones do, and
    // the rest are labels (a signed-out viewer's search would 404).
    const linksTo = (t) => !(cur && cur.tag_links) || cur.tag_links.includes(t);
    const pillAnchor = (t, b, dot, extra) => { const el = linksTo(t) ? "a" : "span"; return '<' + el + ' class="mod-pill mod-pill--' + b + (extra ? " " + extra : "") + (flaggedSet().has(t) ? " mod-pill--flagged" : "") + hypeOf(t) + '" data-tag="' + esc(t) + '"' + (el === "a" ? ' href="/posts?tags=' + encodeURIComponent(t) + '" rel="nofollow"' : "") + '>' + (dot ? '<span class="mod-pill-dot' + lampClass(t) + '"></span>' : "") + esc(t.replace(/_/g, " ")) + "</" + el + ">"; };
    const lockButton = (t) => {
      const q = cur && cur.quarantine;
      if (!q || !(q.tag_ids || {})[t]) return "";
      const on = flaggedSet().has(t);
      const words = on ? "release " + t + " from review" : "flag " + t + " for review";
      return '<button type="button" class="mod-tagrow-lock' + (on ? " is-on" : "") + '" data-act="tag-flag" data-tag="' + esc(t) +
        '" title="' + esc(words) + '" aria-label="' + esc(words) + '" aria-pressed="' + on + '">&#x1F512;</button>';
    };
    // The remove control is a SIBLING of the anchor, never inside it: a button
    // nested in an <a> is invalid, and the browsers that tolerate it disagree
    // about which one a click hit. Technetium's panel is built the same way.
    const pill = (t, b, dot, extra) => editing
      ? '<span class="mod-tagrow">' + pillAnchor(t, b, dot, extra) + lockButton(t) +
        '<button type="button" class="mod-tagrow-x" data-act="tag-remove" data-tag="' + esc(t) +
        '" title="remove ' + esc(t) + '" aria-label="remove ' + esc(t) + '">&#215;</button></span>'
      : pillAnchor(t, b, dot, extra);
    // THE CREATOR'S LAMP. An artist pill's dot is a lamp, lit while that
    // creator is active -- a post of theirs, direct or attributed through
    // sample or the tunnel, inside the server's window (payload.live_window
    // seconds). The payload says who is live at render; applyLamps() is also
    // what the poll below calls, so a lamp changes in place without the tag
    // panel re-rendering under the pointer.
    const liveSet = () => new Set(cur.live_creators || []);
    const lampTitle = (on) => on
      ? "active: posted within the last " + Math.round((cur.live_window || 300) / 60) + " min"
      : "no post in the last " + Math.round((cur.live_window || 300) / 60) + " min";
    function applyLamps() {
      const live = liveSet();
      root.querySelectorAll(".mod-pill--cat-artist").forEach(el => {
        const on = live.has(el.dataset.tag);
        el.classList.toggle("is-live", on);
        el.title = lampTitle(on);
      });
    }
    // The re-read: a fraction of the window, only while the page is visible
    // and only when there is an artist tag to ask about, plus once on every
    // return to the tab. A lamp lit at render and never re-read would stay
    // lit for as long as the page was left open, which is a lamp that lies.
    function lampTick() {
      const names = ((cur.cat_tags || {}).artist || []).slice(0, 20);
      if (!names.length || document.hidden) return;
      fetch("/modulation/creator_activity?tags=" + encodeURIComponent(names.join(",")), { headers: { Accept: "application/json" }, credentials: "same-origin" })
        .then(r => (r.ok ? r.json() : null))
        .then(d => { if (d && Array.isArray(d.active)) { cur.live_creators = d.active; if (d.window) cur.live_window = d.window; applyLamps(); } })
        .catch(() => {});
    }
    setInterval(lampTick, Math.max(15000, Math.round(((cur.live_window || 300) * 1000) / 5)));
    document.addEventListener("visibilitychange", () => { if (!document.hidden) lampTick(); });
    // The category bucket at the head of the list: artist on the left;
    // character / copyright (/ species, should the booru ever grow one) on the
    // right. Each pill still carries the class of the provenance bucket it came
    // from AND now the category it was filed under, because those are two
    // different questions and the answer to one was standing in for the other:
    // an artist tag rendered ORANGE because the autotagger supplied it, which
    // is the axis collision canon forbids ("provenance and category must not
    // borrow each other's colours"). Category paints the pill; provenance keeps
    // the dot. See mod-pill--cat-* in the stylesheet.
    // A claimed original character names its creator: "by NAME" BESIDE the
    // pill, never inside its anchor (an <a> in an <a> is invalid), a link
    // only when the server gave one (payload.oc_owners: a signed-out viewer
    // gets one only to a gallery they can open).
    const ocOwner = (tag) => {
      const o = (cur.oc_owners || {})[tag];
      if (!o) return "";
      const words = "by " + esc(o.name);
      return o.href ? '<a class="mod-oc-owner" href="' + esc(o.href) + '">' + words + "</a>" : '<span class="mod-oc-owner">' + words + "</span>";
    };
    function catBucketHTML(t, cats) {
      const bucketOf = {};
      ["creator", "both", "auto", "pending", "unsourced", "meta"].forEach(b =>
        (t[b] || []).forEach(tag => { if (!(tag in bucketOf)) bucketOf[tag] = b; }));
      const catPill = (tag, k) => {
        const p = pill(tag, bucketOf[tag] || "unsourced", true, "mod-pill--cat mod-pill--cat-" + k);
        const owner = k === "character" ? ocOwner(tag) : "";
        return owner ? '<span class="mod-oc">' + p + owner + "</span>" : p;
      };
      const cell = (keys) => keys.filter(k => (cats[k] || []).length).map(k =>
        '<div class="mod-cat-group"><span class="mod-cat-label">' + esc(k) + '</span><div class="mod-cat-pills">' +
          alpha(cats[k]).map(tag => catPill(tag, k)).join("") + "</div></div>").join("");
      const left = cell(["artist"]), right = cell(["character", "copyright", "species"]);
      if (!left && !right) return "";
