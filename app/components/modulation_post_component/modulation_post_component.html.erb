<%# "Modulation" post view. The shell is server-rendered; a small vanilla
    controller renders every region from an embedded JSON payload and navigates
    post-to-post CLIENT-SIDE (fetch the neighbour's payload, animate the swap in
    place, pushState) so there is no jarring full-page reload. Tag buckets come
    from the payload (FourierTagSource.for_viewer), so the creator-privacy gate
    stays server-side -- the client only displays what it is handed. %>
<article class="modulation" id="modulation-root"
  data-payload="<%= payload.to_json %>"
  data-endpoint-base="/posts">

  <%# The blacklist control. This view hides the upstream sidebar it normally
      lives in, which left the blacklist with no controls and -- because the
      rules are initialised by this component -- never applied at all. %>
  <%= render BlacklistComponent.new(user: viewer, inline: true) %>

  <header class="mod-meta">
    <div class="mod-meta-fields" data-region="meta"></div>
    <div class="mod-meta-right">
      <div class="mod-sort-switch" title="Change mode (up / down arrows). Every mode is a filter over the same chronological axis; random is the one that changes the axis.">
        <button type="button" class="mod-sort-arrow" data-act="sort-up" aria-label="Previous mode">&#9650;</button>
        <span class="mod-sort-label">mode <b data-region="sort-label"></b></span>
        <button type="button" class="mod-sort-arrow" data-act="sort-down" aria-label="Next mode">&#9660;</button>
      </div>
      <%# Random's history control. Random keeps a trail of what it showed
          (RandomTrail); this forgets it and reseeds both directions. Only on
          the random mode, because it means nothing on the others. %>
      <button type="button" class="mod-random-clear" data-act="random-clear" data-region="random-clear" hidden
              title="Random remembers the posts it showed you, so walking back retraces your steps. Clear that trail and reseed both directions.">Clear 'Random' History <span class="mod-random-count" data-region="random-count"></span></button>
      <span class="mod-gate" data-region="gate" title="Served through the fourier-auth media gate" hidden>R2 gated</span>
    </div>
  </header>

  <section class="mod-notices" data-region="notices" hidden></section>

  <section class="mod-stage" data-region="stage">
    <div class="mod-flank-col mod-flank-col--prev" data-region="flank-prev"></div>
    <%# The blacklist attaches HERE, not to the article: its default hide method
        is display:none, and this page's root IS the page -- blacklisting a post
        would blank it entirely, where upstream hides only the image and leaves
        the tags, comments and controls in place. This element is also stable
        across client-side navigation (only its contents are replaced), so the
        Post object the blacklist attaches to it survives a swap. %>
    <div class="mod-stage-center mod-blacklist-target" data-region="center" <%= tag.attributes(blacklist_data) %>></div>
    <div class="mod-flank-col mod-flank-col--next" data-region="flank-next"></div>
  </section>

  <nav class="mod-actions" data-region="actions"></nav>

  <section class="mod-tags" data-region="tags"></section>

  <%# Comments were upstream-only. The section is server-rendered on first load
      and swapped from the navigation payload afterwards; CommentSectionComponent
      is upstream's own, so nothing about posting or moderating a comment is
      reimplemented here -- only the frame around it is Modulation's. %>
  <% if comments_enabled? %>
    <section class="mod-comments" id="mod-comments">
      <div class="mod-comments-head">
        <h2 class="mod-comments-title">Comments</h2>
      </div>
      <div class="mod-comments-body" data-region="comments">
        <%= render CommentSectionComponent.new(post: post, current_user: viewer) %>
      </div>
    </section>
  <% end %>

  <script type="application/javascript">
  (function () {
    const root = document.getElementById("modulation-root");
    if (!root || root.dataset.booted) return;
    root.dataset.booted = "1";

    const BASE = root.dataset.endpointBase || "/posts";
    // A link OFF this site opens in a new tab. Inside Technetium this page is
    // an iframe, so a same-tab link to a source like 4chan navigates the FRAME
    // to a site that refuses to be framed -- the panel just goes blank, which
    // is what "the direct links don't work" looked like (operator, 2026-09-07).
    // Nothing we can set here makes a third party frameable, so the answer is
    // to leave the frame instead of breaking it.
    const outward = (h) => {
      try { return new URL(h, location.href).origin === location.origin ? "" : ' target="_blank"'; }
      catch (e) { return ""; }
    };

    const region = (n) => root.querySelector('[data-region="' + n + '"]');
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    let cur = JSON.parse(root.dataset.payload || "null");
    let activeKey = cur ? cur.active_key : "";
    let view = "unitag", metaOpen = false, busy = false, moreOpen = false;
    // View state held server-side (ModulationSetting): seeded from the payload
    // once, then this session's copy is authoritative -- navigation payloads
    // carry settings too but must not clobber a toggle made mid-session.
    let tagsExpanded = !!((cur && cur.settings) || {}).tags_expanded;
    let imageCap = ((cur && cur.settings) || {}).image_cap || "fit";
    // Reset on navigation, deliberately: revealing one deleted post is not
    // consent to see the next one.
    let revealed = false;
    const cache = new Map(); // `${id}|${search}` -> payload

    const presets = () => (cur && cur.presets) || [];
    const activeIndex = () => { const i = presets().findIndex(p => p.key === activeKey); return i < 0 ? 0 : i; };
    const active = () => presets()[activeIndex()] || {};

    // ---- rendering (single renderer for initial load AND navigation) ----
    function renderMeta() {
      // The sort switch is browsing machinery: with no presets to move between
      // it is a control that does nothing, so it goes away entirely rather than
      // sitting there disabled.
      const sortEl = root.querySelector(".mod-sort-switch");
      if (sortEl) sortEl.hidden = !(cur.presets && cur.presets.length);

      region("meta").innerHTML = (cur.meta || []).map(f =>
        f.href ? '<span class="mod-meta-field"><a class="mod-link" href="' + esc(f.href) + '"' + outward(f.href) + ' rel="nofollow noreferrer">' + esc(f.text) + "</a></span>"
               : '<span class="mod-meta-field">' + esc(f.text) + "</span>").join("");
      region("gate").hidden = !cur.gated;
      region("sort-label").textContent = active().label || "";
    }
    function mediaHTML(m) {
      if (!m || !m.src) return '<div class="mod-frame mod-image mod-image--placeholder">media gated</div>';
      if (m.kind === "video") return '<div class="mod-frame"><video class="mod-image" src="' + esc(m.src) + '" poster="' + esc(m.poster) + '" controls loop playsinline></video></div>';
      if (m.kind === "other") return '<div class="mod-frame"><a href="' + esc(m.href || "#") + '"><img class="mod-image" src="' + esc(m.src) + '" alt=""></a></div>';
      return '<div class="mod-frame"><img class="mod-image" src="' + esc(m.src) + '" alt="" ' + (m.w ? 'width="' + m.w + '" height="' + m.h + '"' : "") + "></div>";
    }
    // A deleted post's image is greyed and blurred until asked for. Reaching a
    // deleted post is a moderation act -- checking what was removed, or why --
    // and it should not put the picture on screen as a side effect of arriving.
    // The bytes are already here: this is a viewing decision, not a gate, and
    // it is deliberately one click to undo.
    //
    // The wrapper carries the blur, not the <img>: filtering the image itself
    // leaves its own edges sharp against the frame, and a blur that stops at
    // the subject's outline still shows you the subject.
    function spoilerHTML(inner) {
      return '<div class="mod-spoiler" data-act="reveal" role="button" tabindex="0"' +
        ' aria-label="Reveal the image of this deleted post">' +
        '<div class="mod-spoiler-veil">' + inner + "</div>" +
        '<span class="mod-spoiler-label">deleted \u2014 click to reveal</span></div>';
    }
    function renderCenter() {
      const html = mediaHTML(cur.media);
      const spoil = cur.status === "deleted" && cur.media && cur.media.src && !revealed;
      region("center").innerHTML = spoil ? spoilerHTML(html) : html;
    }

    // The terminus glyph for an empty cap: the trail's line stopping at a
    // filled dot, pointing off the edge the trail came from.
    function trailCapHTML(side) {
      const glyph = side === "prev"
        ? '<circle cx="12" cy="6" r="3" fill="currentColor" stroke="none"></circle><path d="M12 9.4 V21"></path>'
        : '<path d="M12 3 V14.6"></path><circle cx="12" cy="18" r="3" fill="currentColor" stroke="none"></circle>';
      const label = side === "prev" ? "start" : "end";
      return '<span class="mod-trailcap"><svg viewBox="0 0 24 24" aria-hidden="true">' + glyph + "</svg>" +
        '<span class="mod-trailcap-label">' + label + "</span></span>";
    }
    function flankRow(p, i, side) {
      const nb = p[side], empty = !nb;
      const inner = (nb && nb.thumb) ? '<img src="' + esc(nb.thumb) + '" alt="" loading="lazy">'
                                     : trailCapHTML(side);
      const title = empty ? p.label + " -- " + (side === "prev" ? "start of trail" : "end of trail") : p.label;
      return '<a class="mod-sortrow' + (empty ? " is-empty" : "") + '" data-i="' + i + '" data-side="' + side + '" href="' + esc((nb && nb.url) || "#") + '" title="' + esc(title) + '">' + inner + '<span class="mod-sortrow-tag">' + esc(p.label) + "</span></a>";
    }
    function renderFlanks() {
      region("flank-prev").innerHTML = presets().map((p, i) => flankRow(p, i, "prev")).join("");
      region("flank-next").innerHTML = presets().map((p, i) => flankRow(p, i, "next")).join("");
      applyRanks();
    }
    // The clear-history control shows only on random, with the trail's size.
    function renderRandomClear() {
      const el = region("random-clear"); if (!el) return;
      const a = active();
      const on = !!a && a.key === "random";
      el.hidden = !on;
      const n = on && a.history != null ? a.history : 0;
      const cnt = region("random-count"); if (cnt) cnt.textContent = n ? String(n) : "";
    }
    function applyRanks() {
      renderRandomClear();
      const ai = activeIndex();
      root.querySelectorAll(".mod-sortrow").forEach(el => {
        const i = +el.dataset.i;
        el.style.setProperty("--rank", i - ai);
        el.classList.toggle("is-current", i === ai);
      });
      region("sort-label").textContent = active().label || "";
    }

    // Tags worth being pleased about. The MOTION is canon (formant
    // mod-hype-*), so this list is the only local decision -- which names wear
    // it -- and it is the same list Technetium keeps, so a tag behaves
    // identically wherever it is read.
    const HYPE = new Set(["butthole"]);
    const hypeOf = (t) => (HYPE.has(String(t).trim().toLowerCase()) ? " mod-pill--hype" : "");
    // ALPHABETICAL within every bucket (operator ruling 2026-09-19). The payload
    // arrives in tag-string order, which is whatever order the taggers and the
    // editors happened to write things in, and a list a reader cannot predict
    // is a list they have to read end to end to know a tag is absent.
    const alpha = (list) => (list || []).slice().sort((a, b) => String(a).localeCompare(String(b)));
    // THE LAMP (operator ruling 2026-09-20): the dot says which MODEL put the
    // tag here. spectrum orange, hydra green, both a swirl, a person white.
    // The payload's top-level `lamp` buckets come from FourierTagSource#lamp;
    // they sit BESIDE `tags`, not inside it -- a tag in
    // none of them (an artist pill's creator lamp, an unsourced tag) keeps
    // the dot the stylesheet gives it.
    //
    // READ AT RENDER, NOT AT LOAD. This page navigates post-to-post without a
    // reload: `cur` is REASSIGNED to the next payload and the regions
    // re-render. The first cut of this built the map once, at script init, so
    // every post after the first was painted with the FIRST post's lamps --
    // and a hard refresh "fixed" it only by making some other post the first
    // one. liveSet() below is the same value read the same way, and is the
    // shape this should have had. Memoised on the payload OBJECT so a pill()
    // call is still O(1); the nav cache hands back the same object for a post
    // already visited, which is exactly when the map is still valid.
    // THE TAG POOL IS EDITED IN PLACE (operator ruling 2026-09-20: "a pool of
    // objects instead of a rendered page, so the tag-editing experience is
    // identical across surfaces"). Editing is a mode on the panel, not a
    // separate page: each pill grows a remove control and an input takes
    // additions. The grammar -- what a typed line means, what an edit does to
    // a tag string, which edits are refused and in what words -- is formant's
    // and is shared byte-for-byte with Technetium (window.FourierTagEdit,
    // hydrated from docs/design/formant/tagedit.js). Only the chrome is ours.
    // editDraft survives the re-render a refusal causes. Without it the typed
    // line is wiped by the innerHTML that shows the error explaining why it
    // was not accepted, which is the one moment the text is worth keeping.
    let editing = false, editBusy = false, editError = "", editDraft = "", editFocus = false;
    const tagEdit = () => window.FourierTagEdit || null;
    let lampCache = null, lampCacheFor = null;
    const lampMap = () => {
      if (lampCacheFor === cur) return lampCache;
      const out = {}, buckets = (cur && cur.lamp) || {};
      ["both", "hydra", "spectrum", "manual"].forEach(l => (buckets[l] || []).forEach(tag => { if (!(tag in out)) out[tag] = l; }));
      lampCacheFor = cur;
      lampCache = out;
      return out;
    };
    const lampClass = (t) => { const m = lampMap(); return m[t] ? " mod-pill-dot--" + m[t] : ""; };
    const pillAnchor = (t, b, dot, extra) => '<a class="mod-pill mod-pill--' + b + (extra ? " " + extra : "") + hypeOf(t) + '" data-tag="' + esc(t) + '" href="/posts?tags=' + encodeURIComponent(t) + '" rel="nofollow">' + (dot ? '<span class="mod-pill-dot' + lampClass(t) + '"></span>' : "") + esc(t.replace(/_/g, " ")) + "</a>";
    // The remove control is a SIBLING of the anchor, never inside it: a button
    // nested in an <a> is invalid, and the browsers that tolerate it disagree
    // about which one a click hit. Technetium's panel is built the same way.
    const pill = (t, b, dot, extra) => editing
      ? '<span class="mod-tagrow">' + pillAnchor(t, b, dot, extra) +
        '<button type="button" class="mod-tagrow-x" data-act="tag-remove" data-tag="' + esc(t) +
        '" title="remove ' + esc(t) + '" aria-label="remove ' + esc(t) + '">&#215;</button></span>'
      : pillAnchor(t, b, dot, extra);
    // THE CREATOR'S LAMP. An artist pill's dot is a lamp, lit while that
    // creator is active -- a post of theirs, direct or attributed through
    // sample or the tunnel, inside the server's window (payload.live_window
    // seconds). The payload says who is live at render; applyLamps() is also
    // what the poll below calls, so a lamp changes in place without the tag
    // panel re-rendering under the pointer.
    const liveSet = () => new Set(cur.live_creators || []);
    const lampTitle = (on) => on
      ? "active: posted within the last " + Math.round((cur.live_window || 300) / 60) + " min"
      : "no post in the last " + Math.round((cur.live_window || 300) / 60) + " min";
    function applyLamps() {
      const live = liveSet();
      root.querySelectorAll(".mod-pill--cat-artist").forEach(el => {
        const on = live.has(el.dataset.tag);
        el.classList.toggle("is-live", on);
        el.title = lampTitle(on);
      });
    }
    // The re-read: a fraction of the window, only while the page is visible
    // and only when there is an artist tag to ask about, plus once on every
    // return to the tab. A lamp lit at render and never re-read would stay
    // lit for as long as the page was left open, which is a lamp that lies.
    function lampTick() {
      const names = ((cur.cat_tags || {}).artist || []).slice(0, 20);
      if (!names.length || document.hidden) return;
      fetch("/modulation/creator_activity?tags=" + encodeURIComponent(names.join(",")), { headers: { Accept: "application/json" }, credentials: "same-origin" })
        .then(r => (r.ok ? r.json() : null))
        .then(d => { if (d && Array.isArray(d.active)) { cur.live_creators = d.active; if (d.window) cur.live_window = d.window; applyLamps(); } })
        .catch(() => {});
    }
    setInterval(lampTick, Math.max(15000, Math.round(((cur.live_window || 300) * 1000) / 5)));
    document.addEventListener("visibilitychange", () => { if (!document.hidden) lampTick(); });
    // The category bucket at the head of the list: artist on the left;
    // character / copyright (/ species, should the booru ever grow one) on the
    // right. Each pill still carries the class of the provenance bucket it came
    // from AND now the category it was filed under, because those are two
    // different questions and the answer to one was standing in for the other:
    // an artist tag rendered ORANGE because the autotagger supplied it, which
    // is the axis collision canon forbids ("provenance and category must not
    // borrow each other's colours"). Category paints the pill; provenance keeps
    // the dot. See mod-pill--cat-* in the stylesheet.
    function catBucketHTML(t, cats) {
      const bucketOf = {};
      ["creator", "both", "auto", "pending", "unsourced", "meta"].forEach(b =>
        (t[b] || []).forEach(tag => { if (!(tag in bucketOf)) bucketOf[tag] = b; }));
      const cell = (keys) => keys.filter(k => (cats[k] || []).length).map(k =>
        '<div class="mod-cat-group"><span class="mod-cat-label">' + esc(k) + '</span><div class="mod-cat-pills">' +
          alpha(cats[k]).map(tag => pill(tag, bucketOf[tag] || "unsourced", true, "mod-pill--cat mod-pill--cat-" + k)).join("") + "</div></div>").join("");
      const left = cell(["artist"]), right = cell(["character", "copyright", "species"]);
      if (!left && !right) return "";
      return '<div class="mod-cats"><div class="mod-cats-cell mod-cats-cell--left">' + left + '</div><div class="mod-cats-cell mod-cats-cell--right">' + right + "</div></div>";
    }
    function renderTags() {
      const t = cur.tags || {}, ORDER = ["creator", "both", "auto", "pending", "unsourced"],
        L = { creator: "creator", both: "creator + auto", auto: "auto", pending: "pending", unsourced: "no recorded source" };
      const cats = cur.cat_tags || {};
      const catSet = new Set([].concat(...Object.values(cats)));
      const catsHTML = catBucketHTML(t, cats);
      const el = region("tags");
      el.classList.toggle("is-collapsed", !tagsExpanded);
      // The head renders in both states; the view toggle only means anything
      // with the full list on screen. Collapsed, the category shelf IS the
      // preview and everything else stays out of the panel entirely.
      const toggle = '<button type="button" class="mod-tags-toggle" data-act="tags-toggle" aria-expanded="' + tagsExpanded + '">' +
        '<span class="mod-meta-caret' + (tagsExpanded ? " is-open" : "") + '">&#9656;</span> ' + (tagsExpanded ? "collapse" : "expand") + "</button>";
      const head = '<div class="mod-tags-head"><h2 class="mod-tags-title">Tags</h2><div class="mod-tags-controls">' +
        (tagsExpanded ?
          '<div class="mod-view-toggle">' +
            '<button type="button" data-act="view" data-view="unitag" class="' + (view === "unitag" ? "is-active" : "") + '">Unitag</button>' +
            '<button type="button" data-act="view" data-view="grouped" class="' + (view === "grouped" ? "is-active" : "") + '">Grouped</button>' +
          "</div>" : "") +
        (tagsExpanded && cur.can_edit ?
          '<button type="button" class="mod-tags-edit' + (editing ? " is-active" : "") + '" data-act="tags-edit" aria-pressed="' + editing + '">' +
            (editing ? "Done" : "Edit tags") + "</button>" : "") +
        toggle + "</div></div>";
      // The add row and the error line render together, below the pills, so a
      // refusal names the edit that was refused without moving anything.
      const editor = (tagsExpanded && cur.can_edit && editing) ?
        '<div class="mod-tagedit">' +
          '<input class="mod-tagedit-input" type="text" data-region="tagedit-input" ' +
            'placeholder="add tags, space separated" autocomplete="off" spellcheck="false" ' +
            'value="' + esc(editDraft) + '"' + (editBusy ? " disabled" : "") + ">" +
          '<button type="button" class="mod-tagedit-add" data-act="tag-add"' + (editBusy ? " disabled" : "") + ">Add</button>" +
        "</div>" +
        (editError ? '<p class="mod-tagedit-error">' + esc(editError) + "</p>" : "") : "";
      if (!tagsExpanded) { el.innerHTML = head + catsHTML; applyLamps(); return; }
      const flow = (b) => alpha(t[b]).filter(tag => !catSet.has(tag));
      // ONE alphabetical list, not five sorted lists end to end. The first cut
      // sorted within each provenance bucket and then concatenated them in
      // ORDER, so a tag in the last bucket sat after every tag of the first --
      // "butthole" landed after the general tags and before meta, and nobody
      // could tell whether it was the end of one group or the start of
      // another (operator, 2026-09-19). Unitag is the view that HIDES the
      // buckets; the pill's class still carries them for the colour.
      const uni = alpha(ORDER.flatMap(b => flow(b).map(tag => ({ tag, b }))).map(e => e.tag))
        .map(tag => pill(tag, ORDER.find(b => flow(b).includes(tag)), true)).join("");
      const grouped = ORDER.filter(b => flow(b).length).map(b =>
        '<div class="mod-group"><span class="mod-group-label">' + L[b] + '</span><div class="mod-group-pills">' + flow(b).map(tag => pill(tag, b, false)).join("") + "</div></div>").join("");
      const meta = flow("meta");
      const any = uni.length || meta.length || catsHTML.length;
      el.innerHTML =
        head +
        (any ? "" : '<p class="mod-empty">No tags yet.</p>') +
        catsHTML +
        '<div class="mod-unitag"' + (view === "unitag" ? "" : " hidden") + ">" + uni + "</div>" +
        '<div class="mod-grouped"' + (view === "grouped" ? "" : " hidden") + ">" + grouped + "</div>" +
        (meta.length ?
          '<div class="mod-meta-section"><button type="button" class="mod-meta-toggle" data-act="meta-toggle" aria-expanded="' + metaOpen + '">' +
            '<span class="mod-meta-caret ' + (metaOpen ? "is-open" : "") + '">&#9656;</span> quality &amp; meta tags <span class="mod-meta-count">' + meta.length + "</span></button>" +
            '<div class="mod-meta-tags"' + (metaOpen ? "" : " hidden") + ">" + meta.map(tag => pill(tag, "meta", false)).join("") + "</div></div>" : "") +
        editor;
      applyLamps();
      // Only an edit action asks for the caret back. Re-rendering for a view
      // toggle must not pull focus out from under the pointer.
      if (editFocus) {
        editFocus = false;
        const inp = region("tagedit-input");
        if (inp && !inp.disabled) { inp.focus({ preventScroll: true }); inp.setSelectionRange(inp.value.length, inp.value.length); }
      }
    }
    // The notice strip: why a post is in the modqueue, and its family. Both were
    // upstream-only, and the family notices are how you reach a parent or the
    // children at all.
    function renderNotices() {
      const ns = cur.notices || [];
      region("notices").innerHTML = ns.map(n =>
        '<div class="mod-notice mod-notice--' + esc(n.kind) + '">' +
          '<span class="mod-notice-text">' + esc(n.text) + "</span>" +
          (n.href ? '<a class="mod-notice-link" href="' + esc(n.href) + '"' + outward(n.href) + ' rel="noopener">' + esc(n.label || "view") + "</a>" : "") +
        "</div>").join("");
      region("notices").hidden = ns.length === 0;
    }

    // The image-size setting lives with the other long-tail controls. Client-
    // built rather than server-sent because it writes client state first and
    // persists second -- the buttons must reflect imageCap immediately.
    function capBtn(cap, label) {
      return '<button type="button" class="mod-more-link mod-capbtn' + (imageCap === cap ? " is-active" : "") + '" data-act="image-cap" data-cap="' + cap + '">' + label + "</button>";
    }
    function moreHTML() {
      const groups = cur.more || [];
      const viewGroup = '<div class="mod-more-group"><span class="mod-more-label">image size</span>' +
        capBtn("fit", "fit page") + capBtn("screen", "fill screen") + capBtn("none", "natural") + "</div>";
      return '<div class="mod-more"' + (moreOpen ? "" : " hidden") + ">" + groups.map(g =>
        '<div class="mod-more-group"><span class="mod-more-label">' + esc(g.label) + "</span>" +
          (g.links || []).map(l => '<a class="mod-more-link" href="' + esc(l.href) + '"' +
            (l.local ? ' data-act="local-anchor"' : outward(l.href) + ' rel="noopener"') + ">" + esc(l.label) + "</a>").join("") +
        "</div>").join("") + viewGroup + "</div>";
    }

    function voteHTML(dir, glyph) {
      const sc = cur.score || {};
      const on = sc.vote === dir;
      const act = sc.can_vote ? "vote" : "signin";
      return '<button type="button" class="mod-vote mod-vote--' + dir + (on ? " is-on" : "") + '"' +
        ' data-act="' + act + '" data-dir="' + dir + '" aria-pressed="' + (on ? "true" : "false") +
        '" title="' + (sc.can_vote ? (on ? "Remove vote" : (dir === "up" ? "Upvote" : "Downvote")) : "Sign in to vote") + '">' + glyph + "</button>";
    }

    // THE MODERATION PILL: ( jail | delete ), for an approver. Lit means
    // true, desaturated means false. jailed implies deleted, so delete is
    // inert while jail is lit and lights with it; jail can go out on its own
    // and leaves the post deleted (operator, 2026-09-19). The server enforces
    // the rule; this only draws it and asks.
    function moderationHTML() {
      const m = cur.moderation;
      if (!m || !m.can) return "";
      const seg = (key, on, label, disabled, title) =>
        '<button type="button" class="mod-modpill-seg mod-modpill-seg--' + key + (on ? " is-lit" : "") + '" data-act="moderate" data-key="' + key + '" data-on="' + (on ? 1 : 0) + '"' +
          (disabled ? " disabled" : "") + ' title="' + esc(title) + '" aria-pressed="' + on + '">' + label + "</button>";
      return '<span class="mod-modpill" role="group" aria-label="Moderation">' +
        seg("jail", m.jailed, "jail", false, m.jailed ? "Unjail (the post stays deleted)" : "Jail (deletes the post too)") +
        seg("deleted", m.deleted, "delete", m.jailed, m.jailed ? "A jailed post stays deleted; unjail first" : (m.deleted ? "Undelete (approves the post)" : "Delete (recoverable)")) +
        "</span>";
    }
    function moderate(btn) {
      const key = btn.dataset.key, want = btn.dataset.on !== "1";
      const pill = btn.closest(".mod-modpill"); if (!pill || pill.classList.contains("is-busy")) return;
      pill.classList.add("is-busy");
      const body = {}; body[key] = want;
      fetch("/modulation/posts/" + cur.id + "/moderation", {
        method: "PATCH",
        headers: { "X-CSRF-Token": csrfToken(), "Content-Type": "application/json", Accept: "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(body),
      }).then(r => r.json().catch(() => ({})).then(d => ({ ok: r.ok, d })))
        .then(({ ok, d }) => {
          if (d && typeof d.jailed === "boolean") cur.moderation = { can: true, jailed: d.jailed, deleted: d.deleted };
          // The whole page re-reads the post: status line, notice strip, the
          // spoiler over a deleted picture, and the pill itself.
          return refreshCurrent().then(() => { revealed = false; renderNotices(); renderCenter(); renderBlacklist(); })
            .then(() => { if (!ok) flashPill(d && d.refused ? d.refused : "refused"); });
        })
        .catch(() => flashPill("network error"))
        .finally(() => { const p2 = root.querySelector(".mod-modpill"); if (p2) p2.classList.remove("is-busy"); });
    }
    function flashPill(msg) {
      const p = root.querySelector(".mod-modpill"); if (!p) return;
      p.setAttribute("data-refused", msg); p.classList.add("is-refused");
      setTimeout(() => { p.classList.remove("is-refused"); p.removeAttribute("data-refused"); }, 2600);
    }
    function renderActions() {
      const m = cur.media, full = (m && (m.full || m.src)) || "#";
      const sc = cur.score || {}, fv = cur.fav || {};
      const total = sc.total == null ? 0 : sc.total;
      const favCount = fv.count == null ? 0 : fv.count;
      region("actions").innerHTML =
        '<span class="mod-score">' +
          voteHTML("up", "&#9650;") +
          '<span class="mod-score-num" title="score">' + total + "</span>" +
          voteHTML("down", "&#9660;") +
        "</span>" +
        '<button type="button" class="mod-action mod-fav' + (fv.faved ? " is-on" : "") + '"' +
          ' data-act="' + (fv.can_fav ? "fav" : "signin") + '" title="' + (fv.can_fav ? (fv.faved ? "Remove from favourites" : "Favourite") : "Sign in to favourite") + '">' +
          (fv.faved ? "&#9733;" : "&#9734;") + ' <span class="mod-fav-count">' + favCount + "</span></button>" +
        '<a class="mod-action" href="' + esc(full) + '" target="_blank" rel="noopener">View original</a>' +
        '<a class="mod-action" href="' + esc(full) + '" download>Download</a>' +
        moderationHTML() +
        '<button type="button" class="mod-action mod-more-toggle" data-act="more" aria-expanded="' + moreOpen + '">' +
          'More <span class="mod-caret' + (moreOpen ? " is-open" : "") + '">&#9656;</span></button>' +
        moreHTML();
    }
    // Comments arrive as HTML rather than data: they are upstream's own component,
    // and re-implementing comment rendering client-side to avoid one string would
    // mean owning comment markup forever. Danbooru binds its comment handlers on
    // document, so swapped-in markup stays live.
    function renderComments() {
      const el = region("comments");
      if (!el) return;
      if (typeof cur.comments_html === "string") el.innerHTML = cur.comments_html;
    }
    // Client-side navigation swaps the post under a root element the blacklist
    // has already claimed, so the attributes it matches on have to travel with
    // it -- and the rules have to be re-run afterwards, or the viewer sees the
    // next post judged by the previous one's tags.
    function renderBlacklist() {
      const bl = cur.blacklist, el = region("center");
      if (!bl || !el) return;
      Object.keys(bl).forEach(k => el.setAttribute(k, bl[k] == null ? "" : bl[k]));
      if (el.post) { el.post.applyRules(); el.post.update(); }
    }
    function renderAll() { renderMeta(); renderNotices(); renderCenter(); renderFlanks(); renderTags(); renderActions(); renderComments(); renderBlacklist(); sizeStage(); }

    // ---- image sizing (the image_cap setting) ----
    // "Fill the page to the exact point the collapsed Tags panel is visible."
    // Measured, not guessed: the cap is the viewport minus everything that has
    // to share it. The tags panel counts at its COLLAPSED height (head +
    // category shelf -- both render in either state) whichever state it is
    // actually in, so expanding the panel never resizes the image.
    function sizeStage() {
      root.style.removeProperty("--mod-stage-max");
      if (imageCap === "none") return;
      const stage = region("stage");
      if (!stage) return;
      const h = (el) => (el ? el.getBoundingClientRect().height : 0);
      const gap = 16, breathing = 12;
      let reserve = breathing;
      if (imageCap === "fit") {
        const tagsEl = region("tags");
        const collapsedTags = h(tagsEl && tagsEl.querySelector(".mod-tags-head")) +
          h(tagsEl && tagsEl.querySelector(".mod-cats")) + 34; // panel padding + border
        reserve += h(region("actions")) + collapsedTags + gap * 2;
      }
      const top = stage.getBoundingClientRect().top + window.scrollY;
      const max = window.innerHeight - top - reserve;
      if (max > 160) root.style.setProperty("--mod-stage-max", Math.round(max) + "px");
      // Second pass against the real layout: once the cap has applied, any
      // residue between the collapsed panel's bottom edge and the viewport
      // comes off the cap -- "the exact point" is measured, not summed. Only
      // ever shrinks, so it cannot oscillate; skipped while expanded because
      // the expanded bottom edge is not the edge the cap is defined against.
      if (imageCap === "fit" && !tagsExpanded) {
        const tagsEl = region("tags");
        requestAnimationFrame(() => {
          const current = parseInt(root.style.getPropertyValue("--mod-stage-max"), 10);
          if (!current || !tagsEl) return;
          const overflow = Math.ceil(tagsEl.getBoundingClientRect().bottom + window.scrollY + breathing - window.innerHeight);
          if (overflow > 0 && current - overflow > 160) root.style.setProperty("--mod-stage-max", (current - overflow) + "px");
        });
      }
    }
    let sizeTimer = null;
    window.addEventListener("resize", () => { clearTimeout(sizeTimer); sizeTimer = setTimeout(sizeStage, 120); });

    // ---- fullscreen viewer ----
    // Click the image -> a fullscreen popover: drag anywhere to pan, wheel to
    // zoom (about the cursor), Esc to close. The instruction line is part of
    // the surface by operator request -- the affordances are invisible
    // otherwise. Save Image is a download anchor. The `download` attribute
    // alone is not enough: the same-origin gate URL 302s to a cross-origin
    // presigned R2 URL, and browsers drop `download` across origins, so the
    // link opened the raw image in a tab instead of saving it. `dl=1` asks
    // the edge Worker (booru originals and Matrix downloads alike) to answer
    // with Content-Disposition: attachment, which every browser honours
    // regardless of origin.
    function saveHref(u) {
      if (!u || (u.indexOf("/booru/") < 0 && u.indexOf("/_matrix/client/v1/media/download/") < 0)) return u;
      return u + (u.indexOf("?") >= 0 ? "&" : "?") + "dl=1";
    }
    let lbOpen = false, lbS = 1, lbTx = 0, lbTy = 0, lbW = 0, lbH = 0;
    function lbApply() {
      const img = root.querySelector(".mod-lightbox-img");
      if (img) img.style.transform = "translate(" + lbTx + "px," + lbTy + "px) scale(" + lbS + ")";
    }
    function lbFit() {
      const vw = window.innerWidth, vh = window.innerHeight;
      lbS = Math.min(vw / lbW, vh / lbH, 1);
      lbTx = (vw - lbW * lbS) / 2;
      lbTy = (vh - lbH * lbS) / 2;
      lbApply();
    }
    function openLightbox() {
      const m = cur.media || {};
      if (lbOpen || m.kind !== "image" || !(m.full || m.src)) return;
      lbOpen = true;
      lbW = m.w || 1000; lbH = m.h || 1000;
      const el = document.createElement("div");
      el.className = "mod-lightbox";
      el.innerHTML =
        '<img class="mod-lightbox-img" src="' + esc(m.full || m.src) + '" alt="" draggable="false">' +
        '<div class="mod-lightbox-hud">' +
          '<span class="mod-lightbox-help">Press Esc to close this window. Click and drag anywhere to move the image. Mousewheel for zoom.</span>' +
          '<a class="mod-lightbox-save" href="' + esc(saveHref(m.full || m.src)) + '" download>Save Image</a>' +
          '<button type="button" class="mod-lightbox-close" data-act="lightbox-close" aria-label="Close">&#10005;</button>' +
        "</div>";
      root.appendChild(el);
      document.body.style.overflow = "hidden";
      lbFit();
      let px = 0, py = 0, dragging = false;
      el.addEventListener("pointerdown", (e) => {
        if (e.target.closest(".mod-lightbox-hud")) return;
        dragging = true; px = e.clientX; py = e.clientY;
        el.setPointerCapture(e.pointerId);
        el.classList.add("is-dragging");
      });
      el.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        lbTx += e.clientX - px; lbTy += e.clientY - py;
        px = e.clientX; py = e.clientY;
        lbApply();
      });
      const drop = (e) => { dragging = false; el.classList.remove("is-dragging"); };
      el.addEventListener("pointerup", drop);
      el.addEventListener("pointercancel", drop);
      el.addEventListener("wheel", (e) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.18 : 1 / 1.18;
        const ns = Math.min(10, Math.max(0.15, lbS * factor));
        // The point under the cursor stays under the cursor while the scale
        // moves -- zoom reads as "into here", not "toward the middle".
        lbTx = e.clientX - (e.clientX - lbTx) * (ns / lbS);
        lbTy = e.clientY - (e.clientY - lbTy) * (ns / lbS);
        lbS = ns;
        lbApply();
      }, { passive: false });
    }
    function closeLightbox() {
      const el = root.querySelector(".mod-lightbox");
      if (el) el.remove();
      document.body.style.overflow = "";
      lbOpen = false;
    }

    // ---- view-state persistence (server-side; no browser storage) ----
    function persistSettings(changes) {
      fetch("/modulation/settings", {
        method: "PATCH",
        headers: { "X-CSRF-Token": csrfToken(), "Content-Type": "application/json", Accept: "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(changes),
      }).catch(() => {});
    }

    // ---- scoring and favouriting ----
    // Both were upstream-only. They write through the same endpoints the
    // upstream page uses, then re-read the post rather than guessing the new
    // numbers locally -- a score is server state and rate limits, locks and
    // moderation can all make the optimistic answer the wrong one.
    function csrfToken() {
      const el = document.querySelector('meta[name="csrf-token"]');
      return el ? el.getAttribute("content") : "";
    }
    function write(url, method) {
      return fetch(url, {
        method: method,
        headers: { "X-CSRF-Token": csrfToken(), Accept: "application/json" },
        credentials: "same-origin",
      });
    }
    // Forget the trail, drop every cached payload (each carries neighbours
    // from the old trail), and re-read this post: random's flanks reseed.
    function clearRandomHistory(btn) {
      if (btn.disabled) return;
      btn.disabled = true;
      const a = active(); const search = (a && a.search) || "";
      fetch("/modulation/random_trail?q=" + encodeURIComponent(search), {
        method: "DELETE",
        headers: { "X-CSRF-Token": csrfToken(), Accept: "application/json" },
        credentials: "same-origin",
      }).then(() => { cache.clear(); return fetchPayload(cur.id, search); })
        .then(p => { cur = p; renderFlanks(); renderActions(); renderMeta(); preloadNeighbours(); })
        .catch(() => {})
        .finally(() => { btn.disabled = false; });
    }
    function refreshCurrent() {
      const search = (active() || {}).search || "";
      cache.delete(cur.id + "|" + search);
      return fetchPayload(cur.id, search).then(p => { cur = p; renderActions(); renderMeta(); });
    }
    function vote(dir) {
      const sc = cur.score || {};
      if (!sc.can_vote || busy) return;
      const clearing = sc.vote === dir;
      const url = clearing ? "/post_votes/" + sc.vote_id
                           : "/posts/" + cur.id + "/votes?score=" + (dir === "up" ? 1 : -1);
      write(url, clearing ? "DELETE" : "POST").then(r => { if (r.ok) refreshCurrent(); });
    }
    function toggleFav() {
      const fv = cur.fav || {};
      if (!fv.can_fav || busy) return;
      const url = fv.faved ? "/favorites/" + cur.id : "/favorites?post_id=" + cur.id;
      write(url, fv.faved ? "DELETE" : "POST").then(r => { if (r.ok) refreshCurrent(); });
    }

    // ---- data + preloading ----
    const endpointFor = (id, search) => BASE + "/" + id + "/modulation.json?q=" + encodeURIComponent(search || "");
    function fetchPayload(id, search) {
      const key = id + "|" + (search || "");
      if (cache.has(key)) return Promise.resolve(cache.get(key));
      return fetch(endpointFor(id, search), { headers: { Accept: "application/json" } })
        .then(r => r.ok ? r.json() : Promise.reject(r.status))
        .then(p => { cache.set(key, p); return p; });
    }
    function preloadNeighbours() {
      const a = active(); if (!a) return;
      ["prev", "next"].forEach(side => {
        const nb = a[side]; if (!nb) return;
        fetchPayload(nb.id, a.search).then(p => { if (p.media && p.media.src) { const im = new Image(); im.src = p.media.src; } }).catch(() => {});
      });
    }

    // ---- interactions ----
    function setSort(i) { const ps = presets(); if (!ps.length) return; activeKey = ps[((i % ps.length) + ps.length) % ps.length].key; applyRanks(); preloadNeighbours(); }
    function swapSort(d) { setSort(activeIndex() + d); }
    function selectSort(i) { if (presets()[i]) { activeKey = presets()[i].key; applyRanks(); preloadNeighbours(); } }

    function navigate(side) {
      if (busy) return;
      const a = active(), nb = a && a[side];
      if (!nb) return;
      busy = true;
      fetchPayload(nb.id, a.search).then(p => {
        root.classList.add(side === "next" ? "is-nav-next" : "is-nav-prev"); // shrink centre into slot, neighbour grows in
        setTimeout(() => {
          cur = p;
          activeKey = p.active_key || activeKey;
          revealed = false;
          root.classList.remove("is-nav-next", "is-nav-prev");
          const enter = side === "next" ? "is-enter-next" : "is-enter-prev";
          root.classList.add(enter);
          renderAll();
          history.pushState({ modId: p.id }, "", p.url);
          requestAnimationFrame(() => requestAnimationFrame(() => { root.classList.remove(enter); busy = false; preloadNeighbours(); }));
        }, 260);
      }).catch(() => { window.location.href = nb.url; }); // network failure: fall back to a real load
    }

    // THE HYPED TAG'S STATE MACHINE. Not :hover -- see the stylesheet. The
    // spin goes on at pointer-enter and is never touched by hover again: one
    // continuous spin. While a pill spins, a 100ms poll asks whether the
    // pointer is still over the pill's LAYOUT box (offsetLeft/offsetTop against
    // the offsetParent, which a transform does not move), and only after the
    // pointer has been away for --mod-hype-grace does the wind-down start.
    // That grace is what absorbs the pill rotating out from under a still
    // pointer, and what the operator asked for by name. The poll runs only
    // while something is spinning; nothing ticks on an idle page.
    const hypeGrace = parseFloat(getComputedStyle(root).getPropertyValue("--mod-hype-grace")) || 800;
    const pointer = { x: -1, y: -1 };
    document.addEventListener("pointermove", e => { pointer.x = e.clientX; pointer.y = e.clientY; }, { passive: true });
    document.addEventListener("pointerout", e => { if (!e.relatedTarget) { pointer.x = -1; pointer.y = -1; } });
    const overLayoutBox = (el) => {
      const op = el.offsetParent || document.body, pr = op.getBoundingClientRect(), pad = 6;
      const l = pr.left + el.offsetLeft, t = pr.top + el.offsetTop;
      return pointer.x >= l - pad && pointer.x <= l + el.offsetWidth + pad && pointer.y >= t - pad && pointer.y <= t + el.offsetHeight + pad;
    };
    const spinning = new Map();   // pill -> { away: ms since the pointer left, or null; timer }
    function windDown(pill) {
      const st = spinning.get(pill); if (st) clearTimeout(st.timer); spinning.delete(pill);
      pill.classList.remove("is-spinning");
      if (pill.isConnected) pill.classList.add("is-spinning-down");
    }
    function startSpin(pill) {
      if (spinning.has(pill)) return;                       // already spinning: never restart
      pill.classList.remove("is-spinning-down"); pill.classList.add("is-spinning");
      const st = { away: null, timer: null }; spinning.set(pill, st);
      const tick = () => {
        if (!pill.isConnected) { windDown(pill); return; }  // the panel re-rendered under it
        if (overLayoutBox(pill)) st.away = null;
        else if (st.away === null) st.away = performance.now();
        if (st.away !== null && performance.now() - st.away >= hypeGrace) { windDown(pill); return; }
        st.timer = setTimeout(tick, 100);
      };
      tick();
    }
    root.addEventListener("pointerenter", e => {
      const pill = e.target && e.target.closest && e.target.closest(".mod-pill--hype");
      if (pill) startSpin(pill);
    }, true);
    root.addEventListener("animationend", e => {
      if (e.animationName === "mod-hype-spin-down") e.target.classList.remove("is-spinning-down");
    });
    root.addEventListener("click", e => {
      if (e.target.closest("[data-act='lightbox-close']")) { closeLightbox(); return; }
      // The centre image opens the fullscreen viewer. Spoilered and gated
      // states never reach here: the spoiler intercepts its own clicks and a
      // gated post renders no <img> in the frame.
      const centerImg = e.target.closest('[data-region="center"] .mod-frame img');
      if (centerImg && !e.target.closest(".mod-spoiler")) { e.preventDefault(); openLightbox(); return; }
      const rowEl = e.target.closest(".mod-sortrow");
      if (rowEl && root.contains(rowEl)) {
        e.preventDefault();
        const i = +rowEl.dataset.i;
        if (i === activeIndex()) navigate(rowEl.dataset.side); else selectSort(i);
        return;
      }
      const act = e.target.closest("[data-act]"); if (!act) return;
      const a = act.dataset.act;
      if (a === "sort-up") swapSort(-1);
      else if (a === "sort-down") swapSort(1);
      else if (a === "view") { view = act.dataset.view; renderTags(); }
      else if (a === "tags-toggle") { tagsExpanded = !tagsExpanded; renderTags(); persistSettings({ tags_expanded: tagsExpanded }); }
      else if (a === "image-cap") { imageCap = act.dataset.cap; renderActions(); sizeStage(); persistSettings({ image_cap: imageCap }); }
      else if (a === "meta-toggle") { metaOpen = !metaOpen; renderTags(); }
      else if (a === "more") { moreOpen = !moreOpen; renderActions(); }
      else if (a === "reveal") { revealed = true; renderCenter(); }
      else if (a === "vote") vote(act.dataset.dir);
      else if (a === "fav") toggleFav();
      else if (a === "moderate") moderate(act);
      else if (a === "random-clear") clearRandomHistory(act);
      else if (a === "tags-edit") { editing = !editing; editError = ""; renderTags(); }
      else if (a === "tag-remove") { if (!editBusy) commitEdit({ remove: [act.dataset.tag] }); }
      else if (a === "tag-add") { if (!editBusy) addTypedTags(); }
      else if (a === "local-anchor") revealLocal(act.getAttribute("href"));
      else if (a === "signin") window.location.href = "/login?url=" + encodeURIComponent(location.pathname + location.search);
    });

    // ---- editing the pool --------------------------------------------------
    //
    // WHAT THIS VIEWER HAS SEEN. old_tag_string must be what the client was
    // looking at, and for this page that is the union of the buckets -- which
    // is deliberately NOT post.tag_string: the denormalised string still holds
    // private creator tags, and publishing it to build a write would put them
    // in the page source of every post. Danbooru applies only the DIFFERENCE
    // between the two strings, so a tag in neither is untouched -- private
    // tags a viewer cannot see are therefore neither removed nor disturbed,
    // and a concurrent edit by someone else survives for the same reason.
    const BUCKETS = ["creator", "both", "auto", "pending", "unsourced", "meta"];
    function seenTagString() {
      const t = cur.tags || {}, out = [];
      BUCKETS.forEach(b => (t[b] || []).forEach(tag => { if (!out.includes(tag)) out.push(tag); }));
      return out.join(" ");
    }

    // Rails puts the token in the head of every page it renders. Same origin,
    // so there is no exchange to do -- unlike Technetium, which has to fetch a
    // page to read one.
    function csrfToken() {
      const m = document.querySelector('meta[name="csrf-token"]');
      return m ? m.getAttribute("content") : null;
    }

    // One write, then a forced re-read. The optimistic pass is what makes the
    // pill move under the finger; the re-read is what makes the CATEGORY and
    // the LAMP correct, because both are the server's to decide and an added
    // tag has neither until it answers.
    function commitEdit(edit) {
      const g = tagEdit();
      if (!g) { editError = "the tag-edit grammar did not load, so nothing was sent. Fix: reload the page; if it persists the application pack failed to build."; renderTags(); return; }
      const seen = seenTagString();
      const refusal = g.refuseEdit(cur.id, seen, edit);
      if (refusal) { editError = refusal; renderTags(); return; }

      const token = csrfToken();
      if (!token) { editError = "no CSRF token on this page, so the edit would be refused. Fix: reload the page."; renderTags(); return; }

      // Optimistic: put the pool where it will be. Kept as a snapshot so a
      // refusal can put it back exactly, rather than approximately.
      const before = cur.tags;
      const names = new Set(g.nextNames(seenTagString().split(" ").filter(Boolean), edit));
      const added = new Set(edit.add || []);
      const next = {};
      Object.keys(before || {}).forEach(b => { next[b] = (before[b] || []).filter(t => names.has(t)); });
      // An added tag has no bucket until the server gives it one; unsourced is
      // the honest holding pen, and it is also where it would land if nothing
      // ever recorded a provenance row for it.
      next.unsourced = (next.unsourced || []).concat([...added].filter(t => !BUCKETS.some(b => (before[b] || []).includes(t))));
      cur = Object.assign({}, cur, { tags: next });
      editBusy = true; editError = "";
      renderTags();

      const body = new URLSearchParams(g.editFields(seen, edit, token));
      fetch("/posts/" + cur.id + ".json", {
        method: "POST",
        credentials: "same-origin",
        headers: { Accept: "application/json", "Content-Type": "application/x-www-form-urlencoded" },
        body: body.toString(),
      }).then(r => {
        if (!r.ok) return Promise.reject(r.status);
        // The payload, not the post JSON: buckets, lamps and categories all
        // come from the component, and this is the only thing that has them.
        cache.clear();
        return fetchPayload(cur.id, (active() || {}).search);
      }).then(p => {
        cur = p; editBusy = false; editError = ""; editDraft = ""; editFocus = true; renderAll();
      }).catch(status => {
        cur = Object.assign({}, cur, { tags: before });
        editBusy = false; editFocus = true;
        editError = "the booru refused the edit (HTTP " + status + "). " +
          "Fix: a 403 is usually a missing or expired session -- reload and sign in; " +
          "a 422 is the booru rejecting the tags themselves, or an account without " +
          "permission to edit them.";
        renderTags();
      });
    }

    function addTypedTags() {
      const g = tagEdit(); if (!g) return;
      const input = region("tagedit-input");
      const typed = input ? input.value : editDraft;
      editDraft = typed;
      const add = g.parseTagInput(typed);
      editFocus = true;
      if (!add.length) { editError = "nothing to add. Fix: type one or more tag names, separated by spaces."; renderTags(); return; }
      commitEdit({ add: add });
    }

    // A "contribute" link points at a section of THIS page that starts hidden.
    // posts/show.html.erb renders the upstream edit partial inside Modulation
    // with `display: none`, because upstream reveals it from posts.js, and
    // posts.js binds #post-edit-link and #side-edit-link -- neither of which
    // exists here. So all three contribute links set the hash and did nothing
    // at all: "'Edit tags' on the booru is completely inert" (operator,
    // 2026-09-20). The payload has carried `local: true` since those links
    // stopped going through ?preset=historical; nothing was reading it.
    //
    // The section is rendered OUTSIDE the component root (it is a sibling of
    // it in show.html.erb), so this reaches for it on the document, and
    // returns quietly when it is absent -- which is what policy(@post).update?
    // being false looks like from here.
    function revealLocal(href) {
      const id = String(href || "").replace(/^#/, "");
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      if (el.style.display === "none") el.style.display = "";
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      const field = el.querySelector("textarea, input:not([type=hidden])");
      if (field) field.focus({ preventScroll: true });
    }

    root.addEventListener("input", e => {
      if (e.target.classList && e.target.classList.contains("mod-tagedit-input")) editDraft = e.target.value;
    });

    window.addEventListener("keydown", e => {
      // The add box owns Enter. The guard below hands every key back to any
      // input, which would leave Enter doing nothing at all in this one.
      if (e.key === "Enter" && e.target.classList && e.target.classList.contains("mod-tagedit-input")) {
        e.preventDefault();
        if (!editBusy) addTypedTags();
        return;
      }
      if (e.target.closest("input, textarea, select, [contenteditable]")) return;
      // While the fullscreen viewer is up it owns the keyboard: Esc closes,
      // everything else stays put rather than navigating under the overlay.
      if (lbOpen) {
        if (e.key === "Escape") { e.preventDefault(); closeLightbox(); }
        return;
      }
      if (e.key === "Enter" || e.key === " ") {
        const sp = e.target.closest(".mod-spoiler");
        if (sp) { e.preventDefault(); revealed = true; renderCenter(); return; }
      }
      if (e.key === "ArrowLeft") navigate("prev");
      else if (e.key === "ArrowRight") navigate("next");
      else if (e.key === "ArrowUp") { e.preventDefault(); swapSort(-1); }
      else if (e.key === "ArrowDown") { e.preventDefault(); swapSort(1); }
    });

    let tx = null;
    const stage = region("stage");
    stage.addEventListener("touchstart", e => { tx = e.changedTouches[0].clientX; }, { passive: true });
    stage.addEventListener("touchend", e => { if (tx == null) return; const dx = e.changedTouches[0].clientX - tx; tx = null; if (Math.abs(dx) > 45) navigate(dx < 0 ? "next" : "prev"); });

    window.addEventListener("popstate", () => {
      const m = location.pathname.match(/\/posts\/(\d+)/); if (!m) return;
      const search = new URLSearchParams(location.search).get("q") || "";
      fetchPayload(+m[1], search).then(p => { cur = p; activeKey = p.active_key || activeKey; revealed = false; renderAll(); }).catch(() => {});
    });

    history.replaceState({ modId: cur.id }, "", cur.url);
    renderAll();
    preloadNeighbours();
  })();
  </script>
</article>
