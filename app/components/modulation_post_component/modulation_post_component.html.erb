    function setSort(i) { const ps = presets(); if (!ps.length) return; activeKey = ps[((i % ps.length) + ps.length) % ps.length].key; queued = null; hideStatus(); applyRanks(); lookAhead(); }
    function swapSort(d) { setSort(activeIndex() + d); }
    function selectSort(i) { if (presets()[i]) { activeKey = presets()[i].key; queued = null; hideStatus(); applyRanks(); lookAhead(); } }

    // Every way of moving -- arrows, swipe, wheel, a flank click -- comes
    // here, and goes where the drawn thumbnail says: the side's pick, never a
    // blocked candidate. Decided from the data and the marks, not the tile,
    // because at phone width the tiles are not drawn and a swipe still moves.
    //
    // The swap starts AT THE PRESS and commits at max(SWAP_MS, the payload):
    // the old picture leaves while the next one's payload is on its way,
    // instead of the page sitting still and taking no input until it came.
    // A press during a step is QUEUED, one slot, the latest side winning,
    // held with the mode it was made in (queuePress), and taken when the step
    // ends -- it used to be dropped, and a second wheel notch did nothing. A
    // press that goes at once replaces whatever was queued: it is the latest.
    // A step that gets no payload in NAV_DEADLINE_MS, or a failed one, is
    // undone and SAYS SO, in the status line and the console; it used to
    // reload the whole page, silently.
    //
    // IN TRANSIT: a step whose payload arrives while a press is queued does
    // not land. Its post is never drawn -- not its picture, which the next
    // step would hide before it grew in, nor its tags, actions and stage box,
    // which moved the page for a post nobody saw (review, 2026-10-18) -- and
    // it is not pushed onto the history or logged as opened. Its flanks are
    // worked out, because the queued press goes where they say, and the next
    // step starts from it; the page lands once, on the post the presses end
    // at. `via` holds that post while the next step is under way: if that
    // step fails, the page lands on it instead, so the viewer is where the
    // last step that worked took them.
    const SWAP_MS = 260, NAV_DEADLINE_MS = 8000;
    function drainQueue() {
      if (busy || !queued) return;
      const side = Ahead.queuedFor(queued, activeKey);
      queued = null;
      // Not under the fullscreen viewer: a press taken there would swap the
      // post beneath it.
      if (side && !lbOpen) navigate(side);
    }
    // Show `cur` as the post the page stands on: everything drawn for it, the
    // centre growing in from the side it came from.
    function land(side, search, thumb, prefetched) {
      via = null;
      root.classList.remove("is-nav-next", "is-nav-prev");
      const enter = side === "next" ? "is-enter-next" : "is-enter-prev";
      root.classList.add(enter);
      renderAll();
      standIn(thumb);
      history.pushState({ modId: cur.id }, "", cur.url);
      noteOpened(cur, search);
      if (prefetched) completeCurrent(search);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        root.classList.remove(enter);
        busy = false;
        lookAhead();
        // A press that came in these two frames waits for the picture to grow
        // in: taken now, it would hide a post the page just drew.
        if (queued) setTimeout(drainQueue, SWAP_MS);
      }));
    }
    function navigate(side) {
      if (busy) { queued = Ahead.queuePress(queued, side, activeKey); return; }
      queued = null;
      const a = active();
      if (!a.key) return;
      const st = flankStates[a.key + "|" + side] || { kind: "fault" };
      if (st.kind === "deferred") { queued = Ahead.queuePress(null, side, activeKey); tellStatus(side); return; }
      if (st.kind !== "pick") {
        if (st.kind === "end") return;
        if (st.kind === "blocked-more" && !st.looking && !st.canHop) lookFurther(a, side);
        tellStatus(side);
        return;
      }
      hideStatus();
      const nb = st.ref;
      travel = side;
      busy = true;
      // The post past this one, from this post's run, now: by the time the
      // viewer presses again it is on its way.
      Ahead.lookahead(drawableRun(a, side), markedIds(), st.index, 1).forEach(ref => warmPost(ref, a.search));
      const thumb = (candidateOf(nb.id) || {}).thumb;
      // shrink centre into slot, neighbour grows in (a step from a post in
      // transit may turn round)
      root.classList.remove(side === "next" ? "is-nav-prev" : "is-nav-next");
      root.classList.add(side === "next" ? "is-nav-next" : "is-nav-prev");
      swapping = true;
      const { promise, prefetched } = payloadFor(nb.id, a.search);
      let settled = false;
      const undo = (words) => {
        swapping = false; busy = false; queued = null;
        root.classList.remove("is-nav-next", "is-nav-prev", "is-enter-next", "is-enter-prev");
        if (via) {
          // The step from a post in transit failed: land on that post.
          const v = via;
          cur = v.p;
          busy = true;
          land(v.side, v.search, v.thumb, v.prefetched);
        } else {
          drawFlanks();
        }
        unlessLeaving(() => { console.error("post view: " + words); tellStatus(side, words); });
      };
      const deadline = setTimeout(() => {
        if (settled) return;
        settled = true;
        undo("Post #" + nb.id + " did not load (no answer in " + (NAV_DEADLINE_MS / 1000) + " s). Fix: press again, or reload the page.");
      }, NAV_DEADLINE_MS);
      Promise.all([promise, new Promise(done => { setTimeout(done, SWAP_MS); })]).then(([p]) => {
        if (settled) return;
        settled = true;
        clearTimeout(deadline);
        swapping = false;
        const shown = cur;
        cur = p;
        activeKey = p.active_key || activeKey;
        revealed = false;
        if (queued && !lbOpen) {
          // In transit: this post's flanks, then the queued press from them.
          // `cur` goes back to the post on screen while the next step runs,
          // so nothing acts on a post that is not drawn.
          renderFlanks();
          busy = false;
          via = { p, side, search: a.search, thumb, prefetched };
          drainQueue();
          if (busy) { cur = shown; return; }
        }
        land(side, a.search, thumb, prefetched);
      }).catch(why => {
        if (!settled) {
          settled = true;
          clearTimeout(deadline);
          undo("Post #" + nb.id + " did not load (" + describe(why) + "). Fix: press again, or reload the page.");
          return;
        }
        undo("Showing post #" + nb.id + " failed (" + describe(why) + "). Fix: reload the page.");
      });
    }

    // The hyped pill's spin: modulation_hype.js, the same machine /posts runs.
    if (window.FourierHype) window.FourierHype.bindSpin(root);
    root.addEventListener("click", e => {
      if (e.target.closest("[data-act='lightbox-close']")) { closeLightbox(); return; }
      // The centre image opens the fullscreen viewer. Spoilered and gated
      // states never reach here: the spoiler intercepts its own clicks and a
      // gated post renders no <img> in the frame.
      const centerImg = e.target.closest('[data-region="center"] .mod-frame img');
      if (centerImg && !e.target.closest(".mod-spoiler")) { e.preventDefault(); openLightbox(); return; }
      const rowEl = e.target.closest(".mod-sortrow");
      if (rowEl && root.contains(rowEl)) {
        e.preventDefault();
        const i = +rowEl.dataset.i;
        if (i === activeIndex()) navigate(rowEl.dataset.side); else selectSort(i);
        return;
      }
      const act = e.target.closest("[data-act]"); if (!act) return;
      const a = act.dataset.act;
      if (a === "sort-up") swapSort(-1);
      else if (a === "sort-down") swapSort(1);
      else if (a === "view") { view = act.dataset.view; renderTags(); }
      else if (a === "tags-toggle") { tagsExpanded = !tagsExpanded; renderTags(); persistSettings({ tags_expanded: tagsExpanded }); }
      else if (a === "image-cap") { imageCap = act.dataset.cap; renderActions(); sizeStage(); persistSettings({ image_cap: imageCap }); }
      else if (a === "meta-toggle") { metaOpen = !metaOpen; renderTags(); }
      else if (a === "more") { moreOpen = !moreOpen; renderActions(); }
      else if (a === "reveal") { revealed = true; renderCenter(); }
      else if (a === "vote") vote(act.dataset.dir);
      else if (a === "fav") toggleFav();
      else if (a === "moderate") moderate(act);
      else if (a === "random-clear") clearRandomHistory(act);
      else if (a === "tags-edit") { editing = !editing; editError = ""; renderTags(); }
      else if (a === "tag-remove") { if (!editBusy) commitEdit({ remove: [act.dataset.tag] }); }
      else if (a === "tag-flag") { if (!editBusy) flagTag(act.dataset.tag); }
      else if (a === "tag-add") { if (!editBusy) addTypedTags(); }
      else if (a === "local-anchor") revealLocal(act.getAttribute("href"));
      else if (a === "signin") window.location.href = "/login?url=" + encodeURIComponent(location.pathname + location.search);
    });

    // ---- editing the pool --------------------------------------------------
    //
    // WHAT THIS VIEWER HAS SEEN. old_tag_string must be what the client was
    // looking at, and for this page that is the union of the buckets -- which
    // is deliberately NOT post.tag_string: the denormalised string still holds
    // private creator tags, and publishing it to build a write would put them
    // in the page source of every post. Danbooru applies only the DIFFERENCE
    // between the two strings, so a tag in neither is untouched -- private
    // tags a viewer cannot see are therefore neither removed nor disturbed,
    // and a concurrent edit by someone else survives for the same reason.
    const BUCKETS = ["creator", "both", "auto", "pending", "unsourced", "meta"];
    function seenTagString() {
      const t = cur.tags || {}, out = [];
      BUCKETS.forEach(b => (t[b] || []).forEach(tag => { if (!out.includes(tag)) out.push(tag); }));
      return out.join(" ");
    }

    // Rails puts the token in the head of every page it renders. Same origin,
    // so there is no exchange to do -- unlike Technetium, which has to fetch a
    // page to read one.
    function csrfToken() {
      const m = document.querySelector('meta[name="csrf-token"]');
      return m ? m.getAttribute("content") : null;
    }

    // Flag a tag for review, or release a flagged one (an admin; the lock is
    // only drawn for one). Not optimistic: the answer decides what every
    // other viewer sees, so the panel shows it only once the server has it.
    function flagTag(t) {
      const q = cur.quarantine || {};
      const id = (q.tag_ids || {})[t];
      if (!id) return;
      const token = csrfToken();
      if (!token) { editError = "no CSRF token on this page, so the flag would be refused. Fix: reload the page."; renderTags(); return; }
      const verb = (q.flagged || []).includes(t) ? "release" : "flag";
      editBusy = true; editError = ""; renderTags();
      const body = new URLSearchParams({ "tag[quarantine]": verb });
      fetch("/tags/" + id + ".json", {
        method: "PATCH",
        credentials: "same-origin",
        headers: { Accept: "application/json", "Content-Type": "application/x-www-form-urlencoded", "X-CSRF-Token": token },
        body: body.toString(),
      }).then(r => {
        if (!r.ok) return r.json().then(j => Promise.reject(j.error || j.message || r.status), () => Promise.reject(r.status));
        payloads.clear();
        return fetchPayload(cur.id, (active() || {}).search);
      }).then(p => {
        cur = p; editBusy = false; editError = ""; renderAll();
      }).catch(why => {
        editBusy = false;
        editError = "the " + verb + " of " + t + " was refused (" + why + "). Fix: open the tag's edit page, /tags/" + id + "/edit, which says why.";
        renderTags();
      });
    }

    // One write, then a forced re-read. The optimistic pass is what makes the
    // pill move under the finger; the re-read is what makes the CATEGORY and
    // the LAMP correct, because both are the server's to decide and an added
    // tag has neither until it answers.
    function commitEdit(edit) {
      const g = tagEdit();
      if (!g) { editError = "the tag-edit grammar did not load, so nothing was sent. Fix: reload the page; if it persists the application pack failed to build."; renderTags(); return; }
      const seen = seenTagString();
      const refusal = g.refuseEdit(cur.id, seen, edit);
      if (refusal) { editError = refusal; renderTags(); return; }

      const token = csrfToken();
      if (!token) { editError = "no CSRF token on this page, so the edit would be refused. Fix: reload the page."; renderTags(); return; }

      // Optimistic: put the pool where it will be. Kept as a snapshot so a
      // refusal can put it back exactly, rather than approximately.
      const before = cur.tags;
      const names = new Set(g.nextNames(seenTagString().split(" ").filter(Boolean), edit));
      const added = new Set(edit.add || []);
      const next = {};
      Object.keys(before || {}).forEach(b => { next[b] = (before[b] || []).filter(t => names.has(t)); });
      // An added tag has no bucket until the server gives it one; unsourced is
      // the honest holding pen, and it is also where it would land if nothing
      // ever recorded a provenance row for it.
      next.unsourced = (next.unsourced || []).concat([...added].filter(t => !BUCKETS.some(b => (before[b] || []).includes(t))));
      cur = Object.assign({}, cur, { tags: next });
      editBusy = true; editError = "";
      renderTags();

      const body = new URLSearchParams(g.editFields(seen, edit, token));
      fetch("/posts/" + cur.id + ".json", {
        method: "POST",
        credentials: "same-origin",
        headers: { Accept: "application/json", "Content-Type": "application/x-www-form-urlencoded" },
        body: body.toString(),
      }).then(r => {
        if (!r.ok) return Promise.reject(r.status);
        // The payload, not the post JSON: buckets, lamps and categories all
        // come from the component, and this is the only thing that has them.
        payloads.clear();
        return fetchPayload(cur.id, (active() || {}).search);
      }).then(p => {
        cur = p; editBusy = false; editError = ""; editDraft = ""; editFocus = true; renderAll();
      }).catch(status => {
        cur = Object.assign({}, cur, { tags: before });
        editBusy = false; editFocus = true;
        editError = "the booru refused the edit (HTTP " + status + "). " +
          "Fix: a 403 is usually a missing or expired session -- reload and sign in; " +
          "a 422 is the booru rejecting the tags themselves, or an account without " +
          "permission to edit them.";
        renderTags();
      });
    }

    function addTypedTags() {
      const g = tagEdit(); if (!g) return;
      const input = region("tagedit-input");
      const typed = input ? input.value : editDraft;
      editDraft = typed;
      const add = g.parseTagInput(typed);
      editFocus = true;
      if (!add.length) { editError = "nothing to add. Fix: type one or more tag names, separated by spaces."; renderTags(); return; }
      commitEdit({ add: add });
    }

    // A "contribute" link points at a section of THIS page that starts hidden.
    // posts/show.html.erb renders the upstream edit partial inside Modulation
    // with `display: none`, because upstream reveals it from posts.js, and
    // posts.js binds #post-edit-link and #side-edit-link -- neither of which
    // exists here. So all three contribute links set the hash and did nothing
    // at all: "'Edit tags' on the booru is completely inert" (operator,
    // 2026-09-20). The payload has carried `local: true` since those links
    // stopped going through ?preset=historical; nothing was reading it.
    //
    // The section is rendered OUTSIDE the component root (it is a sibling of
    // it in show.html.erb), so this reaches for it on the document, and
    // returns quietly when it is absent -- which is what policy(@post).update?
    // being false looks like from here.
    function revealLocal(href) {
      const id = String(href || "").replace(/^#/, "");
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      if (el.style.display === "none") el.style.display = "";
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      const field = el.querySelector("textarea, input:not([type=hidden])");
      if (field) field.focus({ preventScroll: true });
    }

    root.addEventListener("input", e => {
      if (e.target.classList && e.target.classList.contains("mod-tagedit-input")) editDraft = e.target.value;
    });

    window.addEventListener("keydown", e => {
      // The add box owns Enter. The guard below hands every key back to any
      // input, which would leave Enter doing nothing at all in this one.
      if (e.key === "Enter" && e.target.classList && e.target.classList.contains("mod-tagedit-input")) {
        e.preventDefault();
        if (!editBusy) addTypedTags();
        return;
      }
      if (e.target.closest("input, textarea, select, [contenteditable]")) return;
      // While the fullscreen viewer is up it owns the keyboard: Esc closes,
      // everything else stays put rather than navigating under the overlay.
      if (lbOpen) {
        if (e.key === "Escape") { e.preventDefault(); closeLightbox(); }
        return;
      }
      if (e.key === "Enter" || e.key === " ") {
        const sp = e.target.closest(".mod-spoiler");
        if (sp) { e.preventDefault(); revealed = true; renderCenter(); return; }
      }
      if (e.key === "ArrowLeft") navigate("prev");
      else if (e.key === "ArrowRight") navigate("next");
      else if (e.key === "ArrowUp") { e.preventDefault(); swapSort(-1); }
      else if (e.key === "ArrowDown") { e.preventDefault(); swapSort(1); }
    });

    let tx = null;
    const stage = region("stage");
    stage.addEventListener("touchstart", e => { tx = e.changedTouches[0].clientX; }, { passive: true });
    stage.addEventListener("touchend", e => { if (tx == null) return; const dx = e.changedTouches[0].clientX - tx; tx = null; if (Math.abs(dx) > 45) navigate(dx < 0 ? "next" : "prev"); });

    // The wheel walks the axis like the arrows: one notch, one post, by
    // Technetium's rule (fourier_wheel_step.js, on window for this script).
    // Over the stage only, and it does not scroll the page there -- the tags
    // and comments below still scroll everywhere else. The fullscreen viewer
    // keeps its own wheel, which zooms.
    let wheelState = null;
    stage.addEventListener("wheel", e => {
      const W = window.FourierWheel;
      if (!W || lbOpen) return;
      e.preventDefault();
      const r = W.wheelStep(wheelState || W.WHEEL_IDLE, { dx: e.deltaX, dy: e.deltaY, mode: e.deltaMode, t: e.timeStamp });
      wheelState = r.state;
      if (r.step) navigate(r.step > 0 ? "next" : "prev");
    }, { passive: false });

    window.addEventListener("popstate", () => {
      const m = location.pathname.match(/\/posts\/(\d+)/); if (!m) return;
      const search = new URLSearchParams(location.search).get("q") || "";
      queued = null; // the browser moved the viewer; a press queued before is not about where they are now
      const id = +m[1], { promise, prefetched } = payloadFor(id, search);
      promise.then(p => { cur = p; activeKey = p.active_key || activeKey; revealed = false; renderAll(); noteOpened(p, search); if (prefetched) completeCurrent(search); })
        .catch(why => {
          const words = "Post #" + id + " did not load (" + describe(why) + "). Fix: reload the page.";
          console.error("post view: " + words);
          tellStatus("prev", words);
        });
    });

    // The flanks draw on the engine's applies (see "the flanks" above). A
    // wait needs a deadline: no apply within 5 s and the tiles say so, loud,
    // rather than sitting empty. No engine on the page at all, and nothing
    // is drawn -- a blocked post must never be shown by a page that cannot
    // apply the list -- and the console names the fix.
    document.addEventListener("danbooru:blacklist-applied", () => {
      if (!root.isConnected) return;
      engineApplied = true;
      flankFault = "";
      drawFlanks();
    });
    if (!document.querySelector("#blacklist-box")) {
      if (presets().length) console.error("post view: this page has no blocklist engine (#blacklist-box), so the flank thumbnails are not drawn -- render BlocklistComponent in the page's header (ModulationNavbarComponent)");
    } else {
      setTimeout(() => {
        if (engineApplied || !presets().length || !root.isConnected) return;
        flankFault = "The blocklist did not load, so the neighbours are not shown. Fix: reload the page; if it persists, the application pack failed to load.";
        console.error("post view: no blocklist apply within 5 s of load, so the flank thumbnails are withheld -- reload; if it persists the application pack (blacklists.js) failed to start");
        drawFlanks();
      }, 5000);
    }

    history.replaceState({ modId: cur.id }, "", cur.url);
    renderAll();
    sizeStage();
  })();
  </script>
</article>
