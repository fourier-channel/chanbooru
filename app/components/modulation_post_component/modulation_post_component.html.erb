    // everything, and must not snap an open panel shut.
    function renderGeneration() {
      const el = region("generation");
      if (!el) return;
      const id = String(cur.id);
      if (el.dataset.post === id) return;
      el.dataset.post = id;
      const g = cur.generation, fields = (g && g.fields) || [];
      el.hidden = !fields.length;
      el.innerHTML = fields.length ?
        '<details class="mod-gen"><summary class="mod-gen-summary">Generation data <span class="mod-meta-count">' + fields.length + "</span>" +
          '<span class="mod-gen-note">private to the creator</span></summary>' +
          fields.map(f => '<div class="mod-gen-field"><div class="mod-gen-key">' + esc(f[0]) + '</div><pre class="mod-gen-text">' + esc(f[1]) + "</pre></div>").join("") +
        "</details>" : "";
    }
    // renderBlacklist before renderFlanks: a flank redraw may rescan, and the
    // rescan must mark the centre from the new post's attributes.
    function renderAll() { renderMeta(); renderNotices(); renderCenter(); renderBlacklist(); renderFlanks(); renderTags(); renderGeneration(); renderActions(); renderComments(); sizeStage(); }

    // ---- image sizing (the image_cap setting) ----
    // "Fill the page to the exact point the collapsed Tags panel is visible."
    // Measured, not guessed: the cap is the viewport minus everything that has
    // to share it. The tags panel counts at its COLLAPSED height (head +
    // category shelf -- both render in either state) whichever state it is
    // actually in, so expanding the panel never resizes the image.
    function sizeStage() {
      root.style.removeProperty("--mod-stage-max");
      if (imageCap === "none") return;
      const stage = region("stage");
      if (!stage) return;
      const h = (el) => (el ? el.getBoundingClientRect().height : 0);
      const gap = 16, breathing = 12;
      let reserve = breathing;
      if (imageCap === "fit") {
